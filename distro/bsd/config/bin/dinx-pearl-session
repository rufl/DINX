#!/bin/sh
# DINX default session: Aqueous compositor (Xwayland enabled) + Pearl shell.
#
# Aqueous owns the session lifecycle: it spawns an init child (via -c) after it
# has created the Wayland socket, and injects WAYLAND_DISPLAY, AQUEOUS_SOCKET
# and DISPLAY (Xwayland) into that child's environment. The compositor arms an
# idle exit timer that only a connected IPC client renews, so the shell must be
# started *by* the init child -- not launched in parallel from here.
set -eu
. "${DINX_PREFIX:-/usr/local}/libexec/dinx/session-common"

start_audio

if ! command -v aqueous >/dev/null 2>&1; then
  echo 'dinx-pearl-session: aqueous compositor not installed' >&2
  exit 1
fi
if ! command -v pearl >/dev/null 2>&1; then
  echo 'dinx-pearl-session: pearl shell not installed' >&2
  exit 1
fi

# Xwayland needs its socket directory to exist before the compositor starts.
mkdir -p /tmp/.X11-unix 2>/dev/null || true
chmod 1777 /tmp/.X11-unix 2>/dev/null || true

# Init child: inherits the compositor's Wayland/Xwayland/IPC environment and
# keeps the session alive by staying connected (Pearl is the IPC client).
init="$XDG_RUNTIME_DIR/dinx-init"
cat > "$init" <<'EOF'
#!/bin/sh
# Pearl validates XDG_CURRENT_DESKTOP against the compositor name; Aqueous
# injects WAYLAND_DISPLAY/AQUEOUS_SOCKET/DISPLAY but not this variable.
export XDG_CURRENT_DESKTOP=Aqueous
# No DRM device (VMs): expose the headless session over VNC so it is usable
# from the hypervisor host. wayvnc attaches as a Wayland client and needs
# only wlr-screencopy + virtual input, no GPU.
if [ "${DINX_HEADLESS:-0}" = 1 ] && command -v wayvnc >/dev/null 2>&1; then
  wayvnc 0.0.0.0 "${DINX_VNC_PORT:-5900}" >/dev/null 2>&1 &
fi
exec pearl
EOF
chmod 755 "$init"

# Without /dev/dri no wlroots backend can scan out; fall back to headless and
# signal the init child to publish the session via wayvnc.
aq_args=""
if [ ! -e /dev/dri/card0 ]; then
  export WLR_BACKENDS=headless
  export DINX_HEADLESS=1
  echo 'dinx-pearl-session: no /dev/dri, running headless (VNC if wayvnc present)' >&2
fi

# shellcheck disable=SC2086
exec aqueous $aq_args -c "$init"

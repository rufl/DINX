#!/bin/sh
# DINX default session: Aqueous compositor (Xwayland enabled) + Pearl shell.
#
# Aqueous owns the session lifecycle. It creates the Wayland socket, the IPC
# socket and the Xwayland display, injects WAYLAND_DISPLAY / AQUEOUS_SOCKET /
# DISPLAY into its init child, and arms an idle exit timer that only a
# connected IPC client renews. So the shell MUST be started by that init child
# (`aqueous -c <init>`), never launched in parallel from here -- a compositor
# started in the background with no IPC client tears itself down.
set -eu
. "${DINX_PREFIX:-/usr/local}/libexec/dinx/session-common"

start_audio

if ! command -v aqueous >/dev/null 2>&1; then
  echo 'dinx-pearl-session: aqueous compositor not installed' >&2
  exit 1
fi
if ! command -v pearl >/dev/null 2>&1; then
  echo 'dinx-pearl-session: pearl shell not installed' >&2
  exit 1
fi

# Xwayland needs its socket directory before the compositor starts.
mkdir -p /tmp/.X11-unix 2>/dev/null || true
chmod 1777 /tmp/.X11-unix 2>/dev/null || true

# The IPC directory check requires 0700 (InsecureRuntimeDirectory otherwise).
# The session user cannot always create it with the right mode, so pre-create.
mkdir -p "$XDG_RUNTIME_DIR/aqueous" 2>/dev/null || true
chmod 700 "$XDG_RUNTIME_DIR/aqueous" 2>/dev/null || true

# Init child: inherits the compositor's environment, keeps the session alive by
# being the IPC client, and starts the shell.
init="$XDG_RUNTIME_DIR/dinx-init"
cat > "$init" <<'EOF'
#!/bin/sh
# The compositor does not set XDG_CURRENT_DESKTOP, and Pearl validates it
# against the compositor name before starting.
export XDG_CURRENT_DESKTOP=Aqueous

# No DRM device (virtual GPUs have no FreeBSD driver): the compositor runs on
# the headless backend, so republish the session over VNC to make it reachable
# from the hypervisor host. wayvnc is an ordinary Wayland client (wlr-screencopy
# + virtual input) and needs no GPU.
if [ "${DINX_HEADLESS:-0}" = 1 ] && command -v wayvnc >/dev/null 2>&1; then
  wayvnc --render-cursor 0.0.0.0 "${DINX_VNC_PORT:-5900}" &
fi

exec pearl
EOF
chmod 755 "$init"

# Without /dev/dri no wlroots backend can scan out; fall back to headless and
# tell the init child to publish the session over VNC.
if [ ! -e /dev/dri/card0 ]; then
  export WLR_BACKENDS=headless
  export DINX_HEADLESS=1
  echo 'dinx-pearl-session: no /dev/dri, running headless' >&2
  if command -v wayvnc >/dev/null 2>&1; then
    echo "dinx-pearl-session: desktop available over VNC on port ${DINX_VNC_PORT:-5900}" >&2
  else
    echo 'dinx-pearl-session: install wayvnc to reach a headless session remotely' >&2
  fi
fi

exec aqueous -c "$init"

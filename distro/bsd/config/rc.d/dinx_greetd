#!/bin/sh
# PROVIDE: dinx_greetd
# REQUIRE: LOGIN
# KEYWORD: nojail

. /etc/rc.subr

name="dinx_greetd"
rcvar="dinx_greetd_enable"
pidfile="/var/run/greetd.pid"
command="/usr/sbin/daemon"
command_args="-p ${pidfile} /usr/local/sbin/greetd --config /usr/local/etc/greetd/config.toml"
start_precmd="dinx_greetd_precmd"

dinx_greetd_precmd()
{
	if [ ! -f /var/db/dinx-bsd/first-run-done ]; then
		echo "dinx_greetd: first-run wizard pending; start deferred"
		return 1
	fi

	# greetd's FreeBSD worker cannot query VT_GETSTATE on an inactive target.
	# Activate the dedicated VT before starting it; switch=false avoids that
	# broken ioctl path in the worker.
	if [ -c /dev/ttyv0 ]; then
		vidcontrol -s 8 </dev/ttyv0 >/dev/null 2>&1 || true
	fi

	# greetd defaults to /run/greetd.sock (Linux path); FreeBSD has /var/run.
	if [ ! -e /run ]; then
		ln -s /var/run /run
	fi
}

load_rc_config $name
run_rc_command "$1"

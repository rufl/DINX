# FreeBSD Port Makefile for Aqueous Compositor (DINX-BSD)
PORTNAME=	aqueous
PORTVERSION=	1.0.5
CATEGORIES=	x11-wm wayland
DISTNAME=	Aqueous-${PORTVERSION}

MAINTAINER=	rafael.dina@gmail.com
COMMENT=	Aqueous Wayland Compositor for DINX-BSD

LICENSE=	MIT

BUILD_DEPENDS=	zig>=0.16.0:lang/zig \
		wlroots020>=0.20.0:x11/wlroots020 \
		wayland-protocols>=0:graphics/wayland-protocols
RUN_DEPENDS=	seatd>=0.8.0:sysutils/seatd \
		pipewire>=1.0.0:multimedia/pipewire

USES=		pkgconfig wayland

# Local source tarball: place ${DISTFILES} in ${DISTDIR} before building.
MASTER_SITES=
DISTFILES=	${DISTNAME}.tar.gz

post-patch:
	@${PATCH} -d ${WRKSRC} -p1 < ${FILESDIR}/client-maximize-readiness.patch
	@${INSTALL_DATA} ${FILESDIR}/client_maximize_request.zig \
		${WRKSRC}/compositor/aqueous/wm/client_maximize_request.zig

do-build:
	@cd ${WRKSRC} && zig build -Doptimize=ReleaseSafe

do-install:
	@${INSTALL_PROGRAM} ${WRKSRC}/zig-out/bin/aqueous ${STAGEDIR}${PREFIX}/bin/

.include <bsd.port.mk>

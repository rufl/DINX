# FreeBSD Port Makefile Template for Aqueous Compositor
PORTNAME=	aqueous
PORTVERSION=	1.0.5
CATEGORIES=	x11-wm wayland
DISTNAME=	Aqueous-${PORTVERSION}

MAINTAINER=	rafael.dina@gmail.com
COMMENT=	Aqueous Wayland Compositor for DINX-BSD

LICENSE=	MIT

BUILD_DEPENDS=	zig>=0.17.0:lang/zig \
		wlroots>=0.18.0:x11-toolkits/wlroots \
		wayland-protocols>=0:graphics/wayland-protocols
RUN_DEPENDS=	seatd>=0.8.0:sysutils/seatd \
		pipewire>=1.0.0:multimedia/pipewire

USES=		pkgconfig wayland
USE_GITHUB=	yes
GH_ACCOUNT=	rufl
GH_PROJECT=	Aqueous

do-build:
	@cd ${WRKSRC} && zig build -Doptimize=ReleaseSafe

do-install:
	@${INSTALL_PROGRAM} ${WRKSRC}/zig-out/bin/aqueous ${STAGEDIR}${PREFIX}/bin/

.include <bsd.port.mk>

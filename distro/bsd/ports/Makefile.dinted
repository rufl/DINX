# FreeBSD Port Makefile for DintEd Editor (DINX-BSD)
PORTNAME=	dinted
PORTVERSION=	0.1.0
CATEGORIES=	editors textproc
MASTER_SITES=	https://github.com/rufl/dinted/releases/download/v0.1.0/
DISTNAME=	dinted-0.1.0

MAINTAINER=	trafael@dinx.org
COMMENT=	DintEd high-performance code editor for DINX-BSD
WWW=		https://github.com/rufl/DINX

LICENSE=	MIT
LICENSE_FILE=	${WRKSRC}/LICENSE

BUILD_DEPENDS=	zig>=0.13.0:lang/zig

USES=		zig
USE_ZIG=	yes

do-build:
	@cd ${WRKSRC} && zig build -Doptimize=ReleaseSafe

do-install:
	@mkdir -p ${STAGEDIR}${PREFIX}/bin
	@cp ${WRKSRC}/zig-out/bin/dinted ${STAGEDIR}${PREFIX}/bin/

.include <bsd.port.mk>

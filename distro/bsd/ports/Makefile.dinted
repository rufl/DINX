# FreeBSD Port Makefile for DintEd Editor (DINX-BSD)
PORTNAME=	dinted
PORTVERSION=	0.1.0
CATEGORIES=	editors textproc
MASTER_SITES=	https://github.com/rufl/dinted/releases/download/v0.1.0/
DISTNAME=	dinted-0.1.0

MAINTAINER=	trafael@dinx.org
COMMENT=	DintEd high-performance code editor for DINX-BSD
WWW=		https://github.com/rufl/DINX

LICENSE=	MIT
LICENSE_FILE=	${WRKSRC}/LICENSE

BUILD_DEPENDS=	zig>=0.13.0:lang/zig

USES=		zig
USE_ZIG=	yes

do-build:
	@cd ${WRKSRC} && zig build -Doptimize=ReleaseSafe

do-install:
	@${MKDIR} ${STAGEDIR}${PREFIX}/bin
	@if [ -f ${WRKSRC}/zig-out/bin/dintor ]; then \
		${INSTALL_PROGRAM} ${WRKSRC}/zig-out/bin/dintor ${STAGEDIR}${PREFIX}/bin/dintor; \
	elif [ -f ${WRKSRC}/zig-out/bin/dinted ]; then \
		${INSTALL_PROGRAM} ${WRKSRC}/zig-out/bin/dinted ${STAGEDIR}${PREFIX}/bin/dinted; \
		${LN} -sf dinted ${STAGEDIR}${PREFIX}/bin/dintor; \
	else \
		${ECHO_MSG} "Missing Dintor executable"; exit 1; \
	fi

.include <bsd.port.mk>

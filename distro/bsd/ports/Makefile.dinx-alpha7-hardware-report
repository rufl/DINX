# FreeBSD Port Makefile for DINX Alpha7 Hardware Report (DINX-BSD)
PORTNAME=	dinx-alpha7-hardware-report
PORTVERSION=	1.0.0
CATEGORIES=	sysutils diag
MASTER_SITES=	https://github.com/rufl/dinx-alpha7-hardware-report/releases/download/v1.0.0/
DISTNAME=	dinx-alpha7-hardware-report-1.0.0

MAINTAINER=	trafael@dinx.org
COMMENT=	DINX Alpha7 hardware diagnostics and reporting tool for DINX-BSD
WWW=		https://github.com/rufl/DINX

LICENSE=	MIT
LICENSE_FILE=	${WRKSRC}/LICENSE

BUILD_DEPENDS=	zig>=0.13.0:lang/zig

USES=		zig
USE_ZIG=	yes

do-build:
	@cd ${WRKSRC} && zig build -Doptimize=ReleaseSafe

do-install:
	@mkdir -p ${STAGEDIR}${PREFIX}/bin
	@cp ${WRKSRC}/zig-out/bin/dinx-alpha7-hardware-report ${STAGEDIR}${PREFIX}/bin/

.include <bsd.port.mk>

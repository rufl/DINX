# FreeBSD Port Makefile for DINX Audio Manager (DINX-BSD)
PORTNAME=	dinx-audio-manager
PORTVERSION=	1.0.0
CATEGORIES=	audio sysutils
MASTER_SITES=	https://github.com/rufl/dinx-audio-manager/releases/download/v1.0.0/
DISTNAME=	dinx-audio-manager-1.0.0

MAINTAINER=	trafael@dinx.org
COMMENT=	DINX audio control manager and PipeWire applet for DINX-BSD
WWW=		https://github.com/rufl/DINX

LICENSE=	MIT
LICENSE_FILE=	${WRKSRC}/LICENSE

BUILD_DEPENDS=	zig>=0.13.0:lang/zig
RUN_DEPENDS=	pipewire>=0:multimedia/pipewire \
		wireplumber>=0:multimedia/wireplumber

USES=		zig
USE_ZIG=	yes

do-build:
	@cd ${WRKSRC} && zig build -Doptimize=ReleaseSafe

do-install:
	@mkdir -p ${STAGEDIR}${PREFIX}/bin
	@cp ${WRKSRC}/zig-out/bin/dinx-audio-manager ${STAGEDIR}${PREFIX}/bin/

.include <bsd.port.mk>

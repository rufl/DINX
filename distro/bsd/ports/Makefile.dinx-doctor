# FreeBSD Port Makefile for DINX System Doctor (DINX-BSD)
PORTNAME=	dinx-doctor
PORTVERSION=	1.0.0
CATEGORIES=	sysutils diag
MASTER_SITES=	https://github.com/rufl/dinx-doctor/releases/download/v1.0.0/
DISTNAME=	dinx-doctor-1.0.0

MAINTAINER=	trafael@dinx.org
COMMENT=	DINX system doctor and troubleshooting diagnostics utility for DINX-BSD
WWW=		https://github.com/rufl/DINX

LICENSE=	MIT
LICENSE_FILE=	${WRKSRC}/LICENSE

BUILD_DEPENDS=	zig>=0.13.0:lang/zig

USES=		zig
USE_ZIG=	yes

do-build:
	@cd ${WRKSRC} && zig build -Doptimize=ReleaseSafe

do-install:
	@mkdir -p ${STAGEDIR}${PREFIX}/bin
	@cp ${WRKSRC}/zig-out/bin/dinx-doctor ${STAGEDIR}${PREFIX}/bin/

.include <bsd.port.mk>

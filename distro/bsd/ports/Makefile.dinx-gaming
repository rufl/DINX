# FreeBSD Port Makefile for DINX Gaming Optimizer (DINX-BSD)
PORTNAME=	dinx-gaming
PORTVERSION=	1.0.0
CATEGORIES=	games sysutils
MASTER_SITES=	https://github.com/rufl/dinx-gaming/releases/download/v1.0.0/
DISTNAME=	dinx-gaming-1.0.0

MAINTAINER=	trafael@dinx.org
COMMENT=	DINX gaming environment optimizer and proton integration for DINX-BSD
WWW=		https://github.com/rufl/DINX

LICENSE=	MIT
LICENSE_FILE=	${WRKSRC}/LICENSE

BUILD_DEPENDS=	zig>=0.13.0:lang/zig
RUN_DEPENDS=	vulkan-loader>=0:graphics/vulkan-loader \
		wine>=8.0:emulators/wine-staging

USES=		zig
USE_ZIG=	yes

do-build:
	@cd ${WRKSRC} && zig build -Doptimize=ReleaseSafe

do-install:
	@mkdir -p ${STAGEDIR}${PREFIX}/bin
	@cp ${WRKSRC}/zig-out/bin/dinx-gaming ${STAGEDIR}${PREFIX}/bin/

.include <bsd.port.mk>

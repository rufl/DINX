# FreeBSD Port Makefile for DINX Graphics Profile Manager (DINX-BSD)
PORTNAME=	dinx-graphics-profile
PORTVERSION=	1.0.0
CATEGORIES=	sysutils graphics
MASTER_SITES=	https://github.com/rufl/dinx-graphics-profile/releases/download/v1.0.0/
DISTNAME=	dinx-graphics-profile-1.0.0

MAINTAINER=	trafael@dinx.org
COMMENT=	DINX graphics profile and hardware switching utility for DINX-BSD
WWW=		https://github.com/rufl/DINX

LICENSE=	MIT
LICENSE_FILE=	${WRKSRC}/LICENSE

BUILD_DEPENDS=	zig>=0.13.0:lang/zig

USES=		zig
USE_ZIG=	yes

do-build:
	@cd ${WRKSRC} && zig build -Doptimize=ReleaseSafe

do-install:
	@mkdir -p ${STAGEDIR}${PREFIX}/bin
	@cp ${WRKSRC}/zig-out/bin/dinx-graphics-profile ${STAGEDIR}${PREFIX}/bin/

.include <bsd.port.mk>

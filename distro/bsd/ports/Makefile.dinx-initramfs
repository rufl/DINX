# FreeBSD Port Makefile for DINX Initramfs Tool (DINX-BSD)
PORTNAME=	dinx-initramfs
PORTVERSION=	1.0.0
CATEGORIES=	sysutils
MASTER_SITES=	https://github.com/rufl/dinx-initramfs/releases/download/v1.0.0/
DISTNAME=	dinx-initramfs-1.0.0

MAINTAINER=	trafael@dinx.org
COMMENT=	DINX initramfs manifest and boot image generator for DINX-BSD
WWW=		https://github.com/rufl/DINX

LICENSE=	MIT
LICENSE_FILE=	${WRKSRC}/LICENSE

BUILD_DEPENDS=	zig>=0.13.0:lang/zig
RUN_DEPENDS=	gtar>=0:archivers/gtar

USES=		zig
USE_ZIG=	yes

do-build:
	@cd ${WRKSRC} && zig build -Doptimize=ReleaseSafe

do-install:
	@mkdir -p ${STAGEDIR}${PREFIX}/bin
	@cp ${WRKSRC}/zig-out/bin/dinx-initramfs ${STAGEDIR}${PREFIX}/bin/

.include <bsd.port.mk>

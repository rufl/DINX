# FreeBSD Port Makefile for DINX Keyring Management (DINX-BSD)
PORTNAME=	dinx-keyring
PORTVERSION=	1.0.0
CATEGORIES=	security sysutils
MASTER_SITES=	https://github.com/rufl/dinx-keyring/releases/download/v1.0.0/
DISTNAME=	dinx-keyring-1.0.0

MAINTAINER=	trafael@dinx.org
COMMENT=	DINX package signing keyring and verification tool for DINX-BSD
WWW=		https://github.com/rufl/DINX

LICENSE=	MIT
LICENSE_FILE=	${WRKSRC}/LICENSE

BUILD_DEPENDS=	zig>=0.13.0:lang/zig
RUN_DEPENDS=	gnupg>=2.0:security/gnupg

USES=		zig
USE_ZIG=	yes

do-build:
	@cd ${WRKSRC} && zig build -Doptimize=ReleaseSafe

do-install:
	@mkdir -p ${STAGEDIR}${PREFIX}/bin
	@cp ${WRKSRC}/zig-out/bin/dinx-keyring ${STAGEDIR}${PREFIX}/bin/

.include <bsd.port.mk>

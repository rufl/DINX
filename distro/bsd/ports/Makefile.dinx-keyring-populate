# FreeBSD Port Makefile for DINX Keyring Populate (DINX-BSD)
PORTNAME=	dinx-keyring-populate
PORTVERSION=	1.0.0
CATEGORIES=	security sysutils
MASTER_SITES=	https://github.com/rufl/dinx-keyring-populate/releases/download/v1.0.0/
DISTNAME=	dinx-keyring-populate-1.0.0

MAINTAINER=	trafael@dinx.org
COMMENT=	DINX cryptographic keyring and package signature populator for DINX-BSD
WWW=		https://github.com/rufl/DINX

LICENSE=	MIT
LICENSE_FILE=	${WRKSRC}/LICENSE

BUILD_DEPENDS=	zig>=0.13.0:lang/zig
RUN_DEPENDS=	gnupg>=2.0:security/gnupg

USES=		zig
USE_ZIG=	yes

do-build:
	@cd ${WRKSRC} && zig build -Doptimize=ReleaseSafe

do-install:
	@mkdir -p ${STAGEDIR}${PREFIX}/bin
	@cp ${WRKSRC}/zig-out/bin/dinx-keyring-populate ${STAGEDIR}${PREFIX}/bin/

.include <bsd.port.mk>

# FreeBSD Port Makefile for DINX Live Autologin (DINX-BSD)
PORTNAME=	dinx-live-autologin
PORTVERSION=	1.0.0
CATEGORIES=	sysutils x11
MASTER_SITES=	https://github.com/rufl/dinx-live-autologin/releases/download/v1.0.0/
DISTNAME=	dinx-live-autologin-1.0.0

MAINTAINER=	trafael@dinx.org
COMMENT=	DINX live session passwordless autologin manager for DINX-BSD
WWW=		https://github.com/rufl/DINX

LICENSE=	MIT
LICENSE_FILE=	${WRKSRC}/LICENSE

BUILD_DEPENDS=	zig>=0.13.0:lang/zig
RUN_DEPENDS=	greetd>=0:x11/greetd

USES=		zig
USE_ZIG=	yes

do-build:
	@cd ${WRKSRC} && zig build -Doptimize=ReleaseSafe

do-install:
	@mkdir -p ${STAGEDIR}${PREFIX}/bin
	@cp ${WRKSRC}/zig-out/bin/dinx-live-autologin ${STAGEDIR}${PREFIX}/bin/

.include <bsd.port.mk>

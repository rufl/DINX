# FreeBSD Port Makefile for DINX Live Root Overrides (DINX-BSD)
PORTNAME=	dinx-live-root-overrides
PORTVERSION=	1.0.0
CATEGORIES=	sysutils
MASTER_SITES=	https://github.com/rufl/dinx-live-root-overrides/releases/download/v1.0.0/
DISTNAME=	dinx-live-root-overrides-1.0.0

MAINTAINER=	trafael@dinx.org
COMMENT=	DINX live session root file system overlays and override manager for DINX-BSD
WWW=		https://github.com/rufl/DINX

LICENSE=	MIT
LICENSE_FILE=	${WRKSRC}/LICENSE

BUILD_DEPENDS=	zig>=0.13.0:lang/zig

USES=		zig
USE_ZIG=	yes

do-build:
	@cd ${WRKSRC} && zig build -Doptimize=ReleaseSafe

do-install:
	@mkdir -p ${STAGEDIR}${PREFIX}/bin
	@cp ${WRKSRC}/zig-out/bin/dinx-live-root-overrides ${STAGEDIR}${PREFIX}/bin/

.include <bsd.port.mk>

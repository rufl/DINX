# FreeBSD Port Makefile for DINX Network Manager (DINX-BSD)
PORTNAME=	dinx-network-manager
PORTVERSION=	1.0.0
CATEGORIES=	net sysutils
MASTER_SITES=	https://github.com/rufl/dinx-network-manager/releases/download/v1.0.0/
DISTNAME=	dinx-network-manager-1.0.0

MAINTAINER=	trafael@dinx.org
COMMENT=	DINX network manager and connection applet for DINX-BSD
WWW=		https://github.com/rufl/DINX

LICENSE=	MIT
LICENSE_FILE=	${WRKSRC}/LICENSE

BUILD_DEPENDS=	zig>=0.13.0:lang/zig
RUN_DEPENDS=	NetworkManager>=0:net/networkmanager

USES=		zig
USE_ZIG=	yes

do-build:
	@cd ${WRKSRC} && zig build -Doptimize=ReleaseSafe

do-install:
	@mkdir -p ${STAGEDIR}${PREFIX}/bin
	@cp ${WRKSRC}/zig-out/bin/dinx-network-manager ${STAGEDIR}${PREFIX}/bin/

.include <bsd.port.mk>

# FreeBSD Port Makefile for DINX Package Channel Manager (DINX-BSD)
PORTNAME=	dinx-package-channel
PORTVERSION=	1.0.0
CATEGORIES=	sysutils ports-mgmt
MASTER_SITES=	https://github.com/rufl/dinx-package-channel/releases/download/v1.0.0/
DISTNAME=	dinx-package-channel-1.0.0

MAINTAINER=	trafael@dinx.org
COMMENT=	DINX package channel synchronization and repository manager for DINX-BSD
WWW=		https://github.com/rufl/DINX

LICENSE=	MIT
LICENSE_FILE=	${WRKSRC}/LICENSE

BUILD_DEPENDS=	zig>=0.13.0:lang/zig
RUN_DEPENDS=	pkg>=0:ports-mgmt/pkg

USES=		zig
USE_ZIG=	yes

do-build:
	@cd ${WRKSRC} && zig build -Doptimize=ReleaseSafe

do-install:
	@mkdir -p ${STAGEDIR}${PREFIX}/bin
	@cp ${WRKSRC}/zig-out/bin/dinx-package-channel ${STAGEDIR}${PREFIX}/bin/

.include <bsd.port.mk>

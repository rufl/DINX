# FreeBSD Port Makefile for DINX Pearl Greeter Host (DINX-BSD)
PORTNAME=	dinx-pearl-greeter-host
PORTVERSION=	1.0.0
DISTNAME=	${PORTNAME}-${PORTVERSION}

CATEGORIES=	x11 sysutils

MAINTAINER=	trafael@dinx.org
COMMENT=	DINX Pearl greeter host daemon for DINX-BSD
WWW=		https://github.com/rufl/DINX

LICENSE=	MIT
LICENSE_FILE=	${WRKSRC}/LICENSE

# Requires dinx-pearl and dinx-greetd from the local DINX repository;
# greetd is not a FreeBSD port and cannot be a BUILD_DEPENDS origin.
BUILD_DEPENDS=	zig>=0.16.0:lang/zig

USES=		pkgconfig

# Source tarball: Seafoam-Labs/pearl v0.3.0 release archive; port builds
# dinx-pearl-greeter-host from the pearl source tree (no upstream tarball exists).
MASTER_SITES=	https://github.com/Seafoam-Labs/pearl/archive/refs/tags/
DISTFILES=	v0.3.0.tar.gz
WRKSRC=		${WRKDIR}/pearl-0.3.0
do-build:
	@cd ${WRKSRC} && zig build -Doptimize=ReleaseSafe

do-install:
	@mkdir -p ${STAGEDIR}${PREFIX}/bin
	@cp ${WRKSRC}/zig-out/bin/dinx-pearl-greeter-host ${STAGEDIR}${PREFIX}/bin/

.include <bsd.port.mk>

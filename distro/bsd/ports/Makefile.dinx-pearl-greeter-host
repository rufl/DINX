# FreeBSD Port Makefile for DINX Pearl Greeter Host (DINX-BSD)
PORTNAME=	dinx-pearl-greeter-host
PORTVERSION=	1.0.0
CATEGORIES=	x11 sysutils
MASTER_SITES=	https://github.com/rufl/dinx-pearl-greeter-host/releases/download/v1.0.0/
DISTNAME=	dinx-pearl-greeter-host-1.0.0

MAINTAINER=	trafael@dinx.org
COMMENT=	DINX Pearl greeter host daemon for DINX-BSD
WWW=		https://github.com/rufl/DINX

LICENSE=	MIT
LICENSE_FILE=	${WRKSRC}/LICENSE

BUILD_DEPENDS=	zig>=0.13.0:lang/zig
RUN_DEPENDS=	pearl>=0.3.0:x11-wm/pearl \
		greetd>=0:x11/greetd

USES=		zig
USE_ZIG=	yes

do-build:
	@cd ${WRKSRC} && zig build -Doptimize=ReleaseSafe

do-install:
	@mkdir -p ${STAGEDIR}${PREFIX}/bin
	@cp ${WRKSRC}/zig-out/bin/dinx-pearl-greeter-host ${STAGEDIR}${PREFIX}/bin/

.include <bsd.port.mk>

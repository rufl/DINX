# FreeBSD Port Makefile for DINX Pearl Community Themes (DINX-BSD)
PORTNAME=       dinx-pearl-themes
PORTVERSION=    1.1.0
PORTREVISION=   1
CATEGORIES=     x11-themes

MAINTAINER=     trafael@dinx.org
COMMENT=        DINX Pearl themes with rounded and square corners
WWW=            https://github.com/rufl/DINX

LICENSE=        GPLv3

RUN_DEPENDS=    pearl>=0.3.0:x11-wm/pearl

USES=           python:run
USE_GITHUB=     yes
GH_TUPLE=       rufl:skeuos-gtk:43561ba9c384ea401e19fed5ebfec27f8f4350af:skeuos \
                rufl:Orchis-theme:6475a42a9d14261cf85fc6f428e7f44f0168bef1:orchis \
                rufl:Fluent-gtk-theme:7befd876d72d7d4d748b6576e5cc404d34e4acd7:fluent \
                rufl:Jasper-gtk-theme:e52cbfadceb95d5f3da1c3fea80a1b42a37c81e8:jasper

NO_BUILD=       yes

THEME_DIR=      ${STAGEDIR}${PREFIX}/share/pearl/themes

post-extract:
	@${FIND} ${WRKSRC_skeuos}/themes ${WRKSRC_orchis}/themes ${WRKSRC_fluent}/themes ${WRKSRC_jasper}/themes -type f -name '*.json' -exec ${CHMOD} u+w {} +

do-install:
	@${MKDIR} ${THEME_DIR}
	@for theme in skeuos-rounded skeuos-square; do \
		${MKDIR} ${THEME_DIR}/dinx.$${theme}; \
		${CP} -R ${WRKSRC_skeuos}/themes/$${theme}/. ${THEME_DIR}/dinx.$${theme}/; \
	done
	@for theme in orchis-rounded orchis-square; do \
		${MKDIR} ${THEME_DIR}/dinx.$${theme}; \
		${CP} -R ${WRKSRC_orchis}/themes/$${theme}/. ${THEME_DIR}/dinx.$${theme}/; \
	done
	@for theme in fluent-rounded fluent-square; do \
		${MKDIR} ${THEME_DIR}/dinx.$${theme}; \
		${CP} -R ${WRKSRC_fluent}/themes/$${theme}/. ${THEME_DIR}/dinx.$${theme}/; \
	done
	@for theme in jasper-rounded jasper-square; do \
		${MKDIR} ${THEME_DIR}/dinx.$${theme}; \
		${CP} -R ${WRKSRC_jasper}/themes/$${theme}/. ${THEME_DIR}/dinx.$${theme}/; \
	done
	@${PYTHON_CMD} ${FILESDIR}/dinx-pearl-themes-normalize.py ${THEME_DIR}
	@${INSTALL_DATA} ${WRKSRC_skeuos}/LICENSE ${THEME_DIR}/dinx.skeuos-rounded/LICENSE
	@${INSTALL_DATA} ${WRKSRC_skeuos}/LICENSE ${THEME_DIR}/dinx.skeuos-square/LICENSE
	@${INSTALL_DATA} ${WRKSRC_orchis}/COPYING ${THEME_DIR}/dinx.orchis-rounded/COPYING
	@${INSTALL_DATA} ${WRKSRC_orchis}/COPYING ${THEME_DIR}/dinx.orchis-square/COPYING
	@${INSTALL_DATA} ${WRKSRC_fluent}/COPYING ${THEME_DIR}/dinx.fluent-rounded/COPYING
	@${INSTALL_DATA} ${WRKSRC_fluent}/COPYING ${THEME_DIR}/dinx.fluent-square/COPYING
	@${INSTALL_DATA} ${WRKSRC_jasper}/LICENSE ${THEME_DIR}/dinx.jasper-rounded/LICENSE
	@${INSTALL_DATA} ${WRKSRC_jasper}/LICENSE ${THEME_DIR}/dinx.jasper-square/LICENSE

.include <bsd.port.mk>

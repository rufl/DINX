# FreeBSD Port Makefile for DINX Power Manager (DINX-BSD)
PORTNAME=	dinx-power-manager
PORTVERSION=	1.0.0
CATEGORIES=	sysutils power
MASTER_SITES=	https://github.com/rufl/dinx-power-manager/releases/download/v1.0.0/
DISTNAME=	dinx-power-manager-1.0.0

MAINTAINER=	trafael@dinx.org
COMMENT=	DINX power management daemon and battery applet for DINX-BSD
WWW=		https://github.com/rufl/DINX

LICENSE=	MIT
LICENSE_FILE=	${WRKSRC}/LICENSE

BUILD_DEPENDS=	zig>=0.13.0:lang/zig

USES=		zig
USE_ZIG=	yes

do-build:
	@cd ${WRKSRC} && zig build -Doptimize=ReleaseSafe

do-install:
	@mkdir -p ${STAGEDIR}${PREFIX}/bin
	@cp ${WRKSRC}/zig-out/bin/dinx-power-manager ${STAGEDIR}${PREFIX}/bin/

.include <bsd.port.mk>

# FreeBSD Port Makefile for DINX Qt Palette (DINX-BSD)
PORTNAME=	dinx-qt-palette
PORTVERSION=	1.0.0
CATEGORIES=	x11-toolkits sysutils
MASTER_SITES=	https://github.com/rufl/dinx-qt-palette/releases/download/v1.0.0/
DISTNAME=	dinx-qt-palette-1.0.0

MAINTAINER=	trafael@dinx.org
COMMENT=	DINX Qt palette and color scheme synchronizer for DINX-BSD
WWW=		https://github.com/rufl/DINX

LICENSE=	MIT
LICENSE_FILE=	${WRKSRC}/LICENSE

BUILD_DEPENDS=	zig>=0.13.0:lang/zig
RUN_DEPENDS=	qt6-base>=6.0:x11-toolkits/qt6-base

USES=		zig
USE_ZIG=	yes

do-build:
	@cd ${WRKSRC} && zig build -Doptimize=ReleaseSafe

do-install:
	@mkdir -p ${STAGEDIR}${PREFIX}/bin
	@cp ${WRKSRC}/zig-out/bin/dinx-qt-palette ${STAGEDIR}${PREFIX}/bin/

.include <bsd.port.mk>

# FreeBSD Port Makefile for DINX Aqueous Live Seeder (DINX-BSD)
PORTNAME=	dinx-seed-aqueous-live-config
PORTVERSION=	1.0.0
CATEGORIES=	x11-wm sysutils
MASTER_SITES=	https://github.com/rufl/dinx-seed-aqueous-live-config/releases/download/v1.0.0/
DISTNAME=	dinx-seed-aqueous-live-config-1.0.0

MAINTAINER=	trafael@dinx.org
COMMENT=	DINX live configuration seeder for Aqueous compositor on DINX-BSD
WWW=		https://github.com/rufl/DINX

LICENSE=	MIT
LICENSE_FILE=	${WRKSRC}/LICENSE

BUILD_DEPENDS=	zig>=0.13.0:lang/zig
RUN_DEPENDS=	aqueous>=1.0.5:x11-wm/aqueous

USES=		zig
USE_ZIG=	yes

do-build:
	@cd ${WRKSRC} && zig build -Doptimize=ReleaseSafe

do-install:
	@mkdir -p ${STAGEDIR}${PREFIX}/bin
	@cp ${WRKSRC}/zig-out/bin/dinx-seed-aqueous-live-config ${STAGEDIR}${PREFIX}/bin/

.include <bsd.port.mk>

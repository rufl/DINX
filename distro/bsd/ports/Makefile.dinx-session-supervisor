# FreeBSD Port Makefile for DINX Session Supervisor (DINX-BSD)
PORTNAME=	dinx-session-supervisor
PORTVERSION=	1.0.0
CATEGORIES=	sysutils x11-wm
MASTER_SITES=	https://github.com/rufl/dinx-session-supervisor/releases/download/v1.0.0/
DISTNAME=	dinx-session-supervisor-1.0.0

MAINTAINER=	trafael@dinx.org
COMMENT=	DINX session supervisor and lifecycle daemon for DINX-BSD
WWW=		https://github.com/rufl/DINX

LICENSE=	MIT
LICENSE_FILE=	${WRKSRC}/LICENSE

BUILD_DEPENDS=	zig>=0.13.0:lang/zig

USES=		zig
USE_ZIG=	yes

do-build:
	@cd ${WRKSRC} && zig build -Doptimize=ReleaseSafe

do-install:
	@mkdir -p ${STAGEDIR}${PREFIX}/bin
	@cp ${WRKSRC}/zig-out/bin/dinx-session-supervisor ${STAGEDIR}${PREFIX}/bin/

.include <bsd.port.mk>

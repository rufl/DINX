# FreeBSD Port Makefile for DINX System Tray (DINX-BSD)
PORTNAME=	dinx-tray
PORTVERSION=	1.0.0
CATEGORIES=	x11 sysutils
MASTER_SITES=	https://github.com/rufl/dinx-tray/releases/download/v1.0.0/
DISTNAME=	dinx-tray-1.0.0

MAINTAINER=	trafael@dinx.org
COMMENT=	DINX system tray application and status applet for DINX-BSD
WWW=		https://github.com/rufl/DINX

LICENSE=	MIT
LICENSE_FILE=	${WRKSRC}/LICENSE

BUILD_DEPENDS=	zig>=0.13.0:lang/zig
RUN_DEPENDS=	wayland>=0:graphics/wayland

USES=		zig
USE_ZIG=	yes

do-build:
	@cd ${WRKSRC} && zig build -Doptimize=ReleaseSafe

do-install:
	@mkdir -p ${STAGEDIR}${PREFIX}/bin
	@cp ${WRKSRC}/zig-out/bin/dinx-tray ${STAGEDIR}${PREFIX}/bin/

.include <bsd.port.mk>

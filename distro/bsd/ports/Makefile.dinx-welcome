# FreeBSD Port Makefile for DINX Welcome Wizard (DINX-BSD)
PORTNAME=	dinx-welcome
PORTVERSION=	1.0.0
CATEGORIES=	sysutils x11
MASTER_SITES=	https://github.com/rufl/dinx-welcome/releases/download/v1.0.0/
DISTNAME=	dinx-welcome-1.0.0

MAINTAINER=	trafael@dinx.org
COMMENT=	DINX welcome and initial setup wizard for DINX-BSD
WWW=		https://github.com/rufl/DINX

LICENSE=	MIT
LICENSE_FILE=	${WRKSRC}/LICENSE

BUILD_DEPENDS=	zig>=0.13.0:lang/zig

USES=		zig
USE_ZIG=	yes

do-build:
	@cd ${WRKSRC} && zig build -Doptimize=ReleaseSafe

do-install:
	@mkdir -p ${STAGEDIR}${PREFIX}/bin
	@cp ${WRKSRC}/zig-out/bin/dinx-welcome ${STAGEDIR}${PREFIX}/bin/

.include <bsd.port.mk>

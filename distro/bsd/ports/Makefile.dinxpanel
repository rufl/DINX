# FreeBSD Port Makefile for DINXPanel (DINX-BSD)
PORTNAME=	dinxpanel
PORTVERSION=	1.0.0
CATEGORIES=	x11
MASTER_SITES=	https://github.com/rufl/dinxpanel/releases/download/v1.0.0/
DISTNAME=	dinxpanel-1.0.0

MAINTAINER=	trafael@dinx.org
COMMENT=	DINX panel and system status bar for DINX-BSD
WWW=		https://github.com/rufl/DINX

LICENSE=	MIT
LICENSE_FILE=	${WRKSRC}/LICENSE

BUILD_DEPENDS=	zig>=0.13.0:lang/zig

USES=		zig
USE_ZIG=	yes

do-build:
	@cd ${WRKSRC} && zig build -Doptimize=ReleaseSafe

do-install:
	@mkdir -p ${STAGEDIR}${PREFIX}/bin
	@cp ${WRKSRC}/zig-out/bin/dinxpanel ${STAGEDIR}${PREFIX}/bin/

.include <bsd.port.mk>

# FreeBSD Port Makefile for File Roller (DINX-BSD)
PORTNAME=	file-roller
PORTVERSION=	44.3
CATEGORIES=	archivers gnome
MASTER_SITES=	https://download.gnome.org/sources/file-roller/44/
DISTNAME=	file-roller-44.3

MAINTAINER=	trafael@dinx.org
COMMENT=	File Roller archive manager for DINX-BSD
WWW=		https://wiki.gnome.org/Apps/FileRoller

LICENSE=	GPLv2+
LICENSE_FILE=	${WRKSRC}/COPYING

BUILD_DEPENDS=	meson>=0.59:devel/meson \
		ninja>=1.10:devel/ninja \
		itstool>=0:textproc/itstool
RUN_DEPENDS=	gtksourceview4>=4.0:x11-toolkits/gtksourceview4 \
		libarchive>=3.4:archivers/libarchive

USES=		compiler:c99 gettext gnome meson ninja pkgconfig tar:xz
USE_GNOME=	gtk30 glib20

do-install:
	@mkdir -p ${STAGEDIR}${PREFIX}/bin
	@cp ${WRKSRC}/build/src/file-roller ${STAGEDIR}${PREFIX}/bin/

.include <bsd.port.mk>

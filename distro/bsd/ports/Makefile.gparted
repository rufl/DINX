# FreeBSD Port Makefile for GParted (DINX-BSD)
PORTNAME=	gparted
PORTVERSION=	1.6.0
CATEGORIES=	sysutils
MASTER_SITES=	https://download.gnome.org/sources/gparted/1.6/
DISTNAME=	gparted-1.6.0

MAINTAINER=	trafael@dinx.org
COMMENT=	GParted graphical partition editor for DINX-BSD
WWW=		https://gparted.org

LICENSE=	GPLv2
LICENSE_FILE=	${WRKSRC}/COPYING

BUILD_DEPENDS=	intltool>=0:textproc/intltool \
		gtkmm3>=3.24:x11-toolkits/gtkmm3
RUN_DEPENDS=	parted>=3.3:sysutils/parted \
		polkit>=0:sysutils/polkit

USES=		compiler:c++11-lang gettext gmake gnome pkgconfig tar:xz
USE_GNOME=	gtkmm3 glib20

do-install:
	@mkdir -p ${STAGEDIR}${PREFIX}/bin
	@cp ${WRKSRC}/src/gpartedbin ${STAGEDIR}${PREFIX}/bin/gparted

.include <bsd.port.mk>

# FreeBSD Port Makefile for kwm, the DINX-BSD window manager (DINX-BSD)
#
# kwm is a DWM-style dynamic tiling window manager implementing
# river-window-management-v1, i.e. it is the window manager half of a river
# session (river is the compositor and manages nothing by itself).
#
# Toolchain note: kwm requires Zig 0.17.x. The FreeBSD ports tree only ships
# lang/zig (0.16) and lang/zig015 (0.15.2), so USES=zig cannot express this
# dependency; the upstream toolchain tarball is fetched and pinned here
# instead. Replace with USES=zig:017 once that port exists.
PORTNAME=	kwm
PORTVERSION=	0.3.0
CATEGORIES=	x11-wm wayland

# Pinned source revision and toolchain; keep in lockstep with kwm's
# build.zig.zon minimum. Defined before use: GitHub names the archive
# directory after the ref, so a commit tarball unpacks to
# kwm-${KWM_REV}, not kwm-${PORTVERSION}.
KWM_REV=	8dafe7ec636894131521990c2effa3daa09eb205
ZIG_VERSION=	0.17.1
ZIG_DISTNAME=	zig-x86_64-freebsd-${ZIG_VERSION}
ZIG_CMD=	${WRKDIR}/${ZIG_DISTNAME}/zig

# Pinned to ${KWM_REV}, NOT to the v0.3.0 tag: the tag's build.zig still reads
# Build.build_root, which Zig 0.17 removed, so `zig build` fails at configure
# (proven: "no field named 'build_root'"), and the tag ships no kwim client.
# That commit's build.zig.zon still says .version = "0.3.0", and its src is
# byte-identical to the tree the porting patch was built against (diff -rq
# clean) and carries no build_root use.
MASTER_SITES=	https://github.com/kewuaa/kwm/archive/ \
		https://ziglang.org/download/${ZIG_VERSION}/:zig
DISTFILES=	${KWM_REV}.tar.gz \
		${ZIG_DISTNAME}.tar.xz:zig

MAINTAINER=	trafael@dinx.org
COMMENT=	DWM-style tiling window manager for the river compositor
WWW=		https://github.com/kewuaa/kwm

LICENSE=	GPLv3
LICENSE_FILE=	${WRKSRC}/LICENSE

# wayland-scanner's pkgdatadir is resolved through pkg-config at configure
# time; without it the build dies with
# "FileNotFound: pkg-config --variable=pkgdatadir wayland-scanner", and scdoc
# is required by kwm's own build.zig for the man page. The Zig compiler is NOT
# a port dependency here: the pinned FreeBSD toolchain is vendored as a
# distfile below, because lang/zig is 0.16 and this source is proven against
# 0.17.1 (the porting patch assumes the 0.17 std.posix surface).
BUILD_DEPENDS=	pkgconf>=0:devel/pkgconf \
		wayland-protocols>=0:graphics/wayland-protocols \
		scdoc>=0:textproc/scdoc
LIB_DEPENDS=	libwayland-client.so:graphics/wayland \
		libxkbcommon.so:x11/libxkbcommon \
		libpixman-1.so:x11/pixman \
		libfcft.so:x11-fonts/fcft
RUN_DEPENDS=	river>=0.4:x11-wm/river

USES=		pkgconfig

# Pinned source revision and toolchain; keep in lockstep with kwm's
# build.zig.zon minimum. GitHub names the archive directory after the ref, so
# a commit tarball unpacks to kwm-${KWM_REV}, not kwm-${PORTVERSION}.
KWM_REV=	8dafe7ec636894131521990c2effa3daa09eb205
WRKSRC=		${WRKDIR}/${PORTNAME}-${KWM_REV}
ZIG_VERSION=	0.17.1
ZIG_DISTNAME=	zig-x86_64-freebsd-${ZIG_VERSION}
ZIG_CMD=	${WRKDIR}/${ZIG_DISTNAME}/zig

# The bar is the only status surface in a river session (river has no panel of
# its own), and kwim configures input devices so a headless guest with no evdev
# nodes still gets usable pointer/keyboard defaults.
ZIG_BUILD_ARGS=	-Doptimize=ReleaseSafe -Dbar=true -Dkwim=true

# FreeBSD porting patches (scripts/bsd-vm/patch-kwm-freebsd.py carries the
# annotated rationale): std.c.TFD is void on FreeBSD, signalfd(2) does not
# exist, itimerspec renames its fields, and E.LIBBAD is Linux-only. The diff
# paths are WRKSRC-relative, hence -p0.
# Tag-state socket publisher (kwm-tags.patch, -p1): river >= 0.5 removed
# zriver_status_manager_v1, so kwm is the sole owner of tag state and
# publishes it over "$XDG_RUNTIME_DIR/dinx-kwm-tags.sock"
# ("T <focused_hex> <occupied_hex>") for the morghulis KwmTags widget. Its
# consumer lives on the morghulis port (files/morghulis-kwm-tags.vala, applied
# by scripts/bsd-vm/build-astal-morghulis.sh). Without it KwmTags renders an
# empty bar.
post-patch:
	@${PATCH} -d ${WRKSRC} -p0 < ${FILESDIR}/kwm-freebsd.patch
	@${PATCH} -d ${WRKSRC} -p1 < ${FILESDIR}/kwm-tags.patch

# Vendored toolchain: the framework already unpacks the .tar.xz distfile into
# ${WRKDIR}/zig-x86_64-freebsd-${ZIG_VERSION}; this only covers the case where
# EXTRACT_ONLY is narrowed, and stays silent otherwise.
post-extract:
	@if [ ! -x ${ZIG_CMD} ]; then \
	  ${TAR} -C ${WRKDIR} -xf ${DISTDIR}/${ZIG_DISTNAME}.tar.xz; \
	fi

do-build:
	@if [ ! -x ${ZIG_CMD} ]; then \
	  ${ECHO_CMD} "missing pinned Zig at ${ZIG_CMD}"; exit 1; \
	fi
	@cd ${WRKSRC} && ${ZIG_CMD} build --fetch && ${ZIG_CMD} build ${ZIG_BUILD_ARGS}

do-install:
	@${MKDIR} ${STAGEDIR}${PREFIX}/bin
	${INSTALL_PROGRAM} ${WRKSRC}/zig-out/bin/kwm ${STAGEDIR}${PREFIX}/bin/
	@if [ -f ${WRKSRC}/zig-out/bin/kwim ]; then \
	  ${INSTALL_PROGRAM} ${WRKSRC}/zig-out/bin/kwim ${STAGEDIR}${PREFIX}/bin/; \
	fi
	@${MKDIR} ${STAGEDIR}${PREFIX}/etc/xdg/kwm
	${INSTALL_DATA} ${WRKSRC}/config.def.zon ${STAGEDIR}${PREFIX}/etc/xdg/kwm/config.zon
	@${MKDIR} ${STAGEDIR}${PREFIX}/share/man/man1
	${INSTALL_MAN} ${WRKSRC}/doc/kwm.1 ${STAGEDIR}${PREFIX}/share/man/man1/

.include <bsd.port.mk>

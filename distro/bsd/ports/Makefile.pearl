# FreeBSD Port Makefile for Pearl Desktop Shell (DINX-BSD)
PORTNAME=	pearl
PORTVERSION=	0.3.0
DISTNAME=	${PORTNAME}-${PORTVERSION}

CATEGORIES=	x11-wm wayland

MAINTAINER=	trafael@dinx.org
COMMENT=	Pearl desktop shell for DINX-BSD
WWW=		https://github.com/rufl/DINX

LICENSE=	MIT
LICENSE_FILE=	${WRKSRC}/LICENSE

BUILD_DEPENDS=	zig>=0.16.0:lang/zig \
		gtk40>=0:x11-toolkits/gtk40 \
		wayland-protocols>=0:graphics/wayland-protocols
RUN_DEPENDS=	seatd>=0:sysutils/seatd \
		pipewire>=0:multimedia/pipewire

USES=		pkgconfig wayland

# Source tarball: Seafoam-Labs/pearl v0.3.0 release archive (has release artifacts).
MASTER_SITES=	https://github.com/Seafoam-Labs/pearl/archive/refs/tags/
DISTFILES=	v0.3.0.tar.gz

post-patch:
	@${PATCH} -d ${WRKSRC} -p1 < ${FILESDIR}/greeter-state-home.patch
	@${PATCH} -d ${WRKSRC} -p1 < ${FILESDIR}/remove-find-your-next-thing.patch

do-build:
	@cd ${WRKSRC} && zig build -Doptimize=ReleaseSafe

do-install:
	@mkdir -p ${STAGEDIR}${PREFIX}/bin
	@cp ${WRKSRC}/zig-out/bin/pearl ${STAGEDIR}${PREFIX}/bin/

.include <bsd.port.mk>

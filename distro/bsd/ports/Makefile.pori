# FreeBSD Port Makefile for Pori Storage Manager (DINX-BSD)
PORTNAME=	pori
PORTVERSION=	0.1.0
CATEGORIES=	sysutils
MASTER_SITES=	https://github.com/rufl/pori/releases/download/v0.1.0/
DISTNAME=	pori-0.1.0

MAINTAINER=	trafael@dinx.org
COMMENT=	Pori storage and mount manager for DINX-BSD
WWW=		https://github.com/rufl/DINX

LICENSE=	MIT
LICENSE_FILE=	${WRKSRC}/LICENSE

BUILD_DEPENDS=	zig>=0.13.0:lang/zig

USES=		zig
USE_ZIG=	yes

do-build:
	@cd ${WRKSRC} && zig build -Doptimize=ReleaseSafe

do-install:
	@mkdir -p ${STAGEDIR}${PREFIX}/bin
	@cp ${WRKSRC}/zig-out/bin/pori ${STAGEDIR}${PREFIX}/bin/

.include <bsd.port.mk>

# FreeBSD Port Makefile for Seafoam Settings (DINX-BSD)
PORTNAME=	seafoam-settings
PORTVERSION=	1.0.0
CATEGORIES=	sysutils x11-wm
MASTER_SITES=	https://github.com/rufl/seafoam-settings/releases/download/v1.0.0/
DISTNAME=	seafoam-settings-1.0.0

MAINTAINER=	trafael@dinx.org
COMMENT=	Seafoam desktop settings and theme manager for DINX-BSD
WWW=		https://github.com/rufl/DINX

LICENSE=	MIT
LICENSE_FILE=	${WRKSRC}/LICENSE

BUILD_DEPENDS=	zig>=0.13.0:lang/zig

USES=		zig
USE_ZIG=	yes

do-build:
	@cd ${WRKSRC} && zig build -Doptimize=ReleaseSafe

do-install:
	@mkdir -p ${STAGEDIR}${PREFIX}/bin
	@cp ${WRKSRC}/zig-out/bin/seafoam-settings ${STAGEDIR}${PREFIX}/bin/

.include <bsd.port.mk>

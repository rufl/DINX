# FreeBSD Port Makefile for Shelly Package Wrapper (DINX-BSD)
PORTNAME=	shelly
PORTVERSION=	3.1.6
CATEGORIES=	sysutils ports-mgmt
MASTER_SITES=	https://github.com/rufl/shelly/releases/download/v3.1.6/
DISTNAME=	shelly-3.1.6

MAINTAINER=	trafael@dinx.org
COMMENT=	Shelly unified package management wrapper for DINX-BSD
WWW=		https://github.com/rufl/DINX

LICENSE=	MIT
LICENSE_FILE=	${WRKSRC}/LICENSE

BUILD_DEPENDS=	zig>=0.13.0:lang/zig
RUN_DEPENDS=	pkg>=0:ports-mgmt/pkg

USES=		zig
USE_ZIG=	yes

do-build:
	@cd ${WRKSRC} && zig build -Doptimize=ReleaseSafe

do-install:
	@mkdir -p ${STAGEDIR}${PREFIX}/bin
	@cp ${WRKSRC}/zig-out/bin/shelly ${STAGEDIR}${PREFIX}/bin/

.include <bsd.port.mk>

# FreeBSD Port Makefile for Zrythm DAW (DINX-BSD)
PORTNAME=	zrythm
PORTVERSION=	1.0.0
CATEGORIES=	audio
MASTER_SITES=	https://www.zrythm.org/releases/
DISTNAME=	zrythm-1.0.0

MAINTAINER=	trafael@dinx.org
COMMENT=	Zrythm digital audio workstation for DINX-BSD
WWW=		https://www.zrythm.org

LICENSE=	AGPLv3+
LICENSE_FILE=	${WRKSRC}/COPYING

BUILD_DEPENDS=	meson>=0.59:devel/meson \
		ninja>=1.10:devel/ninja \
		guile>=3.0:lang/guile \
		pipewire>=0:multimedia/pipewire
RUN_DEPENDS=	pipewire>=0:multimedia/pipewire

USES=		compiler:c++17-lang gnome meson ninja pkgconfig
USE_GNOME=	gtk4 glib20

do-install:
	@mkdir -p ${STAGEDIR}${PREFIX}/bin
	@cp ${WRKSRC}/build/src/zrythm ${STAGEDIR}${PREFIX}/bin/

.include <bsd.port.mk>

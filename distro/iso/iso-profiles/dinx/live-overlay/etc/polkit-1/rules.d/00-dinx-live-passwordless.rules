// The live account is disposable; keep this rule in live-overlay only.
// The session starts directly under dinit, outside an elogind login session.
// Polkit therefore reports both active and local as false for pkexec callers.
// Scope passwordless authorization to the fixed live-user identity instead.
// This covers Calamares and GParted pkexec actions plus Firewalld D-Bus actions.
polkit.addRule(function (action, subject) {
    if (subject.user === "dinx") {
        return polkit.Result.YES;
    }
});

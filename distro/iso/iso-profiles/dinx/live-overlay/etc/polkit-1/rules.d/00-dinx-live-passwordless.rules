// The live account is a disposable session; keep this rule in live-overlay only.
// The live session starts directly under dinit (no display manager), so no
// session is ever marked "active" by elogind; locality and user identity are
// the available guarantees.
polkit.addRule(function (action, subject) {
    if (subject.user === "dinx" && subject.local) {
        return polkit.Result.YES;
    }
});

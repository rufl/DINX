QMainWindow,
QWidget {
    background: #0b0d12;
    color: #d7dde8;
}

QFrame#sidebarApp,
QWidget#sidebarApp {
    background: #0b0d12;
    color: #7f8a9c;
}

QLabel,
QCheckBox,
QRadioButton,
QGroupBox,
QTabWidget,
QTreeWidget,
QListWidget,
QTableWidget {
    color: #d7dde8;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QDateTimeEdit {
    background: #11151d;
    color: #d7dde8;
    border: 1px solid #222a38;
    border-radius: 5px;
    padding: 5px;
    selection-background-color: #263249;
    selection-color: #d7dde8;
}

QComboBox QAbstractItemView,
QListWidget,
QTreeWidget,
QTableWidget {
    background: #11151d;
    alternate-background-color: #151923;
    color: #d7dde8;
    border: 1px solid #222a38;
}

QAbstractItemView::item:selected {
    background: #263249;
    color: #d7dde8;
}

QPushButton {
    background: #263249;
    color: #d7dde8;
    border: 1px solid #222a38;
    border-radius: 5px;
    padding: 7px 14px;
}

QPushButton:hover {
    background: #31415d;
    border-color: #8fb8ff;
}

QPushButton:pressed {
    background: #2859a8;
}

QPushButton:default {
    background: #8fb8ff;
    border-color: #8fb8ff;
    color: #0b0d12;
}

QToolTip {
    background: #11151d;
    color: #d7dde8;
    border: 1px solid #222a38;
}

QProgressBar {
    background: #11151d;
    color: #d7dde8;
    border: 1px solid #222a38;
    border-radius: 4px;
    text-align: center;
}

QProgressBar::chunk {
    background: #8fb8ff;
    border-radius: 3px;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background: #0b0d12;
    border: none;
    margin: 0;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: #7f8a9c;
    border-radius: 4px;
    min-height: 24px;
    min-width: 24px;
}

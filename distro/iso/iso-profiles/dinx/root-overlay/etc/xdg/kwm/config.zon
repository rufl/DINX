.{
    // environment variables
    .env = .{
    },

    // working direction of processes spawned by kwm
    .working_directory = .home,

    // startup commands
    .startup_cmds = .{
    },

    // All windows float by default (Aqueous/Pearl-style stacking desktop).
    // .layout has no .float sub-struct (float takes no config params), so
    // default_layout alone is sufficient.
    .default_layout = .float,

    // key/pointer bindings: DINX desktop conventions
    .bindings = .{
        .repeat_info = .{
            .rate = 50,
            .delay = 300,
        },
        .key = .{
            // Alt+Tab  — cycle focus forward (window switcher)
            .{
                .keysym = "Tab",
                .modifiers = .{ .mod1 = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .focus_iter = .{ .direction = .forward },
                        },
                    },
                },
            },
            // Alt+Shift+Tab — cycle focus backward
            .{
                .keysym = "Tab",
                .modifiers = .{ .mod1 = true, .shift = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .focus_iter = .{ .direction = .reverse },
                        },
                    },
                },
            },
            // Alt+F4 — close focused window
            .{
                .keysym = "F4",
                .modifiers = .{ .mod1 = true },
                .event = .{
                    .click = .{
                        .pressed = .close,
                    },
                },
            },
        },
    },

    // window rules: global float rule catches every window (including those
    // with a null app_id). default_layout = .float already floats everything;
    // this rule makes it explicit and future-proof.
    .window_rules = .{
        .{ .app_id = .{ .str = \"\", .match_null = true }, .floating = true },
    },

    // output rules (empty - inherit upstream)
    .output_rules = .{
    },

    // cursor warp and auto-swallow
    .cursor_warp = .none,
    .auto_swallow = true,
    .remember_floating_geometry = false,
    .disable_wrap_around_for_scroller = false,
    .default_attach_mode = .{
        .tile = .top,
        .grid = .top,
        .monocle = .top,
        .deck = .stack_top,
        .scroller = .below_focused,
        .centered_master = .top,
        .float = .top,
    },
    .default_window_decoration = .ssd,
    .border = .{
        // 1px neutral border: visible enough to show window edges without being
        // intrusive. Rounded-corner apps clip their own corners; the border
        // rectangle stays at 1px and does not follow the app-side radius.
        .width = 1,
        .color = .{
            .focus   = 0x888888ff,
            .unfocus = 0x444444ff,
            .swallowing = 0x666666ff,
        },
    },
}
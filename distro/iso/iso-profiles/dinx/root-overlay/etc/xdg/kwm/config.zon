.{
    // environment variables
    .env = .{
    },

    // working direction of processes spawned by kwm
    .working_directory = .home,

    // startup commands
    .startup_cmds = .{
    },

    // Windows/macOS-style desktop: every managed client is placed in the
    // floating layout and stacked by focus order instead of being tiled.
    .default_layout = .float,

    // key/pointer bindings: DINX desktop conventions
    .bindings = .{
        .repeat_info = .{
            .rate = 50,
            .delay = 300,
        },
        .key = .{
            // Alt+Tab  — cycle focus forward (window switcher)
            .{
                .keysym = "Tab",
                .modifiers = .{ .mod1 = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .focus_iter = .{ .direction = .forward },
                        },
                    },
                },
            },
            // Alt+Shift+Tab — cycle focus backward
            .{
                .keysym = "Tab",
                .modifiers = .{ .mod1 = true, .shift = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .focus_iter = .{ .direction = .reverse },
                        },
                    },
                },
            },
            // Alt+F4 — close focused window
            .{
                .keysym = "F4",
                .modifiers = .{ .mod1 = true },
                .event = .{
                    .click = .{
                        .pressed = .close,
                    },
                },
            },
        },
    },

    // No app_id filter: this rule applies to every managed client, including
    // GTK, Qt, XWayland and clients that report a non-null app_id.
    .window_rules = .{
        .{ .floating = true, .decoration = .csd },
    },

    // output rules (empty - inherit upstream)
    .output_rules = .{
    },

    // cursor warp and auto-swallow
    .cursor_warp = .none,
    .auto_swallow = false,
    .remember_floating_geometry = true,
    .disable_wrap_around_for_scroller = false,
    .default_attach_mode = .{
        .tile = .top,
        .grid = .top,
        .monocle = .top,
        .deck = .stack_top,
        .scroller = .below_focused,
        .centered_master = .top,
        .float = .top,
    },
    .default_window_decoration = .csd,
    // GTK draws the DINX rounded client-side border. KWM has no radius-aware
    // border primitive, so a compositor border would remain square outside it.
    .border = .{
        .width = 0,
        .color = .{
            .focus   = 0x3a4352ff,
            .unfocus = 0x222a38ff,
            .swallowing = 0x2f3743ff,
        },
    },
}
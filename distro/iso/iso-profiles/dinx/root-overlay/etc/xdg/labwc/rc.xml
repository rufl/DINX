<?xml version="1.0"?>
<labwc_config>
  <core>
    <decoration>server</decoration>
    <xwaylandPersistence>yes</xwaylandPersistence>
  </core>
  <theme>
    <cornerRadius>0</cornerRadius>
    <font name="Cantarell" size="11" />
  </theme>
  <desktops number="2" />
  <keyboard>
    <default />
    <keybind key="W-Return">
      <action name="Execute" command="dinx-terminal" />
    </keybind>
    <keybind key="W-l">
      <action name="Execute" command="/usr/local/libexec/dinx-lock" />
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="brightnessctl set 5%-" />
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="brightnessctl set 5%+" />
    </keybind>
  </keyboard>
</labwc_config>

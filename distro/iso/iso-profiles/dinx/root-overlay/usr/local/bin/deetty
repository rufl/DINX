#!/bin/sh
set -eu
export SHELL=/bin/fish
export NOCTTY_DESKTOP_SHELL=/bin/fish
case "${1:-}" in
  --dropdown)
    exec /usr/bin/deetty --native-grid
    ;;
  --windowed)
    exec /usr/bin/deetty --native-grid-windowed
    ;;
  --zen|--zen-fullscreen)
    exec /usr/bin/deetty --native-grid-zen
    ;;
  -h|--help|--version|--package-smoke|--show|--hide|--toggle|--status|--hidden|--native-grid|--native-grid-windowed|--native-grid-zen|--open-workspace|--open-uri)
    exec /usr/bin/deetty "$@"
    ;;
  --new-window)
    shift
    exec /usr/bin/deetty --new-window "$@"
    ;;
  -e|--execute)
    shift
    exec /usr/bin/deetty --new-window --execute "$@"
    ;;
  *)
  # Morghulis launches `$TERMINAL` without arguments; use a toplevel window so
  # KWM/VirtualBox can grant keyboard focus reliably instead of a dropdown layer.
  if [ $# -eq 0 ]; then
      exec /usr/bin/deetty --new-window
  else
      exec /usr/bin/deetty --new-window --execute "$@"
  fi
    ;;
esac

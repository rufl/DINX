#!/bin/sh
set -eu

# TuxManager is a Qt Widgets application; force the DINX dark palette even if
# a user's global Qt preference is light.
export DINX_COLOR_SCHEME=dark
export QT_QPA_PLATFORM='wayland;xcb'
export QT_QPA_PLATFORMTHEME=qt6ct
export QT_STYLE_OVERRIDE=fusion
exec /usr/bin/tux-manager "$@"

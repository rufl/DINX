#!/bin/sh
set -eu

export XDG_CURRENT_DESKTOP=Aqueous
export XDG_SESSION_DESKTOP=Aqueous
export XDG_SESSION_TYPE=wayland

# Aqueous invokes this child after its Wayland socket and XWayland endpoint
# exist. The supervisor owns DINX helpers and Pearl so a failed component
# terminates the alternate session instead of leaving a blank desktop.
exec /usr/local/libexec/dinx-session-supervisor aqueous

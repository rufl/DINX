#!/bin/sh
set -eu


locale_charmap=$(locale charmap 2>/dev/null || true)
case "$locale_charmap" in
  *[Uu][Tt][Ff]-8*|*[Uu][Tt][Ff]8*) ;;
  *)
    unset LC_ALL
    export LC_CTYPE=C.UTF-8
    ;;
esac


export XDG_CURRENT_DESKTOP=Aqueous
export XDG_SESSION_DESKTOP=Aqueous
export TERMINAL="${TERMINAL:-deetty}"
export XDG_SESSION_TYPE=wayland
export QT_QPA_PLATFORM='wayland;xcb'
export GDK_BACKEND='wayland,x11'
export SDL_VIDEODRIVER='wayland,x11'
export CLUTTER_BACKEND=wayland
export MOZ_ENABLE_WAYLAND=1
export _JAVA_AWT_WM_NONREPARENTING=1
export DINX_COLOR_SCHEME="${DINX_COLOR_SCHEME:-dark}"
export DINTOR_THEME="${DINTOR_THEME:-prefer-dark}"
export GTK_CSD=0
# Gecko browsers select client decorations before consulting GTK_CSD.
export MOZ_GTK_TITLEBAR_DECORATION=system
export QT_STYLE_OVERRIDE="${QT_STYLE_OVERRIDE:-fusion}"
export AQUEOUS_MOD="${AQUEOUS_MOD:-Super}"
export AQUEOUS_NESTED=0
if [ -z "${LIBSEAT_BACKEND:-}" ]; then
  if [ -S /run/seatd.sock ] \
    && id -nG 2>/dev/null | tr ' ' '\n' | grep -qx seat; then
    export LIBSEAT_BACKEND=seatd
  else
    export LIBSEAT_BACKEND=logind
  fi
fi
export DINX_DISPLAY_AUTHORITY=shikane
export DINX_SESSION_COMPOSITOR_PID=$$
unset DISPLAY

xdg-user-dirs-update
if [ -n "${HOME:-}" ]; then
  desktop_dir=$(xdg-user-dir DESKTOP)
  installer_seed=/etc/skel/Desktop/Install\ DINX.desktop
  installer_desktop="$desktop_dir/Install DINX.desktop"
  if [ -n "$desktop_dir" ] && [ -r "$installer_seed" ] && [ ! -e "$installer_desktop" ]; then
    installer_tmp="$desktop_dir/.Install DINX.desktop.$$"
    install -Dm755 "$installer_seed" "$installer_tmp"
    mv -n "$installer_tmp" "$installer_desktop"
    rm -f "$installer_tmp"
  fi
fi

compositor=/usr/bin/aqueous
graphics_profile=$(/usr/local/libexec/dinx-graphics-profile)
. /usr/local/libexec/dinx-graphics-environment.sh
dinx_apply_graphics_environment "$graphics_profile"
case "$graphics_profile" in
  cpu|virtual-gl)
    compositor=/usr/bin/aqueous-cpu
    ;;
  hardware|vulkan)
    ;;
  *)
    printf 'dinx-aqueous-pearl: unknown graphics profile: %s\n' "$graphics_profile" >&2
    exit 1
    ;;
esac

if [ "${DINX_LIVE_SESSION:-}" = 1 ] && [ -d /run/dinx-session ]; then
  # Live-only: the private runtime dir is provisioned by dinx-live-autologin
  # and is independent of elogind's /run/user/UID lifecycle, which can vanish
  # mid-boot and kill the compositor's Wayland socket (AddSocketFailed).
  XDG_RUNTIME_DIR=/run/dinx-session
  export XDG_RUNTIME_DIR
elif [ -z "${XDG_RUNTIME_DIR:-}" ]; then
  XDG_RUNTIME_DIR="/run/user/$(id -u)"
  export XDG_RUNTIME_DIR
fi
if [ ! -d "$XDG_RUNTIME_DIR" ]; then
  mkdir -p "$XDG_RUNTIME_DIR"
fi
if [ "$(stat -c '%u' "$XDG_RUNTIME_DIR")" != "$(id -u)" ]; then
  printf 'dinx-aqueous-pearl: XDG_RUNTIME_DIR is not owned by the session user\n' >&2
  exit 1
fi
chmod 0700 "$XDG_RUNTIME_DIR"

# Only one compositor per user. Racing instances contend for Aqueous's
# config-writer lock and can kill the live seat.
lock_path=$XDG_RUNTIME_DIR/dinx-aqueous-pearl.lock
exec 9>"$lock_path"
if ! flock -n 9; then
  printf '%s\n' 'dinx-aqueous-pearl: another compositor instance is running' >&2
  exit 0
fi

config_home=${XDG_CONFIG_HOME:-${HOME:-/nonexistent}/.config}
if [ -n "${HOME:-}" ] && [ ! -e "$config_home/aqueous/wm.toml" ] && [ -r /etc/xdg/aqueous/wm.toml ]; then
  install -Dm644 /etc/xdg/aqueous/wm.toml "$config_home/aqueous/wm.toml"
fi
if [ "${DINX_LIVE_SESSION:-}" = 1 ] && [ -n "${HOME:-}" ] \
  && [ -f "$config_home/aqueous/wm.toml" ] && [ ! -L "$config_home/aqueous/wm.toml" ]; then
  /usr/local/libexec/dinx-seed-aqueous-live-config "$config_home/aqueous/wm.toml" \
    || printf '%s\n' 'dinx-aqueous-pearl: could not apply live-only lock/effects policy' >&2

  data_home=${XDG_DATA_HOME:-$HOME/.local/share}
  applications_dir="$data_home/applications"
  mkdir -p "$applications_dir"
  lock_desktop_override="$applications_dir/dinx-lock.desktop"
  if [ ! -e "$lock_desktop_override" ] && [ ! -L "$lock_desktop_override" ]; then
    lock_desktop_tmp="$applications_dir/.dinx-lock.desktop.$$"
    (umask 022; printf '[Desktop Entry]\nType=Application\nName=Lock screen\nHidden=true\n' > "$lock_desktop_tmp")
    mv -n "$lock_desktop_tmp" "$lock_desktop_override"
    rm -f -- "$lock_desktop_tmp"
  fi
fi
if [ -n "${HOME:-}" ] && [ ! -e "$config_home/aqueous/layout.toml" ] && [ -r /etc/xdg/aqueous/layout.toml ]; then
  install -Dm644 /etc/xdg/aqueous/layout.toml "$config_home/aqueous/layout.toml"
fi
if [ -n "${HOME:-}" ] && [ ! -e "$config_home/qt6ct/qt6ct.conf" ] && [ -r /etc/skel/.config/qt6ct/qt6ct.conf ]; then
  install -Dm644 /etc/skel/.config/qt6ct/qt6ct.conf "$config_home/qt6ct/qt6ct.conf"
fi
if [ -n "${HOME:-}" ]; then
  /usr/local/libexec/dinx-qt6ct-palette-seed \
    "$config_home/qt6ct/colors/DINX.conf" \
    /etc/skel/.config/qt6ct/colors/DINX.conf
fi

if [ -n "${HOME:-}" ] \
  && [ ! -e "$config_home/pearl/preferences.json" ] \
  && [ ! -e "$config_home/pearl/last-good.json" ] \
  && [ -r /etc/skel/.config/pearl/preferences.json ]; then
  install -Dm600 /etc/skel/.config/pearl/preferences.json "$config_home/pearl/preferences.json"
fi

exec "$compositor" -c /usr/local/libexec/dinx-aqueous-init

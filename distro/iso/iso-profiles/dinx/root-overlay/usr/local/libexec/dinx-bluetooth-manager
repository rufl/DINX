#!/bin/sh
set -eu

notice() {
  mode=$1
  english=$2
  portuguese=$3
  case ${LANG:-${LC_MESSAGES:-}} in
    pt_BR*|pt-BR*) zenity "$mode" --title='Bluetooth' --text="$portuguese" --width=440 ;;
    *) zenity "$mode" --title='Bluetooth' --text="$english" --width=440 ;;
  esac
}

if ! command -v bluetoothctl >/dev/null 2>&1; then
  notice --error 'The Bluetooth tools are missing. Install bluez-utils, then try again.' 'As ferramentas Bluetooth estão ausentes. Instale bluez-utils e tente novamente.'
  exit 127
fi
if ! controllers=$(bluetoothctl list 2>&1); then
  notice --error 'Could not query BlueZ. Check that bluetoothd is running in DinitUI.' 'Não foi possível consultar o BlueZ. Verifique se bluetoothd está ativo no DinitUI.'
  exit 1
fi
case "$controllers" in
  *Controller\ *) exec blueman-manager "$@" ;;
esac

notice --info 'No Bluetooth controller is available. In VirtualBox, attach a USB Bluetooth adapter; on hardware, check that the adapter is enabled and bluetoothd is running.' 'Nenhum controlador Bluetooth está disponível. No VirtualBox, conecte um adaptador Bluetooth USB; em hardware, verifique se o adaptador está habilitado e se bluetoothd está ativo.'

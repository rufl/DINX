#!/bin/sh
set -eu

export XDG_CURRENT_DESKTOP=DINX-Gaming
export XDG_SESSION_DESKTOP=dinx-gaming
export SDL_VIDEODRIVER=wayland
export STEAM_RUNTIME=1

mode="${DINX_GAMEMODE:-auto}"
mangohud_mode="${DINX_MANGOHUD:-off}"

case "$mangohud_mode" in
    0|off|false|no)
        ;;
    1|on|true|yes)
        command -v mangohud >/dev/null 2>&1 || {
            printf 'dinx-gaming: DINX_MANGOHUD=%s but mangohud is not installed\n' "$mangohud_mode" >&2
            exit 2
        }
        export MANGOHUD=1
        ;;
    *)
        printf 'dinx-gaming: invalid DINX_MANGOHUD=%s; use on or off\n' "$mangohud_mode" >&2
        exit 2
        ;;
esac

run_gamescope() {
    case "$mode" in
        0|off|false|no)
            gamescope --backend drm --steam --fullscreen -- steam -tenfoot
            ;;
        1|on|true|yes)
            command -v gamemoderun >/dev/null 2>&1 || {
                printf 'dinx-gaming: DINX_GAMEMODE=%s but gamemoderun is not installed\n' "$mode" >&2
                exit 2
            }
            gamemoderun gamescope --backend drm --steam --fullscreen -- steam -tenfoot
            ;;
        auto)
            if command -v gamemoderun >/dev/null 2>&1; then
                gamemoderun gamescope --backend drm --steam --fullscreen -- steam -tenfoot
            else
                gamescope --backend drm --steam --fullscreen -- steam -tenfoot
            fi
            ;;
        *)
            printf 'dinx-gaming: invalid DINX_GAMEMODE=%s; use auto, on, or off\n' "$mode" >&2
            exit 2
            ;;
    esac
}
if [ "${DINX_GAMING_CHILD_MODE:-0}" = 1 ]; then
    run_gamescope
    exit $?
fi

for required in gamescope steam; do
    command -v "$required" >/dev/null 2>&1 || {
        printf 'dinx-gaming: %s is not installed; install the optional DINX gaming packages first\n' "$required" >&2
        exit 127
    }
done

command -v setsid >/dev/null 2>&1 || {
    printf 'dinx-gaming: setsid is required for signal-safe Gamescope cleanup\n' >&2
    exit 127
}


entered=0
if dinitui --gaming-enter >/dev/null 2>&1; then
    entered=1
else
    status=$?
    printf 'dinx-gaming: failed to enter Gaming profile\n' >&2
    if dinitui --gaming-leave >/dev/null 2>&1; then
        :
    else
        restore_status=$?
        printf 'dinx-gaming: failed to restore the previous profile after Gaming entry failed (status %s)\n' "$restore_status" >&2
    fi
    exit "$status"
fi

restore_profile() {
    if [ "$entered" -eq 1 ]; then
        if dinitui --gaming-leave >/dev/null 2>&1; then
            entered=0
            return 0
        else
            restore_status=$?
            printf 'dinx-gaming: failed to restore the previous profile (status %s)\n' "$restore_status" >&2
            return "$restore_status"
        fi
    fi
    return 0
}

stop_gamescope() {
    if [ -n "${game_pid:-}" ]; then
        kill -TERM "-$game_pid" 2>/dev/null || kill -TERM "$game_pid" 2>/dev/null || :
        stop_status=0
        while kill -0 "-$game_pid" 2>/dev/null; do
            if [ "$stop_status" -ge 20 ]; then
                kill -KILL "-$game_pid" 2>/dev/null || kill -KILL "$game_pid" 2>/dev/null || :
                break
            fi
            stop_status=$((stop_status + 1))
            sleep 0.1
        done
        wait "$game_pid" 2>/dev/null || :
        game_pid=
    fi
}

handle_signal() {
    signal_status=$1
    stop_gamescope
    restore_status=0
    restore_profile || restore_status=$?
    trap - EXIT INT TERM
    if [ "$restore_status" -ne 0 ]; then
        exit "$restore_status"
    fi
    exit "$signal_status"
}

game_pid=
trap 'handle_signal 130' INT
trap 'handle_signal 143' TERM
trap 'restore_profile' EXIT
run_status=0
DINX_GAMING_CHILD_MODE=1 setsid "$0" &
game_pid=$!
wait "$game_pid" || run_status=$?
game_pid=
restore_status=0
restore_profile || restore_status=$?
trap - EXIT INT TERM
if [ "$restore_status" -ne 0 ]; then
    exit "$restore_status"
fi
exit "$run_status"

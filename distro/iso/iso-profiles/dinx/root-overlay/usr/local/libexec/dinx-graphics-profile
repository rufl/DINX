#!/bin/sh
# SPDX-FileCopyrightText: © 2026 Seafoam Labs
# SPDX-License-Identifier: GPL-3.0-only
set -eu

drm_root=${1:-/sys/class/drm}
dri_root=${2:-/dev/dri}
has_render_node=false
has_virtual_gl=false
has_vulkan=false
has_software_display=false
has_hardware=false
# Pre-GCN AMD GPUs (Terascale/Evergreen/Northern Islands, e.g. the Radeon HD
# 6310 in an AMD E-350 "Zacate" HP dm1) bind the `radeon` KMS driver and have
# no Vulkan implementation: Mesa's `radeonsi`/`radv` stack requires GCN
# (HD 7000 and newer). Selecting the Vulkan-capable compositor for them makes
# wlroots fall back to `lvp`/llvmpipe, which renders the whole desktop in
# software on the CPU and is unusably slow on such machines. They do have
# working OpenGL through `r600_dri.so`, so they belong on the GLES2 path with
# the Vulkan-effects-free compositor build instead.
has_legacy_gl=false

for render_node in "$dri_root"/renderD*; do
  if [ ! -r "$render_node" ] || [ ! -w "$render_node" ]; then
    continue
  fi
  has_render_node=true

  render_name=${render_node##*/}
  driver_path=$(readlink "$drm_root/$render_name/device/driver" 2>/dev/null) || {
    has_hardware=true
    continue
  }
  driver=${driver_path##*/}
  case "$driver" in
    virtio_gpu)
      has_virtual_gl=true
      ;;
    vmwgfx|vboxvideo)
      has_vulkan=true
      ;;
    qxl|bochs|simpledrm|cirrus)
      has_software_display=true
      ;;
    # The `radeon` KMS driver is the pre-GCN/Terascale signal. Mesa's radv
    # Vulkan driver only binds through `amdgpu`, so any GPU here has OpenGL
    # (r600/r300 DRI) but no Vulkan. Route it to GLES2, never to llvmpipe.
    radeon)
      has_legacy_gl=true
      ;;
    *)
      has_hardware=true
      ;;
  esac
done

if [ "$has_render_node" = false ]; then
  printf '%s\n' vulkan
elif [ "$has_legacy_gl" = true ]; then
  printf '%s\n' legacy-gl
elif [ "$has_hardware" = true ]; then
  printf '%s\n' hardware
elif [ "$has_virtual_gl" = true ]; then
  printf '%s\n' virtual-gl
elif [ "$has_vulkan" = true ]; then
  printf '%s\n' vulkan
elif [ "$has_software_display" = true ]; then
  printf '%s\n' cpu
else
  printf '%s\n' hardware
fi

#!/bin/sh
# SPDX-FileCopyrightText: © 2026 Seafoam Labs
# SPDX-License-Identifier: GPL-3.0-only
set -eu

drm_root=${1:-/sys/class/drm}
dri_root=${2:-/dev/dri}
has_render_node=false

for render_node in "$dri_root"/renderD*; do
  if [ -r "$render_node" ] && [ -w "$render_node" ]; then
    has_render_node=true
    break
  fi
done

if [ "$has_render_node" = false ]; then
  printf '%s\n' cpu
  exit 0
fi

for drm_card in "$drm_root"/card[0-9]*; do
  case "${drm_card##*/}" in
    card[0-9]|card[0-9][0-9]*) ;;
    *) continue ;;
  esac
  driver_path=$(readlink "$drm_card/device/driver" 2>/dev/null) || continue
  driver=${driver_path##*/}
  case "$driver" in
    virtio_gpu|vmwgfx)
      printf '%s\n' virtual-gl
      exit 0
      ;;
    vboxvideo|qxl|bochs|simpledrm|cirrus)
      printf '%s\n' cpu
      exit 0
      ;;
  esac
done

printf '%s\n' hardware

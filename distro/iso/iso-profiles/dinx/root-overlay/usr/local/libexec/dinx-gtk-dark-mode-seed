#!/bin/sh
set -eu

key=/org/gnome/desktop/interface/color-scheme
if ! command -v dconf >/dev/null 2>&1; then
  printf '%s\n' 'dinx-gtk-dark-mode-seed: dconf is unavailable; leaving color scheme unchanged' >&2
  exit 0
fi

if ! current=$(dconf read "$key" 2>/dev/null); then
  printf '%s\n' 'dinx-gtk-dark-mode-seed: cannot read user color scheme; leaving it unchanged' >&2
  exit 0
fi
[ -z "$current" ] || exit 0

dconf write "$key" "'prefer-dark'" >/dev/null 2>&1 || \
  printf '%s\n' 'dinx-gtk-dark-mode-seed: cannot seed prefer-dark; leaving session running' >&2

#!/bin/sh
set -eu

export QT_QPA_PLATFORM=wayland
export XDG_CURRENT_DESKTOP=river
export XDG_SESSION_DESKTOP=river

if command -v xdg-user-dirs-update >/dev/null 2>&1; then
  xdg-user-dirs-update
fi
desktop_dir=$(xdg-user-dir DESKTOP 2>/dev/null || printf '%s/Desktop' "${HOME:-/tmp}")
case "$desktop_dir" in
  /*) mkdir -p -- "$desktop_dir" ;;
  *) desktop_dir=${HOME:-/tmp}/Desktop; mkdir -p -- "$desktop_dir" ;;
esac

# The GTK PCManFM desktop uses the X11 root window, which is not the River
# desktop. Its Qt port uses Wayland layer-shell for icons and the context menu.
# A separate profile preserves the user's file-manager preferences.
profile_dir=${XDG_CONFIG_HOME:-${HOME:-/tmp}/.config}/pcmanfm-qt/dinx
mkdir -p -- "$profile_dir"
if [ ! -e "$profile_dir/settings.conf" ]; then
  umask 077
  cat >"$profile_dir/settings.conf" <<'EOF'
[Behavior]
UseTrash=true

[Desktop]
DesktopShortcuts=Home, Trash
OpenWithDefaultFileManager=true

[Volume]
MountOnStartup=false
MountRemovable=false
AutoRun=false
EOF
fi
exec pcmanfm-qt --desktop --profile=dinx

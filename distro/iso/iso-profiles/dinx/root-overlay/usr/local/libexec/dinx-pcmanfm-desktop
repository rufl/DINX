#!/bin/sh
set -eu

export GDK_BACKEND="${GDK_BACKEND:-wayland,x11}"
export XDG_CURRENT_DESKTOP=river
export XDG_SESSION_DESKTOP=river

if command -v xdg-user-dirs-update >/dev/null 2>&1; then
  xdg-user-dirs-update
fi
desktop_dir=$(xdg-user-dir DESKTOP 2>/dev/null || printf '%s/Desktop' "${HOME:-/tmp}")
case "$desktop_dir" in
  /*) mkdir -p -- "$desktop_dir" ;;
  *) desktop_dir=${HOME:-/tmp}/Desktop; mkdir -p -- "$desktop_dir" ;;
esac

# PCManFM keeps desktop settings per profile. Seed the profile once so the
# main River session always owns the desktop surface, icons and WM context
# menu, while preserving any user changes made later.
config_home=${XDG_CONFIG_HOME:-${HOME:-/tmp}/.config}
profile_dir="$config_home/pcmanfm/dinx"
mkdir -p -- "$profile_dir"
if [ ! -e "$profile_dir/desktop-items-0.conf" ]; then
  umask 077
  cat >"$profile_dir/desktop-items-0.conf" <<'EOF'
[*]
show_desktop=1
show_wm_menu=1
sort_by=name
sort_type=ascending
EOF
fi

exec pcmanfm --desktop --profile=dinx

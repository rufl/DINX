#!/bin/sh
# SPDX-FileCopyrightText: © 2026 Seafoam Labs
# SPDX-License-Identifier: GPL-3.0-only
set -eu

graphics_profile=$(/usr/local/libexec/dinx-graphics-profile)
. /usr/local/libexec/dinx-graphics-environment.sh
dinx_apply_graphics_environment "$graphics_profile"

if [ -z "${LIBSEAT_BACKEND:-}" ]; then
  if [ -S /run/seatd.sock ] \
    && id -nG 2>/dev/null | tr ' ' '\n' | grep -qx seat; then
    export LIBSEAT_BACKEND=seatd
  else
    export LIBSEAT_BACKEND=logind
  fi
fi
export HOME=/var/empty/pearl-greeter
export XDG_CONFIG_HOME=/var/lib/pearl-greeter/.config
export XDG_DATA_HOME=/var/lib/pearl-greeter/.local/share
export XDG_STATE_HOME=/var/lib/pearl-greeter/.local/state
export XDG_CACHE_HOME=/var/cache/pearl-greeter


exec /usr/lib/pearl/pearl-greeter-host "$@"

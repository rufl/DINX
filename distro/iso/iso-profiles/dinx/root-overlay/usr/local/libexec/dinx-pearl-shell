#!/bin/sh
set -eu

config_home=${XDG_CONFIG_HOME:-${HOME:-/nonexistent}/.config}
state_home=${XDG_STATE_HOME:-${HOME:-/nonexistent}/.local/state}
preferences="$config_home/pearl/preferences.json"
state_dir="$state_home/dinx"
complete_marker="$state_dir/pearl-first-run-complete"
wizard=${DINX_FIRST_RUN_WIZARD:-/usr/local/libexec/dinx-first-run-wizard}
theme_sync_helper=${DINX_THEME_SYNC_HELPER:-/usr/local/libexec/dinx-sync-session-theme}

sync_theme() {
    if ! "$theme_sync_helper"; then
        printf '%s\n' 'dinx-pearl-shell: could not synchronize GTK/Qt appearance; starting Pearl anyway' >&2
    fi
}

sync_theme


mark_complete() {
    mkdir -p "$state_dir"
    marker_tmp="$complete_marker.tmp.$$"
    (umask 077; : > "$marker_tmp")
    mv -f "$marker_tmp" "$complete_marker"
}

if [ -e "$complete_marker" ]; then
    exec pearl "$@"
fi

if ! selection=$("$wizard"); then
    printf '%s\n' 'dinx-pearl-shell: first-run wizard failed; starting Pearl with saved preferences' >&2
    exec pearl "$@"
fi

if [ "$selection" = skip ]; then
    mark_complete
    exec pearl "$@"
fi

IFS=' ' read -r dock bar_edge theme extra <<EOF
$selection
EOF
if [ -n "${extra:-}" ]; then
    printf '%s\n' 'dinx-pearl-shell: invalid wizard selection; starting Pearl with saved preferences' >&2
    mark_complete
    exec pearl "$@"
fi

case "$dock" in
    on) dock_enabled=true ;;
    off) dock_enabled=false ;;
    *)
        printf '%s\n' 'dinx-pearl-shell: invalid dock selection; starting Pearl with saved preferences' >&2
        mark_complete
        exec pearl "$@"
        ;;
esac
case "$bar_edge" in
    top) dock_edge=bottom ;;
    bottom) dock_edge=top ;;
    *)
        printf '%s\n' 'dinx-pearl-shell: invalid bar position; starting Pearl with saved preferences' >&2
        mark_complete
        exec pearl "$@"
        ;;
esac
case "$theme" in
    dinx-dark)
        theme_mode=gtk
        theme_variant=dark
        gtk_name=DINX
        ;;
    dinx-light)
        theme_mode=gtk
        theme_variant=light
        gtk_name=DINX
        ;;
    material-dark)
        theme_mode=static
        theme_variant=dark
        gtk_name=
        ;;
    material-light)
        theme_mode=static
        theme_variant=light
        gtk_name=
        ;;
    *)
        printf '%s\n' 'dinx-pearl-shell: invalid theme selection; starting Pearl with saved preferences' >&2
        mark_complete
        exec pearl "$@"
        ;;
esac

if [ ! -r "$preferences" ]; then
    printf '%s\n' 'dinx-pearl-shell: Pearl preferences are unavailable; starting Pearl unchanged' >&2
    exec pearl "$@"
fi

mkdir -p "$config_home/pearl"
preferences_tmp="$preferences.tmp.$$"
if ! jq --arg theme_mode "$theme_mode" \
    --arg theme_variant "$theme_variant" \
    --arg gtk_name "$gtk_name" \
    --arg bar_edge "$bar_edge" \
    --arg dock_edge "$dock_edge" \
    --argjson dock_enabled "$dock_enabled" \
    '.theme = ((.theme // {}) + {mode: $theme_mode, variant: $theme_variant, gtk_name: $gtk_name})
     | .bar = ((.bar // {}) + {edge: $bar_edge})
     | .dock = ((.dock // {}) + {enabled: $dock_enabled, edge: $dock_edge})' \
    "$preferences" > "$preferences_tmp"; then
    rm -f "$preferences_tmp"
    printf '%s\n' 'dinx-pearl-shell: could not update Pearl preferences; starting Pearl unchanged' >&2
    exec pearl "$@"
fi
chmod 600 "$preferences_tmp"
mv -f "$preferences_tmp" "$preferences"
sync_theme
mark_complete
exec pearl "$@"

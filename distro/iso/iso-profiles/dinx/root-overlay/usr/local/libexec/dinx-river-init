#!/bin/sh
set -eu

# Desktop identity belongs to dinx-river-session: Morghulis enables its river
# modules only when XDG_CURRENT_DESKTOP is exactly `river`, so re-exporting a
# composite value here would blank the shell's bar.

# river runs this script as its configuration once its Wayland socket exists.
# kwm implements river-window-management-v1 and must be registered as the
# default layout before any view is mapped, otherwise river has no tiler and
# windows never get placed.
riverctl default-layout kwm

# The supervisor owns kwm and the DINX helpers so that a failed component
# terminates the session instead of leaving a blank desktop.
exec /usr/local/libexec/dinx-session-supervisor river

#!/bin/sh
set -eu

# Morghulis compares XDG_CURRENT_DESKTOP as a literal string (NavBar.vala
# `current_session == "river"`), so it must be exactly `river`; any other value
# makes NavBar skip setup_river() and the shell loses its tag/mode/view modules.
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-river}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-river}"
export XDG_SESSION_TYPE=wayland
export TERMINAL="${TERMINAL:-deetty}"
export QT_QPA_PLATFORM='wayland;xcb'
export GDK_BACKEND='wayland,x11'
export SDL_VIDEODRIVER='wayland,x11'
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORMTHEME=qt6ct
export DINX_COLOR_SCHEME="${DINX_COLOR_SCHEME:-dark}"
export DINTOR_THEME="${DINTOR_THEME:-prefer-dark}"
export MOZ_GTK_TITLEBAR_DECORATION=system
export DINX_DISPLAY_AUTHORITY=shikane

locale_charmap=$(locale charmap 2>/dev/null || true)
case "$locale_charmap" in
  *[Uu][Tt][Ff]-8*|*[Uu][Tt][Ff]8*) ;;
  *) unset LC_ALL; export LC_CTYPE=C.UTF-8 ;;
esac

if [ "${DINX_LIVE_SESSION:-}" = 1 ] && [ -d /run/dinx-session ]; then
  export XDG_RUNTIME_DIR=/run/dinx-session
elif [ -z "${XDG_RUNTIME_DIR:-}" ]; then
  export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi
mkdir -p "$XDG_RUNTIME_DIR"
[ "$(stat -c '%u' "$XDG_RUNTIME_DIR")" = "$(id -u)" ] || exit 1
chmod 0700 "$XDG_RUNTIME_DIR"

xdg-user-dirs-update
if [ -n "${HOME:-}" ]; then
  desktop_dir=$(xdg-user-dir DESKTOP)
  installer_seed=/etc/skel/Desktop/Install\ DINX.desktop
  installer_desktop="$desktop_dir/Install DINX.desktop"
  if [ -n "$desktop_dir" ] && [ -r "$installer_seed" ] && [ ! -e "$installer_desktop" ]; then
    installer_tmp="$desktop_dir/.Install DINX.desktop.$$"
    install -Dm755 "$installer_seed" "$installer_tmp"
    mv -n "$installer_tmp" "$installer_desktop"
    rm -f "$installer_tmp"
  fi
  config_home=${XDG_CONFIG_HOME:-$HOME/.config}
  if [ ! -e "$config_home/qt6ct/qt6ct.conf" ] && [ -r /etc/skel/.config/qt6ct/qt6ct.conf ]; then
    install -Dm644 /etc/skel/.config/qt6ct/qt6ct.conf "$config_home/qt6ct/qt6ct.conf"
  fi
  /usr/local/libexec/dinx-qt6ct-palette-seed \
    "$config_home/qt6ct/colors/DINX.conf" \
    /etc/skel/.config/qt6ct/colors/DINX.conf
fi

graphics_profile=$(/usr/local/libexec/dinx-graphics-profile)
. /usr/local/libexec/dinx-graphics-environment.sh
dinx_apply_graphics_environment "$graphics_profile"
if [ -n "${HOME:-}" ] && [ ! -e "$config_home/kwm/config.zon" ] \
  && [ -r /usr/share/doc/kwm/config.def.zon ]; then
  install -Dm644 /usr/share/doc/kwm/config.def.zon "$config_home/kwm/config.zon"
fi

# NEXT keeps Morghulis as the default shell. If Redbean is installed for
# qualification, migrate only KWM's single stock launcher binding atomically.
if [ -n "${HOME:-}" ] && [ -x /usr/bin/redbean ] \
  && [ -f "$config_home/kwm/config.zon" ]; then
  stock_launcher='.spawn_shell = .{ .cmd = "wmenu-run" }'
  redbean_launcher='.spawn_shell = .{ .cmd = "redbean" }'
  stock_count=$(grep -Fc "$stock_launcher" "$config_home/kwm/config.zon" || true)
  redbean_count=$(grep -Fc "$redbean_launcher" "$config_home/kwm/config.zon" || true)
  if [ "$stock_count" -eq 1 ] && [ "$redbean_count" -eq 0 ]; then
    kwm_config_tmp="$config_home/kwm/.config.zon.redbean.$$"
    if sed "s|$stock_launcher|$redbean_launcher|" \
      "$config_home/kwm/config.zon" >"$kwm_config_tmp"; then
      mv -f -- "$kwm_config_tmp" "$config_home/kwm/config.zon"
    else
      rm -f -- "$kwm_config_tmp"
    fi
  fi
fi

exec river -c /usr/local/libexec/dinx-river-init

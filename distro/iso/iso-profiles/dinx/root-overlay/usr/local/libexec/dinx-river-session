#!/bin/sh
set -eu

state_home=${XDG_STATE_HOME:-${HOME:-/tmp}/.local/state}
state_dir="$state_home/dinx"
umask 077
mkdir -p "$state_dir/logs"
chmod 0700 "$state_dir" "$state_dir/logs"
river_log="$state_dir/logs/river.log"
exec >>"$river_log" 2>&1
chmod 0600 "$river_log"
printf '%s pid=%s event=session-wrapper-started\n' \
  "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$$"

if [ "${DINX_ENABLE_CORE_DUMPS:-0}" = 1 ]; then
  core_dir="$state_dir/cores"
  mkdir -p "$core_dir"
  chmod 0700 "$core_dir"
  if ulimit -c 131072 2>/dev/null; then
    core_pattern=$(cat /proc/sys/kernel/core_pattern 2>/dev/null || printf unknown)
    printf '%s core_dumps=enabled max_bytes=67108864 directory=%s kernel_pattern=%s\n' \
      "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$core_dir" "$core_pattern"
    cd "$core_dir"
  else
    ulimit -c 0 2>/dev/null || true
    printf '%s core_dumps=disabled reason=limit-unavailable\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  fi
else
  ulimit -c 0 2>/dev/null || true
  printf '%s core_dumps=disabled reason=opt-in-required\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
fi
locale_charmap=$(locale charmap 2>/dev/null || true)
case "$locale_charmap" in
  *[Uu][Tt][Ff]-8*|*[Uu][Tt][Ff]8*) ;;
  *)
    unset LC_ALL
    export LC_CTYPE=C.UTF-8
    ;;
esac

# The exact string `river` is load-bearing: Morghulis enables its tag, mode and
# view modules only when XDG_CURRENT_DESKTOP equals `river`.
export XDG_CURRENT_DESKTOP=river
export XDG_SESSION_DESKTOP=river
export XDG_SESSION_TYPE=wayland
export TERMINAL="${TERMINAL:-deetty}"
export QT_QPA_PLATFORM='wayland;xcb'
export GDK_BACKEND='wayland,x11'
# GTK4's default GL/Vulkan renderer duplicates large surfaces in system and
# GPU memory for the shell and dock. Cairo keeps the shell bounded on the
# memory-constrained DINX target; users can opt back into another renderer.
export GSK_RENDERER="${GSK_RENDERER:-cairo}"
# Keep glibc from reserving one large malloc arena per shell thread.
export MALLOC_ARENA_MAX="${MALLOC_ARENA_MAX:-2}"
export SDL_VIDEODRIVER='wayland,x11'
export CLUTTER_BACKEND=wayland
export MOZ_ENABLE_WAYLAND=1
export _JAVA_AWT_WM_NONREPARENTING=1
export QT_QPA_PLATFORMTHEME=qt6ct
# Gecko browsers select client decorations before consulting GTK_CSD.
export MOZ_GTK_TITLEBAR_DECORATION=system
# Ask GTK applications to draw their own themed titlebars. KWM 0.3 provides
# borders through river-window-management but does not render titlebar buttons;
# forcing SSD therefore produces undecorated windows.
export GTK_CSD=1
export GTK_DECORATION_LAYOUT=:minimize,maximize,close

# Dark is the initial default; dinx-sync-session-theme applies the user's
# selected GTK variant and libadwaita color scheme.
export DINX_COLOR_SCHEME=dark
export DINTOR_THEME=prefer-dark
export QT_QPA_PLATFORMTHEME=qt6ct
export QT_STYLE_OVERRIDE=fusion

export DINX_DISPLAY_AUTHORITY=shikane
export DINX_SESSION_COMPOSITOR_PID=$$
unset DISPLAY

if [ -z "${LIBSEAT_BACKEND:-}" ]; then
  if [ -S /run/seatd.sock ] \
    && id -nG 2>/dev/null | tr ' ' '\n' | grep -qx seat; then
    export LIBSEAT_BACKEND=seatd
  else
    export LIBSEAT_BACKEND=logind
  fi
fi

graphics_profile=$(/usr/local/libexec/dinx-graphics-profile)
. /usr/local/libexec/dinx-graphics-environment.sh
dinx_apply_graphics_environment "$graphics_profile"

if [ "${DINX_LIVE_SESSION:-}" = 1 ] && [ -d /run/dinx-session ]; then
  # Live-only: the private runtime dir is provisioned by dinx-live-autologin
  # and is independent of elogind's /run/user/UID lifecycle, which can vanish
  # mid-boot and kill the compositor's Wayland socket.
  XDG_RUNTIME_DIR=/run/dinx-session
  export XDG_RUNTIME_DIR
elif [ -z "${XDG_RUNTIME_DIR:-}" ]; then
  XDG_RUNTIME_DIR="/run/user/$(id -u)"
  export XDG_RUNTIME_DIR
fi
if [ ! -d "$XDG_RUNTIME_DIR" ]; then
  mkdir -p "$XDG_RUNTIME_DIR"
fi
if [ "$(stat -c '%u' "$XDG_RUNTIME_DIR")" != "$(id -u)" ]; then
  printf 'dinx-river-session: XDG_RUNTIME_DIR is not owned by the session user\n' >&2
  exit 1
fi
chmod 0700 "$XDG_RUNTIME_DIR"

# Only one compositor per user; a racing instance would contend for the seat.
lock_path=$XDG_RUNTIME_DIR/dinx-river-session.lock
exec 9>"$lock_path"
if ! flock -n 9; then
  printf '%s\n' 'dinx-river-session: another compositor instance is running' >&2
  exit 0
fi

xdg-user-dirs-update

config_home=${XDG_CONFIG_HOME:-${HOME:-/nonexistent}/.config}

if [ "${DINX_LIVE_SESSION:-}" = "1" ] \
  && [ -n "${HOME:-}" ] \
  && [ -r "/etc/skel/Desktop/Install DINX.desktop" ]; then
  desktop_dir=$(xdg-user-dir DESKTOP)
  case "$desktop_dir" in
    /*)
      mkdir -p -- "$desktop_dir"
      installer_seed="/etc/skel/Desktop/Install DINX.desktop"
      installer_desktop="$desktop_dir/Install DINX.desktop"
      if [ ! -e "$installer_desktop" ]; then
        installer_tmp="$desktop_dir/.Install DINX.desktop.tmp.$$"
        if install -m755 "$installer_seed" "$installer_tmp"; then
          mv -n -- "$installer_tmp" "$installer_desktop"
        fi
        rm -f -- "$installer_tmp"
      fi
      if ! /usr/local/libexec/dinx-approve-desktop-launcher \
        "$installer_desktop" "$installer_seed"; then
        printf '%s\n' 'dinx-river-session: installer shortcut remains unapproved; its content was unsafe to update' >&2
      fi
      ;;
    *)
      printf '%s\n' 'dinx-river-session: skipping installer shortcut because the Desktop path is not absolute' >&2
      ;;
  esac
  # The live session must not offer screen locking: the live account is
  # disposable and a locked seat would be unrecoverable without a reboot.
  data_home=${XDG_DATA_HOME:-$HOME/.local/share}
  applications_dir="$data_home/applications"
  mkdir -p "$applications_dir"
  lock_desktop_override="$applications_dir/dinx-lock.desktop"
  if [ ! -e "$lock_desktop_override" ] && [ ! -L "$lock_desktop_override" ]; then
    lock_desktop_tmp="$applications_dir/.dinx-lock.desktop.$$"
    (umask 022; printf '[Desktop Entry]\nType=Application\nName=Lock screen\nHidden=true\n' > "$lock_desktop_tmp")
    mv -n "$lock_desktop_tmp" "$lock_desktop_override"
    rm -f -- "$lock_desktop_tmp"
  fi
elif [ -n "${HOME:-}" ]; then
  desktop_dir=$(xdg-user-dir DESKTOP)
  case "$desktop_dir" in
    /*) rm -f -- "$desktop_dir/Install DINX.desktop" ;;
  esac
  data_home=${XDG_DATA_HOME:-$HOME/.local/share}
  applications_dir="$data_home/applications"
  mkdir -p "$applications_dir"
  installer_hidden="$applications_dir/dinx-installer.desktop"
  installer_hidden_tmp="$applications_dir/.dinx-installer.desktop.tmp.$$"
  (umask 022; printf '%s\n' \
    '[Desktop Entry]' \
    'Type=Application' \
    'Name=Install DINX' \
    'Name[pt_BR]=Instalar DINX' \
    'Hidden=true' >"$installer_hidden_tmp")
  mv -f -- "$installer_hidden_tmp" "$installer_hidden"
fi

if [ -n "${HOME:-}" ] && [ ! -e "$config_home/qt6ct/qt6ct.conf" ] && [ -r /etc/skel/.config/qt6ct/qt6ct.conf ]; then
  install -Dm644 /etc/skel/.config/qt6ct/qt6ct.conf "$config_home/qt6ct/qt6ct.conf"
fi
if [ -n "${HOME:-}" ]; then
  /usr/local/libexec/dinx-qt6ct-palette-seed \
    "$config_home/qt6ct/colors/DINX.conf" \
    /etc/skel/.config/qt6ct/colors/DINX.conf
fi

# Seed kwm's user config only when absent, so user edits survive reboots.
if [ -n "${HOME:-}" ] && [ ! -e "$config_home/kwm/config.zon" ] \
  && [ -r /etc/xdg/kwm/config.zon ]; then
  install -Dm644 /etc/xdg/kwm/config.zon "$config_home/kwm/config.zon"
fi

exec river -c /usr/local/libexec/dinx-river-init

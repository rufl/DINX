#!/bin/sh
set -eu

[ "$#" -eq 1 ] || {
  printf '%s\n' 'usage: dinx-set-theme dark|light' >&2
  exit 64
}
variant=$1
case "$variant" in
  dark|light) ;;
  *)
    printf 'dinx-set-theme: unsupported variant: %s\n' "$variant" >&2
    exit 64
    ;;
esac

config_home=${XDG_CONFIG_HOME:-${HOME:-/nonexistent}/.config}
appearance_dir=$config_home/dinx
appearance=$appearance_dir/appearance.json
if [ -L "$appearance" ] || { [ -e "$appearance" ] && [ ! -f "$appearance" ]; }; then
  printf 'dinx-set-theme: appearance state is not a regular file: %s\n' "$appearance" >&2
  exit 1
fi
command -v jq >/dev/null 2>&1 || {
  printf '%s\n' 'dinx-set-theme: jq is required' >&2
  exit 1
}
mkdir -p "$appearance_dir"
tmp=$appearance.tmp.$$
trap 'rm -f -- "$tmp"' EXIT HUP INT TERM
if [ -f "$appearance" ]; then
  jq -e 'type == "object"' "$appearance" >/dev/null 2>&1 || {
    printf 'dinx-set-theme: invalid appearance state: %s\n' "$appearance" >&2
    exit 1
  }
  jq --arg variant "$variant" '.variant = $variant' "$appearance" >"$tmp"
  mode=$(stat -c '%a' -- "$appearance" 2>/dev/null || printf '600')
else
  printf '{"version":1,"theme":"DINX","variant":"%s","corners":"rounded"}\n' "$variant" >"$tmp"
  mode=600
fi
chmod "$mode" "$tmp"
mv -f -- "$tmp" "$appearance"
trap - EXIT HUP INT TERM
exec /usr/local/libexec/dinx-sync-session-theme

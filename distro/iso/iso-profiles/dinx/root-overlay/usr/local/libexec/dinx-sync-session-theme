#!/bin/sh
set -eu

# DINX appearance is per-user state: $XDG_CONFIG_HOME/dinx/appearance.json,
# written by the first-run wizard (dinx-first-run) and editable afterwards.
# This helper maps that selection onto every toolkit: the GTK 3/4 user
# settings.ini files, the dconf color-scheme that libadwaita/GTK4 apps read
# (Morghulis binds the very same key), and the qt6ct palette. Missing or
# unreadable state falls back to the DINX dark default so recovery paths and
# fresh accounts stay deterministic.
if [ -n "${XDG_CONFIG_HOME:-}" ]; then
  config_home=$XDG_CONFIG_HOME
elif [ -n "${HOME:-}" ]; then
  config_home="$HOME/.config"
else
  printf '%s\n' 'dinx-sync-session-theme: no config directory is available; leaving toolkit settings unchanged' >&2
  exit 0
fi

appearance=$config_home/dinx/appearance.json
theme_family=DINX
theme_variant=dark
theme_corners=rounded
if command -v jq >/dev/null 2>&1 && [ -r "$appearance" ]; then
  parsed_theme=$(jq -er '.theme | select(. == "DINX" or . == "Skeuos" or . == "Orchis" or . == "Fluent" or . == "Jasper")' "$appearance" 2>/dev/null) || parsed_theme=
  parsed_corners=$(jq -er '.corners | select(. == "rounded" or . == "square")' "$appearance" 2>/dev/null) || parsed_corners=
  parsed_variant=$(jq -er '.variant | select(. == "dark" or . == "light")' "$appearance" 2>/dev/null) || parsed_variant=
  if [ -n "$parsed_theme" ]; then
    theme_family=$parsed_theme
  fi
  if [ -n "$parsed_corners" ]; then
    theme_corners=$parsed_corners
  fi
  if [ -n "$parsed_variant" ]; then
    theme_variant=$parsed_variant
  fi
fi

variant_suffix=Dark
gtk_prefer_dark=1
dconf_value="'prefer-dark'"
if [ "$theme_variant" = light ]; then
  variant_suffix=Light
  gtk_prefer_dark=0
  dconf_value="'prefer-light'"
fi
if [ "$theme_corners" = square ]; then
  square=1
else
  square=0
fi

# DINX is the built-in root-overlay theme and has no rounded/square packaging
# split. The four ported families resolve to exact /usr/share/themes directory
# names shipped by dinx-gtk-themes; note Skeuos appends its corner suffix after
# the variant while the other three brands place it before.
case $theme_family in
  Skeuos)
    if [ "$square" = 1 ]; then
      gtk_theme=Skeuos-Blue-$variant_suffix-Square
    else
      gtk_theme=Skeuos-Blue-$variant_suffix
    fi
    ;;
  Orchis)
    if [ "$square" = 1 ]; then
      gtk_theme=Orchis-Square-$variant_suffix
    else
      gtk_theme=Orchis-$variant_suffix
    fi
    ;;
  Fluent)
    if [ "$square" = 1 ]; then
      gtk_theme=Fluent-Square-$variant_suffix
    else
      gtk_theme=Fluent-$variant_suffix
    fi
    ;;
  Jasper)
    if [ "$square" = 1 ]; then
      gtk_theme=Jasper-Square-$variant_suffix
    else
      gtk_theme=Jasper-$variant_suffix
    fi
    ;;
  *)
    gtk_theme=DINX
    ;;
esac

qt_palette=$config_home/qt6ct/colors/DINX.conf

set_ini_value() {
  ini_file=$1
  ini_section=$2
  ini_key=$3
  ini_value=$4

  if [ -L "$ini_file" ]; then
    printf 'dinx-sync-session-theme: preserving user-managed symlink: %s\n' "$ini_file" >&2
    return 0
  fi
  if [ -e "$ini_file" ] && [ ! -f "$ini_file" ]; then
    printf 'dinx-sync-session-theme: not a regular settings file: %s\n' "$ini_file" >&2
    return 0
  fi
  ini_dir=${ini_file%/*}
  if ! mkdir -p "$ini_dir"; then
    printf 'dinx-sync-session-theme: cannot create settings directory: %s\n' "$ini_dir" >&2
    return 1
  fi
  ini_tmp=$ini_file.tmp.$$
  ini_mode=600
  if [ -f "$ini_file" ]; then
    ini_mode=$(stat -c '%a' -- "$ini_file" 2>/dev/null || printf '600')
    if ! awk -v section="$ini_section" -v key="$ini_key" -v value="$ini_value" '
      function name_of(line, name) {
        name = line
        sub(/^\[/, "", name)
        sub(/\][[:space:]]*$/, "", name)
        return name
      }
      function write_setting() {
        print key "=" value
        written = 1
      }
      /^\[[^]]+\][[:space:]]*$/ {
        if (in_section && !written) write_setting()
        in_section = (name_of($0) == section)
        if (in_section) found_section = 1
        print
        next
      }
      in_section && $0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
        if (!written) write_setting()
        next
      }
      { print }
      END {
        if (in_section && !written) write_setting()
        if (!found_section) {
          if (NR > 0) print ""
          print "[" section "]"
          write_setting()
        }
      }
    ' "$ini_file" >"$ini_tmp"; then
      rm -f -- "$ini_tmp"
      printf 'dinx-sync-session-theme: cannot update settings: %s\n' "$ini_file" >&2
      return 1
    fi
  else
    if ! printf '[%s]\n%s=%s\n' "$ini_section" "$ini_key" "$ini_value" >"$ini_tmp"; then
      rm -f -- "$ini_tmp"
      printf 'dinx-sync-session-theme: cannot create settings: %s\n' "$ini_file" >&2
      return 1
    fi
  fi
  if ! chmod "$ini_mode" "$ini_tmp" || ! mv -f -- "$ini_tmp" "$ini_file"; then
    rm -f -- "$ini_tmp"
    printf 'dinx-sync-session-theme: cannot install settings: %s\n' "$ini_file" >&2
    return 1
  fi
}

color_scheme_key=/org/gnome/desktop/interface/color-scheme
if command -v dconf >/dev/null 2>&1; then
  dconf write "$color_scheme_key" "$dconf_value" >/dev/null 2>&1 || \
    printf 'dinx-sync-session-theme: could not set dconf color-scheme=%s\n' "$dconf_value" >&2
else
  printf '%s\n' 'dinx-sync-session-theme: dconf is unavailable; GTK color preference was not synchronized' >&2
fi

for gtk_version in 3.0 4.0; do
  gtk_settings=$config_home/gtk-$gtk_version/settings.ini
  set_ini_value "$gtk_settings" Settings gtk-theme-name "$gtk_theme" || true
  set_ini_value "$gtk_settings" Settings gtk-application-prefer-dark-theme "$gtk_prefer_dark" || true
done

# Qt only follows the DINX palette when the dark variant is selected; the light
# variant must keep the toolkit palette instead of a dark custom one.
qt_config=$config_home/qt6ct/qt6ct.conf
if [ "$theme_variant" = dark ]; then
  set_ini_value "$qt_config" Appearance color_scheme_path "$qt_palette" || true
  set_ini_value "$qt_config" Appearance custom_palette true || true
else
  set_ini_value "$qt_config" Appearance custom_palette false || true
fi

printf 'dinx-sync-session-theme: family=%s variant=%s corners=%s gtk_theme=%s prefer_dark=%s dconf=%s qt6ct=%s\n' \
  "$theme_family" "$theme_variant" "$theme_corners" "$gtk_theme" "$gtk_prefer_dark" "$dconf_value" "$theme_variant"

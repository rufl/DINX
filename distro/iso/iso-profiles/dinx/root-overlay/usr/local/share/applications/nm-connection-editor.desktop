[Desktop Entry]
Name=Network Connections
Name[pt_BR]=Ajustes de Rede
GenericName=Network Connections
GenericName[pt_BR]=Ajustes de Rede
Comment=Manage and change your network connection settings
Icon=preferences-system-network
Exec=nm-connection-editor
TryExec=nm-connection-editor
Terminal=false
StartupNotify=true
Type=Application
Categories=GNOME;GTK;Settings;X-GNOME-NetworkSettings;X-GNOME-Utilities;
Actions=create;

[Desktop Action create]
Exec=nm-connection-editor --create
Name=New Connection
Name[pt_BR]=Nova conexão

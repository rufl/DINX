pkgname=appmenu-glib-translator
source_env="$startdir/source.env"
[[ -r "$source_env" ]] || { printf 'PKGBUILD: missing %s\n' "$source_env" >&2; exit 1; }
. "$source_env"
: "${APPMENU_VERSION:?missing APPMENU_VERSION}"
: "${APPMENU_SOURCE_URL:?missing APPMENU_SOURCE_URL}"
: "${APPMENU_SOURCE_SHA256:?missing APPMENU_SOURCE_SHA256}"
pkgver="$APPMENU_VERSION"
pkgrel=1
pkgdesc='GLib translator from DBusMenu-exported menus to GMenuModel, required by astal-tray'
arch=('x86_64')
url="$APPMENU_REPOSITORY"
license=('LGPL-3.0-or-later')
depends=('glib2' 'gdk-pixbuf2')
makedepends=('meson' 'vala' 'gobject-introspection' 'glib2-devel')
provides=('appmenu-glib-translator')
source=("vala-panel-appmenu-$pkgver.tar.gz::$APPMENU_SOURCE_URL")
sha256sums=("$APPMENU_SOURCE_SHA256")

build() {
  cd "$srcdir/vala-panel-appmenu-$pkgver/subprojects/$pkgname"
  meson setup build --prefix=/usr --libdir=/usr/lib --buildtype=release
  meson compile -C build
}
package() {
  cd "$srcdir/vala-panel-appmenu-$pkgver/subprojects/$pkgname"
  DESTDIR="$pkgdir" meson install -C build
  install -Dm644 "$srcdir/vala-panel-appmenu-$pkgver/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

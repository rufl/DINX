# Manual source pin: vala-panel-appmenu lives on gitlab.com, which the reviewed
# upstream refresher does not poll (its gitlab provider targets gitlab.gnome.org).
# The 25.04 tag matches the Astal revision Morghulis pins; newer master (26.x)
# relocates the translator headers and breaks astal-tray's includes.
APPMENU_REPOSITORY=https://gitlab.com/vala-panel-project/vala-panel-appmenu
APPMENU_VERSION=25.04
APPMENU_SOURCE_URL=https://gitlab.com/vala-panel-project/vala-panel-appmenu/-/archive/25.04/vala-panel-appmenu-25.04.tar.gz

+static bool ensure_rounded_mask(struct wlr_pixman_buffer *buffer,
+		int width, int height) {
+	if (width <= 0 || height <= 0) {
+		return false;
+	}
+	if (buffer->rounded_mask != NULL &&
+			buffer->rounded_mask_width >= width &&
+			buffer->rounded_mask_height >= height) {
+		return true;
+	}
+
+	int new_width = buffer->rounded_mask_width > width ?
+		buffer->rounded_mask_width : width;
+	int new_height = buffer->rounded_mask_height > height ?
+		buffer->rounded_mask_height : height;
+	if ((size_t)new_width > SIZE_MAX - 3) {
+		return false;
+	}
+	size_t stride = ((size_t)new_width + 3) & ~(size_t)3;
+	if (stride > INT_MAX || (size_t)new_height > SIZE_MAX / stride) {
+		return false;
+	}
+
+	uint8_t *data = calloc((size_t)new_height, stride);
+	if (data == NULL) {
+		return false;
+	}
+	pixman_image_t *image = pixman_image_create_bits(PIXMAN_a8,
+		new_width, new_height, (uint32_t *)data, (int)stride);
+	if (image == NULL) {
+		free(data);
+		return false;
+	}
+
+	if (buffer->rounded_mask != NULL) {
+		pixman_image_unref(buffer->rounded_mask);
+	}
+	free(buffer->rounded_mask_data);
+	buffer->rounded_mask = image;
+	buffer->rounded_mask_data = data;
+	buffer->rounded_mask_stride = (int)stride;
+	buffer->rounded_mask_width = new_width;
+	buffer->rounded_mask_height = new_height;
+	return true;
+}
+
+static bool rounded_rect_span(const struct wlr_fbox *box, double radius,
+		double y, double *left, double *right) {
+	double x2 = box->x + box->width;
+	double y2 = box->y + box->height;
+	if (!(box->width > 0 && box->height > 0) ||
+			y < box->y || y >= y2) {
+		return false;
+	}
+
+	radius = fmin(radius, fmin(box->width, box->height) * 0.5);
+	double inset = 0;
+	if (radius > 0) {
+		double dy;
+		if (y < box->y + radius) {
+			dy = box->y + radius - y;
+		} else if (y >= y2 - radius) {
+			dy = y - (y2 - radius);
+		} else {
+			dy = 0;
+		}
+		if (dy > 0) {
+			inset = radius - sqrt(fmax(0, radius * radius - dy * dy));
+		}
+	}
+	*left = box->x + inset;
+	*right = x2 - inset;
+	return *left < *right;
+}
+
+static bool rounded_ring_sample(const struct wlr_fbox *outer,
+		double outer_radius, const struct wlr_fbox *inner,
+		double inner_radius, bool has_inner, double x, double y) {
+	double left, right;
+	if (!rounded_rect_span(outer, outer_radius, y, &left, &right) ||
+			x < left || x >= right) {
+		return false;
+	}
+	if (has_inner && rounded_rect_span(inner, inner_radius, y, &left, &right) &&
+			x >= left && x < right) {
+		return false;
+	}
+	return true;
+}
+
+static uint8_t rounded_pixel_coverage(const struct wlr_fbox *outer,
+		double outer_radius, const struct wlr_fbox *inner,
+		double inner_radius, bool has_inner, double x, double y,
+		double alpha) {
+	unsigned int covered = 0;
+	for (unsigned int sy = 0; sy < 4; sy++) {
+		double sample_y = y + ((double)sy + 0.5) * 0.25;
+		for (unsigned int sx = 0; sx < 4; sx++) {
+			double sample_x = x + ((double)sx + 0.5) * 0.25;
+			if (rounded_ring_sample(outer, outer_radius, inner,
+					inner_radius, has_inner, sample_x, sample_y)) {
+				covered++;
+			}
+		}
+	}
+	return (uint8_t)lround((double)covered * alpha * (255.0 / 16.0));
+}
+
+static void rounded_mask_set_pixel(struct wlr_pixman_buffer *buffer,
+		const struct wlr_box *destination, int x, int y,
+		const struct wlr_fbox *outer, double outer_radius,
+		const struct wlr_fbox *inner, double inner_radius, bool has_inner,
+		double alpha) {
+	buffer->rounded_mask_data[(size_t)y * buffer->rounded_mask_stride + x] =
+		rounded_pixel_coverage(outer, outer_radius, inner, inner_radius,
+			has_inner, destination->x + x, destination->y + y, alpha);
+}
+
+static void rounded_mask_fill_range(struct wlr_pixman_buffer *buffer,
+		const struct wlr_box *destination, int y, int x_begin, int x_end,
+		const struct wlr_fbox *outer, double outer_radius,
+		const struct wlr_fbox *inner, double inner_radius, bool has_inner,
+		double alpha) {
+	x_begin = x_begin < 0 ? 0 : x_begin;
+	x_end = x_end > destination->width ? destination->width : x_end;
+	for (int x = x_begin; x < x_end; x++) {
+		rounded_mask_set_pixel(buffer, destination, x, y, outer,
+			outer_radius, inner, inner_radius, has_inner, alpha);
+	}
+}
+
+static void rounded_mask_fill_full(struct wlr_pixman_buffer *buffer,
+		const struct wlr_box *destination, int y, int x_begin, int x_end,
+		uint8_t alpha) {
+	x_begin = x_begin < 0 ? 0 : x_begin;
+	x_end = x_end > destination->width ? destination->width : x_end;
+	if (x_begin < x_end) {
+		memset(buffer->rounded_mask_data +
+			(size_t)y * buffer->rounded_mask_stride + x_begin,
+			alpha, (size_t)(x_end - x_begin));
+	}
+}
+
+static void build_rounded_mask(struct wlr_pixman_buffer *buffer,
+		const struct wlr_box *destination, const struct wlr_fbox *outer,
+		double outer_radius, const struct wlr_fbox *inner,
+		double inner_radius, bool has_inner, double alpha) {
+	alpha = fmin(1, fmax(0, alpha));
+	for (int y = 0; y < destination->height; y++) {
+		memset(buffer->rounded_mask_data +
+			(size_t)y * buffer->rounded_mask_stride, 0,
+			(size_t)destination->width);
+	}
+	if (alpha == 0) {
+		return;
+	}
+
+	int first_y = (int)floor(outer->y - destination->y);
+	int end_y = (int)ceil(outer->y + outer->height - destination->y);
+	if (first_y < 0) {
+		first_y = 0;
+	}
+	if (end_y > destination->height) {
+		end_y = destination->height;
+	}
+	uint8_t full_alpha = (uint8_t)lround(alpha * 255.0);
+
+	for (int y = first_y; y < end_y; y++) {
+		double outer_left[4], outer_right[4];
+		unsigned int outer_count = 0;
+		double min_outer_left = INFINITY, max_outer_left = -INFINITY;
+		double min_outer_right = INFINITY, max_outer_right = -INFINITY;
+		for (unsigned int sy = 0; sy < 4; sy++) {
+			double sample_y = destination->y + y + ((double)sy + 0.5) * 0.25;
+			if (!rounded_rect_span(outer, outer_radius, sample_y,
+					&outer_left[sy], &outer_right[sy])) {
+				continue;
+			}
+			outer_count++;
+			min_outer_left = fmin(min_outer_left, outer_left[sy]);
+			max_outer_left = fmax(max_outer_left, outer_left[sy]);
+			min_outer_right = fmin(min_outer_right, outer_right[sy]);
+			max_outer_right = fmax(max_outer_right, outer_right[sy]);
+		}
+		if (outer_count == 0) {
+			continue;
+		}
+
+		bool flat_inner = has_inner;
+		double inner_left = 0, inner_right = 0;
+		for (unsigned int sy = 0; sy < 4 && flat_inner; sy++) {
+			double sample_y = destination->y + y + ((double)sy + 0.5) * 0.25;
+			double span_left, span_right;
+			if (!rounded_rect_span(inner, inner_radius, sample_y,
+					&span_left, &span_right) ||
+					span_left != inner->x ||
+					span_right != inner->x + inner->width) {
+				flat_inner = false;
+				break;
+			}
+			if (sy == 0) {
+				inner_left = span_left;
+				inner_right = span_right;
+			}
+		}
+
+		if (outer_count == 4 && (!has_inner || flat_inner)) {
+			double local_left = max_outer_left - destination->x;
+			double local_right = min_outer_right - destination->x;
+			int full_begin = (int)ceil(local_left);
+			int full_end = (int)floor(local_right);
+			if (!has_inner) {
+				rounded_mask_fill_full(buffer, destination, y, full_begin,
+					full_end, full_alpha);
+			} else {
+				int inner_left_end = (int)floor(inner_left - destination->x);
+				int inner_right_begin = (int)ceil(inner_right - destination->x);
+				rounded_mask_fill_full(buffer, destination, y, full_begin,
+					inner_left_end, full_alpha);
+				rounded_mask_fill_full(buffer, destination, y,
+					inner_right_begin, full_end, full_alpha);
+			}
+
+			int left_begin = (int)floor(min_outer_left - destination->x) - 1;
+			int left_end = (int)ceil(max_outer_left - destination->x) + 1;
+			int right_begin = (int)floor(min_outer_right - destination->x) - 1;
+			int right_end = (int)ceil(max_outer_right - destination->x) + 1;
+			rounded_mask_fill_range(buffer, destination, y, left_begin,
+				left_end, outer, outer_radius, inner, inner_radius,
+				has_inner, alpha);
+			rounded_mask_fill_range(buffer, destination, y, right_begin,
+				right_end, outer, outer_radius, inner, inner_radius,
+				has_inner, alpha);
+			if (flat_inner) {
+				int inner_left_begin = (int)floor(inner_left - destination->x) - 1;
+				int inner_left_end = (int)ceil(inner_left - destination->x) + 1;
+				int inner_right_begin = (int)floor(inner_right - destination->x) - 1;
+				int inner_right_end = (int)ceil(inner_right - destination->x) + 1;
+				rounded_mask_fill_range(buffer, destination, y,
+					inner_left_begin, inner_left_end, outer, outer_radius,
+					inner, inner_radius, true, alpha);
+				rounded_mask_fill_range(buffer, destination, y,
+					inner_right_begin, inner_right_end, outer, outer_radius,
+					inner, inner_radius, true, alpha);
+			}
+		} else {
+			int x_begin = (int)floor(min_outer_left - destination->x) - 1;
+			int x_end = (int)ceil(max_outer_right - destination->x) + 1;
+			rounded_mask_fill_range(buffer, destination, y, x_begin,
+				x_end, outer, outer_radius, inner, inner_radius,
+				has_inner, alpha);
+		}
+	}
+}

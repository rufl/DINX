+}
+
+pub fn decorationDoubleClick(
+    previous_window_key: anytype,
+    current_window_key: @TypeOf(previous_window_key),
+    previous_msec: u32,
+    current_msec: u32,
+    previous_x: f64,
+    previous_y: f64,
+    current_x: f64,
+    current_y: f64,
+) bool {
+    return std.meta.eql(previous_window_key, current_window_key) and
+        withinDoubleClick(previous_msec, current_msec) and
+        stayedClick(current_x, current_y, previous_x, previous_y);
+}
+
+test "decoration double click maximizes only the same window within click bounds" {
+    try std.testing.expect(decorationDoubleClick(7, 7, 10, 410, 12, 24, 16, 20));
+    try std.testing.expect(!decorationDoubleClick(7, 8, 10, 410, 12, 24, 12, 24));
+    try std.testing.expect(!decorationDoubleClick(7, 7, 10, 411, 12, 24, 12, 24));
+    try std.testing.expect(!decorationDoubleClick(7, 7, 10, 410, 12, 24, 16.01, 24));
+    try std.testing.expect(decorationDoubleClick(7, 7, 0xfffffff0, 5, 12, 24, 12, 24));
+}

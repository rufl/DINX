+    try std.testing.expectEqual(@as(?DecorationAction, null), decorationActionAt(800, 600, 800, 18));
+    try std.testing.expectEqual(@as(?DecorationAction, null), decorationActionAt(800, 600, 20, 36));
+    try std.testing.expectEqual(@as(?DecorationAction, null), decorationActionAt(-1, 20, 0, 10));
+    try std.testing.expectEqual(@as(?DecorationAction, null), decorationActionAt(90, 0, 0, 0));
+}

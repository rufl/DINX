+fn handleDecorationAction(cursor: *Cursor, window: *Window, action: pointer_drag.DecorationAction) void {
+    const handle = @as(@TypeOf(server.aqueous.api.focusedWindow().?), @bitCast(window.ref));
+    server.aqueous.handleWindowInteraction(handle);
+    switch (action) {
+        .move => {
+            server.aqueous.drag = server.aqueous.createClientDrag(
+                handle,
+                .{
+                    .seat = @intFromPtr(cursor.seat),
+                    .x = cursor.wlr_cursor.x,
+                    .y = cursor.wlr_cursor.y,
+                },
+                .move_floating,
+                .{},
+                true,
+            );
+        },
+        .minimize => {
+            if (server.aqueous.window_states.get(handle)) |state| state.overrideFullscreen();
+            server.aqueous.api.clearFullscreen(handle);
+            _ = server.aqueous.window_states.minimize(handle) catch |err| {
+                log.err("unable to minimize window from decoration: {}", .{err});
+                return;
+            };
+            server.aqueous.api.requestManageCycle();
+        },
+        .maximize => {
+            _ = server.aqueous.window_states.toggleMaximizedFloating(handle, .{
+                .x = window.box.x,
+                .y = window.box.y,
+                .width = window.box.width,
+                .height = window.box.height,
+            }) orelse return;
+            server.aqueous.api.requestManageCycle();
+        },
+        .close => window.close(),
+    }
+}
+
+fn consumeDecorationPress(
+    cursor: *Cursor,
+    window: *Window,
+    surface: ?*wlr.Surface,
+    time_msec: u32,
+    previous_click: ?DecorationClick,
+) bool {
+    var action = window.decorationActionAt(surface, cursor.wlr_cursor.x, cursor.wlr_cursor.y) orelse return false;
+    if (action == .move) {
+        const double_click = if (previous_click) |previous|
+            pointer_drag.decorationDoubleClick(
+                previous.window.key,
+                window.ref.key,
+                previous.time_msec,
+                time_msec,
+                previous.x,
+                previous.y,
+                cursor.wlr_cursor.x,
+                cursor.wlr_cursor.y,
+            )
+        else
+            false;
+        cursor.last_decoration_click = if (double_click) null else .{
+            .window = window.ref,
+            .time_msec = time_msec,
+            .x = cursor.wlr_cursor.x,
+            .y = cursor.wlr_cursor.y,
+        };
+        if (double_click) action = .maximize;
+    }
+    cursor.handleDecorationAction(window, action);
+    cursor.mode = .ignore;
+    cursor.clearFocus();
+    return true;
+}

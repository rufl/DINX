 pub fn tiledMoveAllowed(kind: PolicyState.Kind, fixed: bool, fullscreen: bool) bool {
diff --git a/compositor/aqueous/wm/state/store.zig b/compositor/aqueous/wm/state/store.zig
--- a/compositor/aqueous/wm/state/store.zig
+++ b/compositor/aqueous/wm/state/store.zig
@@ -100,6 +100,22 @@ pub fn toggleMaximized(store: *Store, handle: types.Handle) ?bool {
     return true;
 }
 
+pub fn toggleMaximizedFloating(store: *Store, handle: types.Handle, geometry: types.Rect) ?bool {
+    const entry = store.resolver(handle) orelse return null;
+    entry.overrideFloating();
+    entry.client_maximize_origin = .none;
+    if (entry.geometry_state == .maximized) {
+        entry.geometry_state = .normal;
+        setFloatingEntry(entry, entry.floating_geometry);
+        entry.overrideStackLayer();
+        entry.stack_layer = .above;
+        return false;
+    }
+    setFloatingEntry(entry, geometry);
+    entry.geometry_state = .maximized;
+    return true;
+}
+

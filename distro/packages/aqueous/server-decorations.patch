+fn drawClippedDecorationRect(
+    rect: *wlr.SceneRect,
+    box: wlr.Box,
+    clip: *const wlr.Box,
+    content_clip: *const wlr.Box,
+    color: *const [4]f32,
+) void {
+    var visible = box;
+    if ((box.width <= 0 or box.height <= 0) or
+        (!clip.empty() and !visible.intersection(&visible, clip)) or
+        (!content_clip.empty() and !visible.intersection(&visible, content_clip)))
+    {
+        rect.node.setEnabled(false);
+        return;
+    }
+    rect.node.setPosition(visible.x, visible.y);
+    rect.setSize(visible.width, visible.height);
+    rect.setColor(color);
+    rect.node.setEnabled(true);
+}

+/// Match the compositor-owned titlebar's three right-aligned controls. Narrow
+/// windows divide their width equally so no control extends beyond the frame.
+pub fn decorationActionAt(width: i32, height: i32, x: f64, y: f64) ?DecorationAction {
+    if (width < 3 or height <= 0 or x < 0 or x >= @as(f64, @floatFromInt(width))) return null;
+    const visible_height = @min(@as(i32, @intCast(titlebar_height)), height);
+    if (y < 0 or y >= @as(f64, @floatFromInt(visible_height))) return null;
+    const button_width: i32 = @min(@as(i32, @intCast(decoration_control_width)), @divTrunc(width, 3));
+    const width_f: f64 = @floatFromInt(width);
+    const button_width_f: f64 = @floatFromInt(button_width);
+    if (x >= width_f - button_width_f) return .close;
+    if (x >= width_f - button_width_f * 2) return .maximize;
+    if (x >= width_f - button_width_f * 3) return .minimize;
+    return .move;
+}

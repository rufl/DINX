+fn pearlCornerRadius() u31 {
+    if (pearl_corner_radius_cache) |radius| return radius;
+    var radius: u31 = fx.corner_radius;
+    if (comptime !build_options.vulkan_effects) return 0;
+    defer pearl_corner_radius_cache = radius;
+    var owned_config_dir: ?[]u8 = null;
+    defer if (owned_config_dir) |dir| util.gpa.free(dir);
+    const config_dir = posix.getenv("XDG_CONFIG_HOME") orelse blk: {
+        const home = posix.getenv("HOME") orelse break :blk "";
+        owned_config_dir = std.fmt.allocPrint(util.gpa, "{s}/.config", .{home}) catch break :blk "";
+        break :blk owned_config_dir.?;
+    };
+    if (config_dir.len > 0) {
+        const path = std.fmt.allocPrint(util.gpa, "{s}/pearl/preferences.json", .{config_dir}) catch return radius;
+        defer util.gpa.free(path);
+        var arena = std.heap.ArenaAllocator.init(util.gpa);
+        defer arena.deinit();
+        const bytes = std.fs.cwd().readFileAlloc(arena.allocator(), path, 65536) catch return radius;
+        const root = std.json.parseFromSliceLeaky(std.json.Value, arena.allocator(), bytes, .{}) catch return radius;
+        if (root == .object) if (root.object.get("window_corner_radius")) |value| {
+            if (value == .integer and value.integer >= 0 and value.integer <= 32) {
+                radius = @intCast(value.integer);
+            }
+        };
+    }
+    pearl_corner_radius_cache = radius;
+    return radius;
+}

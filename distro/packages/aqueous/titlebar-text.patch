+fn drawClippedTitleText(
+    text: *wlr.SceneBuffer,
+    box: wlr.Box,
+    clip: *const wlr.Box,
+    content_clip: *const wlr.Box,
+) void {
+    var visible = box;
+    _ = content_clip;
+    if ((box.width <= 0 or box.height <= 0) or
+        (!clip.empty() and !visible.intersection(&visible, clip)))
+    {
+        text.node.setEnabled(false);
+        return;
+    }
+    text.node.setPosition(visible.x, visible.y);
+    const source: wlr.FBox = .{
+        .x = @floatFromInt(visible.x - box.x),
+        .y = @floatFromInt(visible.y - box.y),
+        .width = @floatFromInt(visible.width),
+        .height = @floatFromInt(visible.height),
+    };
+    text.setSourceBox(&source);
+    text.setDestSize(visible.width, visible.height);
+    text.node.setEnabled(true);
+}
+
+fn updateTitleText(window: *Window, max_width: i32) void {
+    if (!window.title_text_dirty and window.title_text_capacity == max_width) return;
+    window.title_text_dirty = false;
+    window.title_text_capacity = max_width;
+    window.title_text_width = 0;
+    window.border.title_text.setBuffer(null);
+    window.anim_border.title_text.setBuffer(null);
+    if (max_width <= 0) return;
+    const title = window.getTitle() orelse return;
+    const rendered = titlebar_text.render(title, max_width, 20) catch {
+        log.err("unable to render window titlebar text", .{});
+        return;
+    };
+    const text = rendered orelse return;
+    defer text.buffer.drop();
+    window.border.title_text.setBuffer(text.buffer);
+    window.anim_border.title_text.setBuffer(text.buffer);
+    window.title_text_width = text.width;
+}

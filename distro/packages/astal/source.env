# Manual source pin: Aylur/astal publishes ZERO git tags, so it cannot be tracked
# by the release-tag refresher. The commit is frozen to the revision that
# Morghulis v0.14.0 pins in its flake.lock (astal 5baeb660214b). At this rev the
# River backend is plain C (no astal-wl Vala vapi), which is what Morghulis v0.14
# expects; newer astal master refactors river into Vala and breaks the ABI.
ASTAL_REPOSITORY=https://github.com/Aylur/astal
ASTAL_COMMIT=5baeb660214bcafc9ae0b733a1bc84f5fa6078f4
ASTAL_VERSION=0.1.0
ASTAL_SOURCE_URL=https://github.com/Aylur/astal/archive/5baeb660214bcafc9ae0b733a1bc84f5fa6078f4.tar.gz
ASTAL_SOURCE_SHA256=3fd8b398609c8e0141333529e55eb897b1c4d0844c18ebf6fbf4b9b231644926

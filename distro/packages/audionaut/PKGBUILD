pkgname=audionaut
source_env="$startdir/source.env"
[[ -r "$source_env" ]] || { printf 'PKGBUILD: missing %s\n' "$source_env" >&2; exit 1; }
. "$source_env"
: "${AUDIONAUT_VERSION:?missing AUDIONAUT_VERSION}"
: "${AUDIONAUT_SOURCE_URL:?missing AUDIONAUT_SOURCE_URL}"
: "${AUDIONAUT_SOURCE_SHA256:?missing AUDIONAUT_SOURCE_SHA256}"
: "${AUDIONAUT_LICENSE_URL:?missing AUDIONAUT_LICENSE_URL}"
: "${AUDIONAUT_LICENSE_SHA256:?missing AUDIONAUT_LICENSE_SHA256}"
pkgver="$AUDIONAUT_VERSION"
pkgrel=2
pkgdesc='Multitrack audio editor and recorder'
arch=('x86_64')
url='https://github.com/kvoltmer/Audionaut'
license=('GPL3')
depends=('glibc' 'gcc-libs')
options=('!strip')
source=(
  "Audionaut.AppImage::${AUDIONAUT_SOURCE_URL}"
  "LICENSE.md::${AUDIONAUT_LICENSE_URL}"
  'audionaut'
  'audionaut.desktop'
)
sha256sums=(
  "$AUDIONAUT_SOURCE_SHA256"
  "$AUDIONAUT_LICENSE_SHA256"
  'a7da4df2fd04d497ccd60c4c6b0019eabbe1aea22f0961c492e135a866cbfbbb'
  '0c7ef6b7169ff11fbf5629902a5ca0e14d05136ba1187f7ee58a220358a50cfd'
)

package() {
  install -Dm755 "$srcdir/Audionaut.AppImage" \
    "$pkgdir/opt/audionaut/Audionaut.AppImage"
  install -Dm755 "$srcdir/audionaut" "$pkgdir/usr/bin/audionaut"
  install -Dm644 "$srcdir/audionaut.desktop" \
    "$pkgdir/usr/share/applications/audionaut.desktop"
  install -Dm644 "$srcdir/LICENSE.md" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/doc/$pkgname/SOURCE" <<EOF
Audionaut ${pkgver} upstream source and build information:
https://github.com/kvoltmer/Audionaut/tree/v${pkgver}

The DINX package redistributes the upstream x86_64 AppImage without modification.
EOF
}

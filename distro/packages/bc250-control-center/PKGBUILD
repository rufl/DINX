pkgname=bc250-control-center
source_env="$startdir/source.env"
[[ -r "$source_env" ]] || { printf 'PKGBUILD: missing %s\n' "$source_env" >&2; exit 1; }
. "$source_env"
: "${BC250_CONTROL_CENTER_VERSION:?missing version}"
: "${BC250_CONTROL_CENTER_SOURCE_URL:?missing source URL}"
: "${BC250_CONTROL_CENTER_SOURCE_SHA256:?missing source checksum}"
pkgver="$BC250_CONTROL_CENTER_VERSION"
pkgrel=1
pkgdesc='BC-250 monitoring, tuning and recovery control center'
arch=('any')
url='https://github.com/movacx/bc250-control-center'
license=('MIT')
provides=('bc250-control-center')
depends=(
  'bash'
  'python'
  'python-pyqt6'
  'python-psutil'
  'qt6-svg'
  'polkit'
  'jq'
  'diffutils'
  'git'
  'pciutils'
  'kmod'
)
source=("${BC250_CONTROL_CENTER_SOURCE_URL}")
sha256sums=("$BC250_CONTROL_CENTER_SOURCE_SHA256")

package() {
  cd "$srcdir/bc250-control-center-$pkgver"
  bash packaging/scripts/stage-package-root.sh "$pkgdir"

  # DINX uses dinit. The upstream package also stages a systemd user unit and
  # a Cyan systemd drop-in; remove both rather than shipping an inert service.
  rm -rf "$pkgdir/usr/lib/systemd"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

pkgname=blender
source_env="$startdir/source.env"
[[ -r "$source_env" ]] || { printf 'PKGBUILD: missing %s\n' "$source_env" >&2; exit 1; }
. "$source_env"
: "${BLENDER_VERSION:?missing BLENDER_VERSION}"
: "${BLENDER_SOURCE_URL:?missing BLENDER_SOURCE_URL}"
: "${BLENDER_SOURCE_SHA256:?missing BLENDER_SOURCE_SHA256}"
pkgver="$BLENDER_VERSION"
pkgrel=1
epoch=17
# Stripped ~1.8 GB of hard deps from Artix: intel-oneapi*, usd, materialx,
# openvdb, opensubdiv, embree, openimagedenoise.
# Essentials kept: cycles, python, ffmpeg, bullet, openxr, alembic, draco,
# jolt, opencolorio, openimageio, audaspace, freestyle, ik-solvers,
# fluid/ocean/remesh modifiers, meshoptimizer, ktx, nanovdb, potrace,
# pugixml, manifold, quadriflow, rubberband.
pkgdesc="A fully integrated 3D graphics creation suite (lean build — 3D modeling + gamedev only)"
arch=(x86_64)
url="https://www.blender.org/"
license=(GPL-3.0-or-later)
depends=(
  alembic
  boost-libs
  bullet
  bzip2
  ceres-solver
  draco
  fftw
  fontconfig
  freetype2
  fribidi
  gmp
  harfbuzz
  libdecor
  libgl
  libharu
  libpng
  libwebp
  libxml2
  libx11
  libxi
  libxrandr
  llvm-libs
  lzo
  ncurses
  openal
  openshadinglanguage
  opengl-driver
  openimageio
  openjpeg2
  openxr
  potrace
  pugixml
  python
  python-numpy
  rubberband
  sdl2
  speexdsp
  tbb
  wayland
  xxd
  zlib
  zstd
)
makedepends=(
  boost
  cmake
  cython
  fmt
  git
  hip-runtime-amd
  libxcursor
  llvm
  ninja
  openexr
  patch
  pkgconf
  python-numpy
  wayland-protocols
)
optdepends=(
  'cuda: Cycles renderer CUDA support'
  'intel-compute-runtime: Cycles renderer Intel oneAPI support'
  'intel-level-zero-raytracing-support: Cycles renderer Intel oneAPI RT support'
  'hiprt: Ray tracing AMD ROCm support'
  'openexr: OpenEXR image format support'
)
source=("${pkgname}-${pkgver}.tar.xz::${BLENDER_SOURCE_URL}")
sha256sums=("${BLENDER_SOURCE_SHA256}")

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DWITH_INSTALL_PORTABLE=OFF \
    -DWITH_PYTHON_INSTALL=ON \
    -DPYTHON_VERSION=3.14 \
    -DWITH_PYTHON_INSTALL_NUMPY=ON \
    -DWITH_CYCLES=ON \
    -DWITH_CYCLES_OSL=ON \
    -DWITH_CYCLES_PATH_GUIDING=ON \
    -DWITH_CYCLES_DEVICE_CUDA=ON \
    -DWITH_CYCLES_DEVICE_OPTIX=ON \
    -DWITH_CYCLES_DEVICE_HIP=ON \
    -DWITH_CYCLES_DEVICE_ONEAPI=OFF \
    -DWITH_CYCLES_EMBREE=OFF \
    -DWITH_CYCLES_NANOVDB=OFF \
    -DWITH_MOD_FLUID=ON \
    -DWITH_MOD_OCEAN=ON \
    -DWITH_MOD_REMESH=ON \
    -DWITH_INPUT_NDOF=ON \
    -DWITH_SYSTEM_GLEW=ON \
    -DWITH_SYSTEM_OPENJPEG=ON \
    -DWITH_ALEMBIC=ON \
    -DWITH_DRACO=ON \
    -DWITH_JOLT=OFF \
    -DWITH_OPENCOLORIO=ON \
    -DWITH_OPENIMAGEDENOISE=OFF \
    -DWITH_OPENSUBDIV=OFF \
    -DWITH_OPENVDB=OFF \
    -DWITH_USD=OFF \
    -DWITH_MATERIALX=OFF \
    -DWITH_EMBREE=OFF \
    -DWITH_HYDRA=OFF \
    -DWITH_POTRACE=ON \
    -DWITH_PUGIXML=ON \
    -DWITH_MANIFOLD=ON \
    -DWITH_QUADRIFLOW=OFF \
    -DWITH_RUBBERBAND=ON \
    -DWITH_FREESTYLE=ON \
    -DWITH_IK_ITASC=ON \
    -DWITH_IK_SOLVER=ON \
    -DWITH_MESH_OPTIMIZER=ON \
    -DWITH_KTX=OFF \
    -DWITH_NANOVDB=OFF \
    -DWITH_FFTW3=ON \
    -DWITH_OPENAL=ON \
    -DWITH_AUDASPACE=OFF \
    -DWITH_GMP=ON \
    -DWITH_HARU=ON \
    -DWITH_SDL=ON \
    -DWITH_XR_OPENXR=ON

  cmake --build build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  DESTDIR="${pkgdir}" cmake --install build
}

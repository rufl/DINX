# Lean build scope: modeling, rigging, texturing and animation. The generated
# blender-full package carries Blender's complete upstream feature set.
# Heavy integrations omitted here include XR, USD, MaterialX, OpenVDB, OpenSubdiv,
# Embree, OpenImageDenoise, oneAPI/SYCL, Cycles OSL, Grease Pencil and Haru.
BLENDER_VERSION=5.3.0
BLENDER_SOURCE_URL=https://download.blender.org/source/blender-${BLENDER_VERSION}.tar.xz

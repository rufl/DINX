pkgname=blockbench
source_env="$startdir/source.env"
[[ -r "$source_env" ]] || { printf 'PKGBUILD: missing %s\n' "$source_env" >&2; exit 1; }
. "$source_env"
: "${BLOCKBENCH_VERSION:?missing BLOCKBENCH_VERSION}"
: "${BLOCKBENCH_SOURCE_URL:?missing BLOCKBENCH_SOURCE_URL}"
: "${BLOCKBENCH_SOURCE_SHA256:?missing BLOCKBENCH_SOURCE_SHA256}"
: "${BLOCKBENCH_LICENSE_URL:?missing BLOCKBENCH_LICENSE_URL}"
: "${BLOCKBENCH_LICENSE_SHA256:?missing BLOCKBENCH_LICENSE_SHA256}"
pkgver="$BLOCKBENCH_VERSION"
pkgrel=2
pkgdesc='Low-poly 3D model editor for game assets'
arch=('x86_64')
url='https://www.blockbench.net/'
license=('GPL-3.0-only')
depends=('glibc' 'gtk3' 'nss' 'libxss' 'libxtst')
options=('!strip')
source=(
  "Blockbench_${pkgver}.AppImage::${BLOCKBENCH_SOURCE_URL}"
  "LICENSE.MD::${BLOCKBENCH_LICENSE_URL}"
  'blockbench'
  'blockbench.desktop'
)
sha256sums=(
  "$BLOCKBENCH_SOURCE_SHA256"
  "$BLOCKBENCH_LICENSE_SHA256"
  'bfb5a343153115bc6365b97bd03b84ffb12815e7a095f0081ef2791ad5707c16'
  '92558cc3bdc01d8e64ad6a22d7a1c0d1214f05178951ab5b6c6c00e7bd2bd8da'
)

package() {
  bash "$startdir/../../../scripts/lib/repack-appimage.sh" \
    "$srcdir/Blockbench_${pkgver}.AppImage" "$pkgdir/opt/blockbench" --trim-locales
  install -Dm755 "$srcdir/blockbench" "$pkgdir/usr/bin/blockbench"
  install -Dm644 "$srcdir/blockbench.desktop" \
    "$pkgdir/usr/share/applications/blockbench.desktop"
  install -Dm644 "$srcdir/LICENSE.MD" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.MD"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/doc/$pkgname/SOURCE" <<EOF
Blockbench ${pkgver} upstream source and build information:
https://github.com/JannisX11/Blockbench/tree/v${pkgver}

The DINX package repacks the upstream x86_64 AppImage as a pre-extracted tree
(Electron locales trimmed to en/pt; binaries left unstripped) so launches
never extract into tmpfs.
EOF
}

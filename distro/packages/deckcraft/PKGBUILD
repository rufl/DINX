pkgname=deckcraft
source_env="$startdir/source.env"
[[ -r "$source_env" ]] || { printf 'PKGBUILD: missing %s\n' "$source_env" >&2; exit 1; }
. "$source_env"
: "${DECKCRAFT_VERSION:?missing DECKCRAFT_VERSION}"
: "${DECKCRAFT_SOURCE_URL:?missing DECKCRAFT_SOURCE_URL}"
: "${DECKCRAFT_SOURCE_SHA256:?missing DECKCRAFT_SOURCE_SHA256}"
pkgver="${DECKCRAFT_VERSION}"
pkgrel=1
pkgdesc="Presentations and slide shows in pure Rust"
arch=('x86_64')
url='https://github.com/storytold/deckcraft'
license=('MIT' 'Apache-2.0')
depends=('glibc' 'gcc-libs')
options=('!strip')
source=(
  "deckcraft-${pkgver}-x86_64.AppImage::${DECKCRAFT_SOURCE_URL}"
  'deckcraft'
  'deckcraft.desktop'
)
sha256sums=(
  "${DECKCRAFT_SOURCE_SHA256}"
  '5ed65453f84f06744908b740657b82704072096844faacd4cb512b55448b5fcb'
  'e865584d4c1bec362a8a655102e8e45029f8040209ac000d0ee42b8deaf7319d'
)

package() {
  install -Dm755 "$srcdir/deckcraft-${pkgver}-x86_64.AppImage" \
    "$pkgdir/opt/deckcraft/deckcraft.AppImage"
  install -Dm755 "$srcdir/deckcraft" "$pkgdir/usr/bin/deckcraft"
  install -Dm644 "$srcdir/deckcraft.desktop" \
    "$pkgdir/usr/share/applications/deckcraft.desktop"
}

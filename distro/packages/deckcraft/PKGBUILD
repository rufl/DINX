pkgname=deckcraft
source_env="$startdir/source.env"
[[ -r "$source_env" ]] || { printf 'PKGBUILD: missing %s\n' "$source_env" >&2; exit 1; }
. "$source_env"
: "${DECKCRAFT_VERSION:?missing DECKCRAFT_VERSION}"
: "${DECKCRAFT_SOURCE_URL:?missing DECKCRAFT_SOURCE_URL}"
: "${DECKCRAFT_SOURCE_SHA256:?missing DECKCRAFT_SOURCE_SHA256}"
: "${DECKCRAFT_LICENSE_MIT_URL:?missing DECKCRAFT_LICENSE_MIT_URL}"
: "${DECKCRAFT_LICENSE_MIT_SHA256:?missing DECKCRAFT_LICENSE_MIT_SHA256}"
: "${DECKCRAFT_LICENSE_APACHE_URL:?missing DECKCRAFT_LICENSE_APACHE_URL}"
: "${DECKCRAFT_LICENSE_APACHE_SHA256:?missing DECKCRAFT_LICENSE_APACHE_SHA256}"
: "${DECKCRAFT_ICON_URL:?missing DECKCRAFT_ICON_URL}"
: "${DECKCRAFT_ICON_SHA256:?missing DECKCRAFT_ICON_SHA256}"
pkgver="${DECKCRAFT_VERSION}"
pkgrel=1
pkgdesc="Presentations and slide shows in pure Rust"
arch=('x86_64')
url='https://github.com/storytold/deckcraft'
license=('MIT' 'Apache-2.0')
depends=('glibc' 'gcc-libs')
options=('!strip')
source=(
  "deckcraft-${pkgver}-x86_64.AppImage::${DECKCRAFT_SOURCE_URL}"
  "LICENSE-MIT::${DECKCRAFT_LICENSE_MIT_URL}"
  "LICENSE-APACHE::${DECKCRAFT_LICENSE_APACHE_URL}"
  "deckcraft-256.png::${DECKCRAFT_ICON_URL}"
  'deckcraft'
  'deckcraft.desktop'
)
sha256sums=(
  "${DECKCRAFT_SOURCE_SHA256}"
  "${DECKCRAFT_LICENSE_MIT_SHA256}"
  "${DECKCRAFT_LICENSE_APACHE_SHA256}"
  "${DECKCRAFT_ICON_SHA256}"
  '5ed65453f84f06744908b740657b82704072096844faacd4cb512b55448b5fcb'
  'e865584d4c1bec362a8a655102e8e45029f8040209ac000d0ee42b8deaf7319d'
)

package() {
  install -Dm755 "$srcdir/deckcraft-${pkgver}-x86_64.AppImage" \
    "$pkgdir/opt/deckcraft/deckcraft.AppImage"
  install -Dm755 "$srcdir/deckcraft" "$pkgdir/usr/bin/deckcraft"
  install -Dm644 "$srcdir/deckcraft.desktop" \
    "$pkgdir/usr/share/applications/deckcraft.desktop"
  install -Dm644 "$srcdir/LICENSE-MIT" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 "$srcdir/LICENSE-APACHE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
  install -Dm644 "$srcdir/deckcraft-256.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/deckcraft.png"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/doc/$pkgname/SOURCE" <<EOF
DeckCraft ${pkgver} upstream source and build information:
https://github.com/storytold/deckcraft/tree/v${pkgver}

The DINX package redistributes the upstream x86_64 AppImage without modification.
EOF
}

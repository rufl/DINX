pkgname=dinx-dock
pkgver=0.3.0
pkgrel=4
pkgdesc='DINX Wayland dock for River, KWM and Morghulis'
arch=(x86_64)
url='https://github.com/rufl/DINX'
license=(Apache-2.0)
# gtk4 carries the UI and gio the desktop-entry resolution, gtk4-layer-shell
# anchors the strip so kwm and river reserve its space, and the icon theme is
# what makes the favorite buttons more than letters. Consumers: the session
# supervisor starts dinx-dock after Morghulis, dinx-first-run writes the
# placement it reads and signals it with SIGHUP.
depends=(gtk4 gtk4-layer-shell hicolor-icon-theme jq)
makedepends=('zig>=0.17')
source=()
sha256sums=()

build() {
  cd "$startdir"
  rm -rf "$srcdir/stage"
  local -a zig_target_flags=(-Dcpu=baseline)
  zig build "${zig_target_flags[@]}" -Doptimize=ReleaseSafe --prefix "$srcdir/stage"
}

check() {
  cd "$startdir"
  zig test src/kwm_ipc.zig
}

package() {
  cd "$startdir"
  install -Dm755 "$srcdir/stage/bin/dinx-dock" "$pkgdir/usr/bin/dinx-dock"
  install -Dm755 dinx-dockctl "$pkgdir/usr/bin/dinx-dockctl"
  install -Dm644 resources/dinx-dock.desktop "$pkgdir/usr/share/applications/dinx-dock.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/dinx-dock/README.md"
  install -Dm644 "$startdir/../../../LICENSE" "$pkgdir/usr/share/licenses/dinx-dock/LICENSE"
}

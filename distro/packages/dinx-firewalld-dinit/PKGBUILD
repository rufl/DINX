pkgname=dinx-firewalld-dinit
pkgver=0.1.0
pkgrel=1
pkgdesc='DINX boot enablement for Firewalld on Dinit'
arch=('any')
url='https://github.com/rufl/DINX'
license=('Apache-2.0')
depends=('dinit' 'firewalld-dinit')
source=()
sha256sums=()

package() {
  install -d "$pkgdir/etc/dinit.d/boot.d"
  ln -s /etc/dinit.d/firewalld "$pkgdir/etc/dinit.d/boot.d/firewalld"
}

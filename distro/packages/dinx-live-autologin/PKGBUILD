pkgname=dinx-live-autologin
pkgver=0.1.0
pkgrel=9
pkgdesc='DINX live-session autologin and overlay boot dinit configuration'
arch=('any')
url='https://github.com/rufl/DINX'
license=('Apache-2.0')
depends=('dinit' 'greetd')
source=('dinx-live-autologin' 'dinx-live-autologin.service' 'root-ro' 'early-root-rw.target')
sha256sums=('141c0434f16a9026c957d30343d8d1480ddad60ec99c6f81de2e22ec3ae18c35' '00f167fd24a03bdf3bfc57a088f6188c2b02a64a7046efac1495aee4b7bed1ad' '4630703466183f02395a93fbfc56845f8d443f21ce3a0eac9a85280bf077ac00' 'd6984b967ccc73b1736eaf9325429e19ea3f5a72cfb337d5ab7956eae3d6fa9d')

package() {
  install -Dm755 "$srcdir/dinx-live-autologin" \
    "$pkgdir/usr/local/libexec/dinx-live-autologin"
  install -Dm644 "$srcdir/dinx-live-autologin.service" \
    "$pkgdir/etc/dinit.d/dinx-live-autologin"
  install -Dm644 "$srcdir/root-ro" "$pkgdir/etc/dinit.d/root-ro"
  install -Dm644 "$srcdir/early-root-rw.target" \
    "$pkgdir/etc/dinit.d/early-root-rw.target"
  install -d "$pkgdir/etc/dinit.d/boot.d"
  ln -s ../dinx-live-autologin \
    "$pkgdir/etc/dinit.d/boot.d/dinx-live-autologin"
}

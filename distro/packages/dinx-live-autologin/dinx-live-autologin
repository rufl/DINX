#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
set -eu
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

live_conf=/etc/artools/live.conf
printf '%s\n' 'dinxlive' > /etc/hostname
hostname dinxlive

# The live session runs without a display manager; its runtime dir is
# provisioned here so it never depends on elogind's /run/user/UID lifecycle.
install -d -o dinx -g dinx -m 0700 /run/dinx-session

if [ ! -r "$live_conf" ] || ! grep -Eq '^[[:space:]]*AUTOLOGIN=true([[:space:]]*)$' "$live_conf"; then
  exit 0
fi

if getent group render >/dev/null 2>&1 && getent passwd dinx >/dev/null 2>&1; then
  if ! usermod --append --groups render dinx; then
    printf '%s\n' 'dinx-live-autologin: render access unavailable; session will use CPU graphics' >&2
  fi
else
  printf '%s\n' 'dinx-live-autologin: render group or live user unavailable; session will use CPU graphics' >&2
fi

if getent group seat >/dev/null 2>&1 && getent passwd dinx >/dev/null 2>&1; then
  if ! getent group seat | grep -Eq '(^|:|,)dinx(,|$)'; then
    group_tmp=$(mktemp /etc/group.dinx-seat.XXXXXX)
    awk -F: '
      BEGIN { OFS = ":" }
      $1 == "seat" && $4 !~ "(^|,)dinx(,|$)" {
        $4 = ($4 == "" ? "dinx" : $4 ",dinx")
      }
      { print }
    ' /etc/group > "$group_tmp"
    chmod 0644 "$group_tmp"
    mv -f "$group_tmp" /etc/group
  fi
  printf 'dinx-live-autologin: %s\n' "$(getent group seat)" >&2
  # The session wrapper selects the seatd backend only when /run/seatd.sock
  # already exists at exec time. The session service and seatd are sibling
  # dependencies, so without this wait the first live session races seatd
  # startup and can fall back to the elogind backend, which never marks the
  # session active under dinit.
  seatd_wait=0
  while [ ! -S /run/seatd.sock ] && [ "$seatd_wait" -lt 50 ]; do
    sleep 0.1
    seatd_wait=$((seatd_wait + 1))
  done
  if [ ! -S /run/seatd.sock ]; then
    printf '%s\n' 'dinx-live-autologin: seatd socket did not appear; session will use logind' >&2
  fi
else
  printf '%s\n' 'dinx-live-autologin: seat group or live user unavailable; compositor falls back to logind' >&2
fi

#!/bin/sh
set -eu
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

live_conf=/etc/artools/live.conf
printf '%s\n' 'dinxlive' > /etc/hostname
hostname dinxlive
install -d -o pearl-greeter -g pearl-greeter -m 0700 \
  /var/lib/pearl-greeter \
  /var/lib/pearl-greeter/.config \
  /var/lib/pearl-greeter/.local \
  /var/lib/pearl-greeter/.local/share \
  /var/lib/pearl-greeter/.local/state \
  /var/cache/pearl-greeter

config=/etc/greetd/config.toml
if [ ! -r "$live_conf" ] || ! grep -Eq '^[[:space:]]*AUTOLOGIN=true([[:space:]]*)$' "$live_conf"; then
  exit 0
fi


if getent group render >/dev/null 2>&1 && getent passwd dinx >/dev/null 2>&1; then
  if ! usermod --append --groups render dinx; then
    printf '%s\n' 'dinx-live-autologin: render access unavailable; session will use CPU graphics' >&2
  fi
else
  printf '%s\n' 'dinx-live-autologin: render group or live user unavailable; session will use CPU graphics' >&2
fi

for seat_user in dinx pearl-greeter; do
  if getent group seat >/dev/null 2>&1 && getent passwd "$seat_user" >/dev/null 2>&1; then
    if ! usermod --append --groups seat "$seat_user"; then
      printf 'dinx-live-autologin: seat access unavailable for %s; compositor falls back to logind\n' "$seat_user" >&2
    fi
  else
    printf 'dinx-live-autologin: seat group or %s user unavailable; compositor falls back to logind\n' "$seat_user" >&2
  fi
done

if [ ! -r "$config" ]; then
  printf '%s\n' 'dinx-live-autologin: greetd configuration is missing' >&2
  exit 1
fi

tmp=$(mktemp "${config}.dinx-live.XXXXXX")
cleanup() {
  rm -f "$tmp"
}
trap cleanup EXIT INT TERM

cat > "$tmp" <<'EOF'
[terminal]
vt = 7

[general]
source_profile = false

[default_session]
command = "/usr/local/libexec/dinx-pearl-greeter-host"
user = "pearl-greeter"

[initial_session]
command = "env DINX_LIVE_SESSION=1 dbus-run-session /usr/local/libexec/dinx-aqueous-pearl"
user = "dinx"
EOF

chmod 0644 "$tmp"
mv -f "$tmp" "$config"
trap - EXIT INT TERM

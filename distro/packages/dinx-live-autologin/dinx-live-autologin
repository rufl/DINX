#!/bin/sh
set -eu

live_conf=/etc/artools/live.conf
config=/etc/greetd/config.toml

if [ ! -r "$live_conf" ] || ! grep -Eq '^[[:space:]]*AUTOLOGIN=true([[:space:]]*)$' "$live_conf"; then
  exit 0
fi

if getent group render >/dev/null 2>&1 && getent passwd dinx >/dev/null 2>&1; then
  if ! usermod --append --groups render dinx; then
    printf '%s\n' 'dinx-live-autologin: render access unavailable; session will use CPU graphics' >&2
  fi
else
  printf '%s\n' 'dinx-live-autologin: render group or live user unavailable; session will use CPU graphics' >&2
fi

if [ ! -r "$config" ]; then
  printf '%s\n' 'dinx-live-autologin: greetd configuration is missing' >&2
  exit 1
fi

tmp=$(mktemp "${config}.dinx-live.XXXXXX")
cleanup() {
  rm -f "$tmp"
}
trap cleanup EXIT INT TERM

cat > "$tmp" <<'EOF'
[terminal]
vt = 1

[general]
source_profile = false

[default_session]
command = "/usr/lib/pearl/pearl-greeter-host"
user = "pearl-greeter"

[initial_session]
command = "dbus-run-session /usr/local/libexec/dinx-aqueous-pearl"
user = "dinx"
EOF

chmod 0644 "$tmp"
mv -f "$tmp" "$config"
trap - EXIT INT TERM

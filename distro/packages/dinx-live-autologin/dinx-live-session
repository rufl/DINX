#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
set -eu

# Launch the live River/KWM session as the live user on dedicated VT 7.
# openvt creates and activates the controlling terminal River needs; runuser
# performs the PAM session setup. greetd stays installed-only.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

/usr/local/libexec/dinx-live-autologin
/usr/local/libexec/dinx-plymouth-quit || true
exec /usr/bin/openvt -c 7 -s -f -e -- runuser -u dinx -- env \
  HOME=/home/dinx \
  USER=dinx \
  LOGNAME=dinx \
  DINX_LIVE_SESSION=1 \
  XDG_RUNTIME_DIR=/run/dinx-session \
  /usr/bin/dbus-run-session /usr/local/libexec/dinx-river-session

pkgname=dinx-noto-latin
source_env="$startdir/source.env"
[[ -r "$source_env" ]] || { printf 'PKGBUILD: missing %s\n' "$source_env" >&2; exit 1; }
. "$source_env"
: "${DINX_NOTO_VERSION:?missing DINX_NOTO_VERSION}"
: "${DINX_NOTO_REGULAR_SOURCE_URL:?missing regular Noto Sans URL}"
: "${DINX_NOTO_REGULAR_SOURCE_SHA256:?missing regular Noto Sans checksum}"
: "${DINX_NOTO_BOLD_SOURCE_URL:?missing bold Noto Sans URL}"
: "${DINX_NOTO_BOLD_SOURCE_SHA256:?missing bold Noto Sans checksum}"
: "${DINX_NOTO_ITALIC_SOURCE_URL:?missing italic Noto Sans URL}"
: "${DINX_NOTO_ITALIC_SOURCE_SHA256:?missing italic Noto Sans checksum}"
: "${DINX_NOTO_BOLD_ITALIC_SOURCE_URL:?missing bold italic Noto Sans URL}"
: "${DINX_NOTO_BOLD_ITALIC_SOURCE_SHA256:?missing bold italic Noto Sans checksum}"
: "${DINX_NOTO_MONO_REGULAR_SOURCE_URL:?missing regular Noto Sans Mono URL}"
: "${DINX_NOTO_MONO_REGULAR_SOURCE_SHA256:?missing regular Noto Sans Mono checksum}"

pkgver="$DINX_NOTO_VERSION"
pkgrel=1
pkgdesc="Latin Noto Sans replacement for the full Noto font package"
arch=('any')
url="https://github.com/notofonts/notofonts.github.io"
license=('OFL-1.1-no-RFN')
provides=('noto-fonts' 'ttf-font')
conflicts=('noto-fonts')
depends=('fontconfig')
makedepends=('python-fonttools')
source=(
  "NotoSans-Regular.ttf::${DINX_NOTO_REGULAR_SOURCE_URL}"
  "NotoSans-Bold.ttf::${DINX_NOTO_BOLD_SOURCE_URL}"
  "NotoSans-Italic.ttf::${DINX_NOTO_ITALIC_SOURCE_URL}"
  "NotoSans-BoldItalic.ttf::${DINX_NOTO_BOLD_ITALIC_SOURCE_URL}"
  "NotoSansMono-Regular.ttf::${DINX_NOTO_MONO_REGULAR_SOURCE_URL}"
)
sha256sums=(
  "$DINX_NOTO_REGULAR_SOURCE_SHA256"
  "$DINX_NOTO_BOLD_SOURCE_SHA256"
  "$DINX_NOTO_ITALIC_SOURCE_SHA256"
  "$DINX_NOTO_BOLD_ITALIC_SOURCE_SHA256"
  "$DINX_NOTO_MONO_REGULAR_SOURCE_SHA256"
)

package() {
  local font_dir="$pkgdir/usr/share/fonts/dinx-noto-latin"
  local unicode_ranges='U+0000-024F,U+0300-036F,U+1E00-1EFF,U+2000-206F,U+20A0-20CF,U+2116,U+2122,U+2126,U+212A,U+212B'
  install -d "$font_dir"
  pyftsubset "$srcdir/NotoSans-Regular.ttf" \
    --output-file="$font_dir/NotoSans-Regular.ttf" --unicodes="$unicode_ranges"
  pyftsubset "$srcdir/NotoSans-Bold.ttf" \
    --output-file="$font_dir/NotoSans-Bold.ttf" --unicodes="$unicode_ranges"
  pyftsubset "$srcdir/NotoSans-Italic.ttf" \
    --output-file="$font_dir/NotoSans-Italic.ttf" --unicodes="$unicode_ranges"
  pyftsubset "$srcdir/NotoSans-BoldItalic.ttf" \
    --output-file="$font_dir/NotoSans-BoldItalic.ttf" --unicodes="$unicode_ranges"
  pyftsubset "$srcdir/NotoSansMono-Regular.ttf" \
    --output-file="$font_dir/NotoSansMono-Regular.ttf" --unicodes="$unicode_ranges"
  install -Dm644 "$startdir/OFL.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
}

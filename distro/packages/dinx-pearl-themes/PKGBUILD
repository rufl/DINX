pkgname=dinx-pearl-themes
source_env="$startdir/source.env"
[[ -r "$source_env" ]] || { printf 'PKGBUILD: missing %s\n' "$source_env" >&2; exit 1; }
. "$source_env"
: "${DINX_PEARL_THEMES_VERSION:?missing DINX_PEARL_THEMES_VERSION}"
: "${SKEUOS_FORK_COMMIT:?missing Skeuos fork commit}"
: "${SKEUOS_FORK_SOURCE_URL:?missing Skeuos fork source URL}"
: "${SKEUOS_FORK_SOURCE_SHA256:?missing Skeuos fork source checksum}"
: "${ORCHIS_FORK_COMMIT:?missing Orchis fork commit}"
: "${ORCHIS_FORK_SOURCE_URL:?missing Orchis fork source URL}"
: "${ORCHIS_FORK_SOURCE_SHA256:?missing Orchis fork source checksum}"
: "${FLUENT_FORK_COMMIT:?missing Fluent fork commit}"
: "${FLUENT_FORK_SOURCE_URL:?missing Fluent fork source URL}"
: "${FLUENT_FORK_SOURCE_SHA256:?missing Fluent fork source checksum}"
: "${JASPER_FORK_COMMIT:?missing Jasper fork commit}"
: "${JASPER_FORK_SOURCE_URL:?missing Jasper fork source URL}"
: "${JASPER_FORK_SOURCE_SHA256:?missing Jasper fork source checksum}"
pkgver="$DINX_PEARL_THEMES_VERSION"
pkgrel=5
pkgdesc='Fluent, Jasper, Skeuos and Orchis Pearl community themes with rounded and square corners'
arch=('any')
url='https://github.com/rufl/DINX'
license=('GPL-3.0-only')
depends=('pearl')
source=(
  "skeuos-gtk-${SKEUOS_FORK_COMMIT}.tar.gz::${SKEUOS_FORK_SOURCE_URL}"
  "Orchis-theme-${ORCHIS_FORK_COMMIT}.tar.gz::${ORCHIS_FORK_SOURCE_URL}"
  "Fluent-gtk-theme-${FLUENT_FORK_COMMIT}.tar.gz::${FLUENT_FORK_SOURCE_URL}"
  "Jasper-gtk-theme-${JASPER_FORK_COMMIT}.tar.gz::${JASPER_FORK_SOURCE_URL}"
  "dinx-pearl-theme-pipeline.py"
)
sha256sums=(
  "$SKEUOS_FORK_SOURCE_SHA256"
  "$ORCHIS_FORK_SOURCE_SHA256"
  "$FLUENT_FORK_SOURCE_SHA256"
  "$JASPER_FORK_SOURCE_SHA256"
  '6e0507502f2a04d902b7e62cc7367be28f206230c31618440a6f2ba4955c3f95'
)

prepare() {
  local theme_dir="$srcdir/dinx-pearl-themes"
  local theme
  rm -rf "$theme_dir"
  install -d "$theme_dir"
  for theme in skeuos-rounded skeuos-square; do
    cp -a "$srcdir/skeuos-gtk-${SKEUOS_FORK_COMMIT}/themes/$theme" \
      "$theme_dir/dinx.$theme"
  done
  for theme in orchis-rounded orchis-square; do
    cp -a "$srcdir/Orchis-theme-${ORCHIS_FORK_COMMIT}/themes/$theme" \
      "$theme_dir/dinx.$theme"
  done
  for theme in fluent-rounded fluent-square; do
    cp -a "$srcdir/Fluent-gtk-theme-${FLUENT_FORK_COMMIT}/themes/$theme" \
      "$theme_dir/dinx.$theme"
  done
  for theme in jasper-rounded jasper-square; do
    cp -a "$srcdir/Jasper-gtk-theme-${JASPER_FORK_COMMIT}/themes/$theme" \
      "$theme_dir/dinx.$theme"
  done
  python3 "$srcdir/dinx-pearl-theme-pipeline.py" normalize "$theme_dir"
}

check() {
  python3 "$srcdir/dinx-pearl-theme-pipeline.py" validate \
    "$srcdir/dinx-pearl-themes"
}

package() {
  local theme_dir="$pkgdir/usr/share/pearl/themes"
  install -d "$theme_dir"
  cp -a "$srcdir/dinx-pearl-themes/." "$theme_dir/"
}
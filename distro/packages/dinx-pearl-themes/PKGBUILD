pkgname=dinx-pearl-themes
source_env="$startdir/source.env"
[[ -r "$source_env" ]] || { printf 'PKGBUILD: missing %s\n' "$source_env" >&2; exit 1; }
. "$source_env"
: "${DINX_PEARL_THEMES_VERSION:?missing DINX_PEARL_THEMES_VERSION}"
: "${SKEUOS_FORK_COMMIT:?missing Skeuos fork commit}"
: "${SKEUOS_FORK_SOURCE_URL:?missing Skeuos fork source URL}"
: "${SKEUOS_FORK_SOURCE_SHA256:?missing Skeuos fork source checksum}"
: "${ORCHIS_FORK_COMMIT:?missing Orchis fork commit}"
: "${ORCHIS_FORK_SOURCE_URL:?missing Orchis fork source URL}"
: "${ORCHIS_FORK_SOURCE_SHA256:?missing Orchis fork source checksum}"
pkgver="$DINX_PEARL_THEMES_VERSION"
pkgrel=2
pkgdesc='Skeuos and Orchis Pearl community themes with rounded and square corners'
arch=('any')
url='https://github.com/rufl/DINX'
license=('GPL-3.0-only')
depends=('pearl')
source=(
  "skeuos-gtk-${SKEUOS_FORK_COMMIT}.tar.gz::${SKEUOS_FORK_SOURCE_URL}"
  "Orchis-theme-${ORCHIS_FORK_COMMIT}.tar.gz::${ORCHIS_FORK_SOURCE_URL}"
)
sha256sums=(
  "$SKEUOS_FORK_SOURCE_SHA256"
  "$ORCHIS_FORK_SOURCE_SHA256"
)

check() {
  local theme
  for theme in skeuos-rounded skeuos-square; do
    test -f "$srcdir/skeuos-gtk-${SKEUOS_FORK_COMMIT}/themes/$theme/theme.json" \
      || { printf 'missing Skeuos Pearl theme: %s\n' "$theme" >&2; return 1; }
  done
  for theme in orchis-rounded orchis-square; do
    test -f "$srcdir/Orchis-theme-${ORCHIS_FORK_COMMIT}/themes/$theme/theme.json" \
      || { printf 'missing Orchis Pearl theme: %s\n' "$theme" >&2; return 1; }
  done
}

package() {
  # Pearl discovers system themes at $XDG_DATA_DIRS/pearl/themes/*/theme.json.
  # Each package keeps its LICENSE and ATTRIBUTION.md inside the theme folder.
  local theme_dir="$pkgdir/usr/share/pearl/themes"
  local theme
  install -d "$theme_dir"
  for theme in skeuos-rounded skeuos-square; do
    cp -a "$srcdir/skeuos-gtk-${SKEUOS_FORK_COMMIT}/themes/$theme" "$theme_dir/dinx.$theme"
  done
  for theme in orchis-rounded orchis-square; do
    cp -a "$srcdir/Orchis-theme-${ORCHIS_FORK_COMMIT}/themes/$theme" "$theme_dir/dinx.$theme"
  done
}
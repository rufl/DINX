Window.SetBackgroundTopColor(0.043, 0.051, 0.071);
Window.SetBackgroundBottomColor(0.043, 0.051, 0.071);

logo.original = Image("logo.png");
logo_size = Math.Int(Window.GetHeight() * 0.55);
if (logo_size > Math.Int(Window.GetWidth() * 0.75))
  logo_size = Math.Int(Window.GetWidth() * 0.75);
if (logo_size > 512)
  logo_size = 512;
if (logo_size < 64)
  logo_size = 64;
logo.image = logo.original.Scale(logo_size, logo_size);
logo.sprite = Sprite(logo.image);

fun refresh_callback ()
  {
    logo.sprite.SetPosition(
      Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2,
      Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2,
      1000);
  }

Plymouth.SetRefreshFunction(refresh_callback);
refresh_callback();

Window.SetBackgroundTopColor(0.043, 0.051, 0.071);
Window.SetBackgroundBottomColor(0.043, 0.051, 0.071);

logo.original = Image("logo.png");
logo_size = Math.Int(Window.GetHeight() * 0.55);
if (logo_size > Math.Int(Window.GetWidth() * 0.75))
  logo_size = Math.Int(Window.GetWidth() * 0.75);
if (logo_size > 512)
  logo_size = 512;
if (logo_size < 64)
  logo_size = 64;
logo.image = logo.original.Scale(logo_size, logo_size);
logo.sprite = Sprite(logo.image);
indicator.image = Image.Text("•  •  •", 0.56, 0.72, 1.0, 1.0, "Sans 16", "center");
indicator.sprite = Sprite(indicator.image);
indicator.frame = 0;
indicator.tick = 0;
indicator.opacity = [0.25, 0.45, 0.70, 1.0, 0.70, 0.45];

fun refresh_callback ()
  {
    logo.sprite.SetPosition(
      Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2,
      Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2,
      1000);
    indicator.tick++;
    if (indicator.tick % 5 == 0)
      indicator.frame = (indicator.frame + 1) % 6;
    indicator.sprite.SetOpacity(indicator.opacity[indicator.frame]);
    indicator.sprite.SetPosition(
      Window.GetX() + Window.GetWidth() / 2 - indicator.image.GetWidth() / 2,
      Window.GetY() + Window.GetHeight() / 2 + logo.image.GetHeight() / 2 + 18,
      1001);
  }

Plymouth.SetRefreshFunction(refresh_callback);
refresh_callback();

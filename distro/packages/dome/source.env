# Manual source pin: Dome ships as a subproject of the Seafoam-Labs/pearl
# monorepo, which DINX no longer tracks — the Pearl shell itself was retired
# when main moved to River/KWM/Morghulis, but Dome and Phyto are still shipped.
# The 0.3.0 archive is pinned because discreet-header.patch is written against
# it and does NOT apply to 0.3.9: upstream reworked the header builder and split
# buildOverview into paginated builders, so `patch --fuzz=0` rejects both hunks.
# No static gate applies the patch, so an automated bump would only fail later
# during the P0 build. Bump deliberately and regenerate the patch in the same
# change; see MANUAL_SOURCE_PINS in scripts/check_package_update_manifest.py.
DOME_REPOSITORY=https://github.com/Seafoam-Labs/pearl
DOME_VERSION=0.1.1
DOME_SOURCE_VERSION=0.3.0
DOME_SOURCE_SHA256=afb15f5650cdd0aa00a9d6ee697dec1cde2cb9eaa77b1631e4876c125caba24a

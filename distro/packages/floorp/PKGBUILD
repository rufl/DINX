pkgname=floorp
source_env="$startdir/source.env"
[[ -r "$source_env" ]] || { printf 'PKGBUILD: missing %s\n' "$source_env" >&2; exit 1; }
. "$source_env"
: "${FLOORP_VERSION:?missing FLOORP_VERSION}"
: "${FLOORP_SOURCE_URL:?missing FLOORP_SOURCE_URL}"
: "${FLOORP_SOURCE_SHA256:?missing FLOORP_SOURCE_SHA256}"
pkgver="$FLOORP_VERSION"
pkgrel=1
pkgdesc='Firefox-based web browser focused on performance and customizability'
arch=('x86_64')
url='https://github.com/Floorp-Projects/Floorp'
license=('MPL-2.0')
depends=('alsa-lib' 'gtk3')
optdepends=(
  'ffmpeg: H.264 video playback'
  'hunspell: spell checking'
  'libnotify: desktop notifications'
  'networkmanager: Wi-Fi-based location detection'
)
options=('!strip' '!debug')
source=(
  "floorp-linux-x86_64.tar.xz::${FLOORP_SOURCE_URL}"
  'policies.json'
  'floorp-launcher'
  'floorp.desktop'
)
sha256sums=(
  "$FLOORP_SOURCE_SHA256"
  '2bdebdb4b0b0abe0e6099ab9124233aee8e674a2f4877f67111c8b5a476b4129'
  '619a4b7c0a40f057811bd11b5a8fb180ee618b6131617da27b067246d5f377b2'
  'b0cb16bb2653a77b29c5baf32757c5efc17e09b3f0d79d6c81b5b926f4ddd891'
)

package() {
  install -d "$pkgdir/usr/lib/floorp"
  cp -a "$srcdir/floorp/." "$pkgdir/usr/lib/floorp/"
  install -Dm644 "$srcdir/policies.json" \
    "$pkgdir/usr/lib/floorp/distribution/policies.json"
  install -Dm755 "$srcdir/floorp-launcher" "$pkgdir/usr/bin/floorp"
  install -Dm644 "$srcdir/floorp.desktop" \
    "$pkgdir/usr/share/applications/floorp.desktop"
  for size in 16 32 48 64 128; do
    install -d "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps"
    ln -s "/usr/lib/floorp/browser/chrome/icons/default/default${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/floorp.png"
  done
  install -Dm644 /dev/stdin "$pkgdir/usr/share/doc/floorp/SOURCE" <<EOF
Floorp ${pkgver} official Linux x86_64 release archive:
${FLOORP_SOURCE_URL}
The DINX package redistributes the upstream release without modifying its browser files.
EOF
}

pkgname=gapless
source_env="$startdir/source.env"
[[ -r "$source_env" ]] || { printf 'PKGBUILD: missing %s\n' "$source_env" >&2; exit 1; }
. "$source_env"
: "${GAPLESS_VERSION:?missing GAPLESS_VERSION}"
: "${GAPLESS_SOURCE_URL:?missing GAPLESS_SOURCE_URL}"
: "${GAPLESS_SOURCE_B2:?missing GAPLESS_SOURCE_B2}"
pkgver="$GAPLESS_VERSION"
pkgrel=1
pkgdesc="Lightweight, adaptive GTK4 music player (G4Music)"
arch=('x86_64')
url="https://gitlab.gnome.org/neithern/g4music"
license=('GPL-3.0-only')
depends=(
  dconf
  gdk-pixbuf2
  glib2
  glibc
  graphene
  gst-plugins-base-libs
  gst-plugins-base
  gst-plugins-good
  gstreamer
  gtk4
  hicolor-icon-theme
  libadwaita
  pango
)
makedepends=(
  meson
  vala
)
optdepends=(
  'gst-plugins-bad: additional audio format support'
  'gst-plugins-ugly: additional audio format support'
)
provides=('g4music')
conflicts=('g4music')
source=("g4music-v${pkgver}.tar.gz::${GAPLESS_SOURCE_URL}")
b2sums=("$GAPLESS_SOURCE_B2")

build() {
  meson setup --prefix=/usr --buildtype=plain build "${srcdir}/g4music-v${pkgver}"
  meson compile -C build
}

package() {
  meson install -C build --destdir="${pkgdir}"
  install -Dm644 "${srcdir}/g4music-v${pkgver}/COPYING" \
    "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
}

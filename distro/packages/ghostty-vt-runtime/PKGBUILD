pkgname=ghostty-vt-runtime
_ghostty_version=1.4.0
pkgver=${_ghostty_version}
pkgrel=1
pkgdesc='Ghostty VT shared library and headers for Deetty; no Ghostty terminal executable'
arch=('x86_64')
url='https://github.com/ghostty-org/ghostty'
license=('MIT')
depends=('bzip2' 'fontconfig' 'freetype2' 'glib2' 'glibc' 'gtk4' 'gtk4-layer-shell' 'harfbuzz' 'libadwaita' 'libglvnd' 'libpng' 'libx11' 'oniguruma' 'pixman' 'wayland' 'zlib')
makedepends=('zig>=0.17' 'cmake' 'ninja' 'gtk4' 'gtk4-layer-shell' 'libadwaita')
source=("https://github.com/ghostty-org/ghostty/archive/refs/tags/v${_ghostty_version}.tar.gz")
sha256sums=('SKIP')
provides=('libghostty-vt')
conflicts=('ghostty')
package() {
  cd "ghostty-${_ghostty_version}"
  zig build -Doptimize=ReleaseSafe -Demit-lib-vt
  local library
  install -d -m755 "$pkgdir/usr/lib" "$pkgdir/usr/include"
  while IFS= read -r -d '' library; do
    cp -a "$library" "$pkgdir/usr/lib/"
  done < <(find zig-out/lib -name 'libghostty-vt.so*' -print0 2>/dev/null)
  [[ -e "$pkgdir/usr/lib/libghostty-vt.so.0" ]] || {
    printf 'PKGBUILD: libghostty-vt.so.0 is missing from the build output\n' >&2
    return 1
  }
  [[ -f zig-out/include/ghostty/vt.h ]] || {
    printf 'PKGBUILD: Ghostty VT headers are missing\n' >&2
    return 1
  }
  cp -a zig-out/include/ghostty "$pkgdir/usr/include/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/ghostty-vt-runtime/LICENSE"
}
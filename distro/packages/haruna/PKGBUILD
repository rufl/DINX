pkgname=haruna
source_env="$startdir/source.env"
[[ -r "$source_env" ]] || { printf 'PKGBUILD: missing %s\n' "$source_env" >&2; exit 1; }
. "$source_env"
: "${HARUNA_VERSION:?missing HARUNA_VERSION}"
: "${HARUNA_SOURCE_URL:?missing HARUNA_SOURCE_URL}"
: "${HARUNA_SOURCE_SHA256:?missing HARUNA_SOURCE_SHA256}"
pkgver="$HARUNA_VERSION"
pkgrel=1
pkgdesc='Video player built with Qt/QML on top of libmpv'
arch=('x86_64')
url='https://apps.kde.org/haruna/'
license=('GPL-3.0-or-later')
depends=(
  ffmpeg
  glibc
  hicolor-icon-theme
  kcolorscheme
  kconfig
  kcoreaddons
  kcrash
  kdeclarative
  kdsingleapplication
  kfilemetadata
  ki18n
  kio
  kirigami
  kitemmodels
  kservice
  kwindowsystem
  libstdc++
  mpvqt
  qqc2-desktop-style
  qt6-5compat
  qt6-base
  qt6-declarative
)
makedepends=(extra-cmake-modules)
optdepends=('yt-dlp: YouTube support')
source=("${HARUNA_SOURCE_URL}")
sha256sums=("$HARUNA_SOURCE_SHA256")

build() {
  cmake -B build -S "${srcdir}/haruna-${pkgver}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "${srcdir}/haruna-${pkgver}/LICENSES/GPL-3.0-or-later.txt" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

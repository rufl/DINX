pkgname=impasto
source_env="$startdir/source.env"
[[ -r "$source_env" ]] || { printf 'PKGBUILD: missing %s\n' "$source_env" >&2; exit 1; }
. "$source_env"
: "${IMPASTO_VERSION:?missing IMPASTO_VERSION}"
: "${IMPASTO_SOURCE_URL:?missing IMPASTO_SOURCE_URL}"
: "${IMPASTO_SOURCE_SHA256:?missing IMPASTO_SOURCE_SHA256}"
: "${IMPASTO_LICENSE_URL:?missing IMPASTO_LICENSE_URL}"
: "${IMPASTO_LICENSE_SHA256:?missing IMPASTO_LICENSE_SHA256}"
: "${IMPASTO_PINTA_LICENSE_URL:?missing IMPASTO_PINTA_LICENSE_URL}"
: "${IMPASTO_PINTA_LICENSE_SHA256:?missing IMPASTO_PINTA_LICENSE_SHA256}"
: "${IMPASTO_LGPL_LICENSE_URL:?missing IMPASTO_LGPL_LICENSE_URL}"
: "${IMPASTO_LGPL_LICENSE_SHA256:?missing IMPASTO_LGPL_LICENSE_SHA256}"
: "${IMPASTO_NOTICES_URL:?missing IMPASTO_NOTICES_URL}"
: "${IMPASTO_NOTICES_SHA256:?missing IMPASTO_NOTICES_SHA256}"
pkgver="$IMPASTO_VERSION"
pkgrel=1
pkgdesc='GTK image editor for painting, creating, and editing images'
arch=('x86_64')
url='https://github.com/zbcoding/ImpastoPaint'
license=('custom')
depends=('glibc')
options=('!strip')
source=(
  "Impasto-x86_64.AppImage::${IMPASTO_SOURCE_URL}"
  "license-mit.txt::${IMPASTO_LICENSE_URL}"
  "license-mit-pinta.txt::${IMPASTO_PINTA_LICENSE_URL}"
  "license-lgpl.txt::${IMPASTO_LGPL_LICENSE_URL}"
  "THIRD-PARTY-NOTICES.md::${IMPASTO_NOTICES_URL}"
  'impasto'
  'impasto.desktop'
)
sha256sums=(
  "$IMPASTO_SOURCE_SHA256"
  "$IMPASTO_LICENSE_SHA256"
  "$IMPASTO_PINTA_LICENSE_SHA256"
  "$IMPASTO_LGPL_LICENSE_SHA256"
  "$IMPASTO_NOTICES_SHA256"
  '0ea49cf3f2c4e935d697bfa463091a578c583f789438f02ac125f3270a03002a'
  '57f5e0e9db4f94355c2b9408ae8000fe55e42cad351dff24d568c5419312dbdc'
)

package() {
  install -Dm755 "$srcdir/Impasto-x86_64.AppImage" \
    "$pkgdir/opt/impasto/Impasto-x86_64.AppImage"
  install -Dm755 "$srcdir/impasto" "$pkgdir/usr/bin/impasto"
  install -Dm644 "$srcdir/impasto.desktop" \
    "$pkgdir/usr/share/applications/com.github.zbcoding.Impasto.desktop"
  install -Dm644 "$srcdir/license-mit.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/license-mit.txt"
  install -Dm644 "$srcdir/license-mit-pinta.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/license-mit-pinta.txt"
  install -Dm644 "$srcdir/license-lgpl.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/license-lgpl.txt"
  install -Dm644 "$srcdir/THIRD-PARTY-NOTICES.md" \
    "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.md"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/doc/$pkgname/SOURCE" <<EOF
Impasto ${pkgver} upstream source and build information:
https://github.com/zbcoding/ImpastoPaint/tree/v${pkgver}

The DINX package redistributes the upstream x86_64 AppImage without modification.
EOF
}

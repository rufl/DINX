pkgname=kwim
source_env="$startdir/source.env"
[[ -r "$source_env" ]] || { printf 'PKGBUILD: missing %s\n' "$source_env" >&2; exit 1; }
. "$source_env"
: "${KWIM_VERSION:?missing KWIM_VERSION}"
: "${KWIM_REPOSITORY:?missing KWIM_REPOSITORY}"
: "${KWIM_SOURCE_SHA256:?missing KWIM_SOURCE_SHA256}"
pkgver="$KWIM_VERSION"
pkgrel=1
pkgdesc="Kewuaa's input manager for the River compositor"
arch=('x86_64')
url="$KWIM_REPOSITORY"
license=('GPL-3.0-only')
depends=('libxkbcommon' 'river' 'wayland')
makedepends=('wayland-protocols')
# build.zig.zon pins mvzr, zig-wayland, zig-xkbcommon and zig-clap by content
# hash, so Zig fetches and verifies them itself; no extra source entries are needed.
source=("$pkgname-$pkgver.tar.gz::$KWIM_REPOSITORY/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=("$KWIM_SOURCE_SHA256")

build() {
  cd "$srcdir/$pkgname-$pkgver"
  export ZIG_GLOBAL_CACHE_DIR="${ZIG_GLOBAL_CACHE_DIR:-$srcdir/zig-global-cache}"
  "${ZIG:-zig}" build -Doptimize=ReleaseSafe -Dcpu=baseline
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 zig-out/bin/kwim "$pkgdir/usr/bin/kwim"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

pkgname=kwm
source_env="$startdir/source.env"
[[ -r "$source_env" ]] || { printf 'PKGBUILD: missing %s\n' "$source_env" >&2; exit 1; }
. "$source_env"
: "${KWM_VERSION:?missing KWM_VERSION}"
: "${KWM_REPOSITORY:?missing KWM_REPOSITORY}"
: "${KWM_SOURCE_SHA256:?missing KWM_SOURCE_SHA256}"
pkgver="$KWM_VERSION"
pkgrel=1
pkgdesc="Kewuaa's window manager for the River compositor"
arch=('x86_64')
url="$KWM_REPOSITORY"
license=('GPL-3.0-only')
depends=('fcft' 'kwim' 'libxkbcommon' 'pixman' 'river' 'wayland')
optdepends=('foot: default terminal in the upstream example configuration'
            'wmenu: default launcher in the upstream example configuration'
            'swaybg: default wallpaper setter in the upstream example configuration')
makedepends=('wayland-protocols')
# build.zig.zon pins zig-xkbcommon, zig-wayland, mvzr, zig-fcft and zig-pixman
# by content hash, so Zig fetches and verifies each fork itself.
source=("$pkgname-$pkgver.tar.gz::$KWM_REPOSITORY/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=("$KWM_SOURCE_SHA256")

build() {
  cd "$srcdir/$pkgname-$pkgver"
  export ZIG_GLOBAL_CACHE_DIR="${ZIG_GLOBAL_CACHE_DIR:-$srcdir/zig-global-cache}"
  "${ZIG:-zig}" build -Doptimize=ReleaseSafe -Dcpu=baseline
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 zig-out/bin/kwm "$pkgdir/usr/bin/kwm"
  install -Dm644 zig-out/share/man/man1/kwm.1 "$pkgdir/usr/share/man/man1/kwm.1"
  install -Dm644 zig-out/share/doc/kwm/config.zon "$pkgdir/usr/share/doc/kwm/config.def.zon"
  install -Dm644 zig-out/share/icons/hicolor/scalable/apps/kwm.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/kwm.svg"
  # The DINX session launches kwm through dinx-river-init, not as its own
  # session; the upstream contrib/kwm.desktop is not installed.
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

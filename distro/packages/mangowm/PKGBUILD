pkgname=mangowm
_pkgname=mango
pkgver=0.18.0
_commit=a21b10fcbe6156b76ea96178d1941de5cb36137f
pkgrel=2
pkgdesc="Lightweight, feature rich modern Wayland compositor"
url="https://mangowm.github.io"
arch=(x86_64)
license=(GPL-3.0-or-later)
depends=(glibc wayland-protocols pango wayland libinput libdrm cairo pixman libdisplay-info libliftoff seatd xorg-xwayland glib2 libxcb libxkbcommon pcre2 wlroots0.20 scenefx cjson xcb-util-wm)
provides=(wayland-compositor)
source=("$pkgname-$pkgver.tar.gz::https://github.com/mangowm/mango/archive/$_commit.tar.gz")
sha256sums=('06dce949df1c9bed25ecb21313fc173cf42ec4e30f4b11085c7768f9a932d34e')

build() {
  meson setup build "$srcdir/$_pkgname-$_commit" --prefix=/usr --buildtype=plain
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir="$pkgdir"
  # Mango upstream installs a systemd user target; DINX uses dinit.
  rm -rf "$pkgdir/usr/lib/systemd"
}

pkgname=mission-center
source_env="$startdir/source.env"
[[ -r "$source_env" ]] || { printf 'PKGBUILD: missing %s\n' "$source_env" >&2; exit 1; }
. "$source_env"
: "${MISSION_CENTER_VERSION:?missing MISSION_CENTER_VERSION}"
: "${MISSION_CENTER_REPOSITORY:?missing MISSION_CENTER_REPOSITORY}"
: "${MISSION_CENTER_SOURCE_URL:?missing MISSION_CENTER_SOURCE_URL}"
: "${MISSION_CENTER_SOURCE_SHA256:?missing MISSION_CENTER_SOURCE_SHA256}"
: "${MISSION_CENTER_MAGPIE_COMMIT:?missing MISSION_CENTER_MAGPIE_COMMIT}"
: "${MISSION_CENTER_MAGPIE_SOURCE_URL:?missing MISSION_CENTER_MAGPIE_SOURCE_URL}"
: "${MISSION_CENTER_MAGPIE_SOURCE_SHA256:?missing MISSION_CENTER_MAGPIE_SOURCE_SHA256}"
: "${MISSION_CENTER_GRAPH_WIDGET_COMMIT:?missing MISSION_CENTER_GRAPH_WIDGET_COMMIT}"
:: "${APP_DETECTION_COMMIT:?missing APP_DETECTION_COMMIT}"
:: "${APP_DETECTION_SOURCE_URL:?missing APP_DETECTION_SOURCE_URL}"
:: "${APP_DETECTION_SOURCE_SHA256:?missing APP_DETECTION_SOURCE_SHA256}"
: "${MISSION_CENTER_GRAPH_WIDGET_SOURCE_SHA256:?missing MISSION_CENTER_GRAPH_WIDGET_SOURCE_SHA256}"
pkgver="$MISSION_CENTER_VERSION"
pkgrel=2
pkgdesc='System monitor for CPU, memory, disk, network and GPU usage'
arch=('x86_64')
url="$MISSION_CENTER_REPOSITORY"
license=('GPL-3.0-or-later')
depends=('dconf' 'dmidecode' 'gdk-pixbuf2' 'glib2' 'glibc' 'gtk4' 'libadwaita' 'libdrm' 'libudev' 'mesa' 'udisks2')
makedepends=('blueprint-compiler' 'cargo' 'cmake' 'meson' 'nasm' 'ninja' 'openssl')
source=(
  "mission-center-v$pkgver.tar.gz::$MISSION_CENTER_SOURCE_URL"
  "gng-$MISSION_CENTER_MAGPIE_COMMIT.tar.gz::$MISSION_CENTER_MAGPIE_SOURCE_URL"
  "graph-widget-$MISSION_CENTER_GRAPH_WIDGET_COMMIT.tar.gz::$MISSION_CENTER_GRAPH_WIDGET_SOURCE_URL"
  "app-detection-$APP_DETECTION_COMMIT.tar.gz::$APP_DETECTION_SOURCE_URL"
  "mission-center-dinx-dinit-services.patch"
)
sha256sums=(
  "$MISSION_CENTER_SOURCE_SHA256"
  "$MISSION_CENTER_MAGPIE_SOURCE_SHA256"
  "$MISSION_CENTER_GRAPH_WIDGET_SOURCE_SHA256"
  "$APP_DETECTION_SOURCE_SHA256"
  'ecd0b38708d410331c0391380caf8baad401981f9a1a008446d5436171c7af6d'
)

prepare() {
  local root="$srcdir/mission-center-v$pkgver"
  rm -rf "$root/subprojects/magpie" "$root/subprojects/graph-widget"
  mv "$srcdir/gng-$MISSION_CENTER_MAGPIE_COMMIT" "$root/subprojects/magpie"
  mv "$srcdir/graph-widget-$MISSION_CENTER_GRAPH_WIDGET_COMMIT" "$root/subprojects/graph-widget"
  mkdir -p "$root/subprojects/magpie/platform-linux/crates/app-rummage"
  mv "$srcdir/app-detection-$APP_DETECTION_COMMIT"/* "$root/subprojects/magpie/platform-linux/crates/app-rummage"/
  # DINX patch: add Dinit init system backend to the magpie service cache so
  # the Services tab lists and controls dinit services on Artix/DINX installs.
  patch --fuzz=0 --forward --strip=1 -d "$root/subprojects/magpie" \
    < "$srcdir/mission-center-dinx-dinit-services.patch"
  # Disable ring asm to avoid host/target linking mismatch in meson+cargo build
  # 1. Replace ring line in magpie Cargo.toml for ALL cargo invocations
  sed -i 's/^ring =.*/ring = { version = "0.17", default-features = false, features = ["std"] }/' "$root/subprojects/magpie/Cargo.toml"
  # 2. Add .cargo/config.toml in magpie for build scripts and any other cargo invocations
  mkdir -p "$root/subprojects/magpie/.cargo"
  cat > "$root/subprojects/magpie/.cargo/config.toml" <<'EOF'
[target.x86_64-unknown-linux-gnu]
ring = { default-features = false, features = ["std"] }
EOF
  # 3. Also add at workspace root for meson's cargo invocations
  mkdir -p "$root/.cargo"
  cat > "$root/.cargo/config.toml" <<'EOF'
[target.x86_64-unknown-linux-gnu]
ring = { default-features = false, features = ["std"] }
EOF
}

build() {
  cd "$srcdir/mission-center-v$pkgver"
  export CARGO_HOME="${CARGO_HOME:-$srcdir/cargo-home}"
  # Disable ring asm features globally
  export RUSTFLAGS="${RUSTFLAGS} -C target-feature=-aes,-avx2"
  meson setup build --prefix=/usr --buildtype=release -Db_lto=false
  meson compile -C build
}

package() {
  cd "$srcdir/mission-center-v$pkgver"
  DESTDIR="$pkgdir" meson install -C build
  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}

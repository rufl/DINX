+/* src/services/dinit/manager.rs
+ *
+ * DINX patch — Dinit service manager (start/stop/restart/enable/disable)
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+use std::process::Command;
+use super::DinitError;
+
+pub struct ServiceManager;
+
+impl ServiceManager {
+    pub fn new() -> Result<Self, DinitError> {
+        if !super::is_available() {
+            return Err(DinitError::NotFound);
+        }
+        Ok(ServiceManager)
+    }
+
+    pub fn start_service(&self, name: &str) -> Result<(), DinitError> {
+        self.run(&["--system", "start", name])
+    }
+
+    pub fn stop_service(&self, name: &str) -> Result<(), DinitError> {
+        self.run(&["--system", "stop", name])
+    }
+
+    pub fn restart_service(&self, name: &str) -> Result<(), DinitError> {
+        self.run(&["--system", "restart", name])
+    }
+
+    /// Enable: add a dependency from the `boot` target to this service so it
+    /// starts at next boot.  `dinitctl enable` does exactly this.
+    pub fn enable_service(&self, name: &str) -> Result<(), DinitError> {
+        self.run_privileged(&["enable", name])
+    }
+
+    pub fn disable_service(&self, name: &str) -> Result<(), DinitError> {
+        self.run_privileged(&["disable", name])
+    }
+
+    /// Actions that only need to talk to the running daemon can run directly;
+    /// start/stop/restart do not need root on a system where the socket is
+    /// accessible (they may still require privileges depending on the service's
+    /// `run-as` setting — dinit will reject them if so).
+    fn run(&self, args: &[&str]) -> Result<(), DinitError> {
+        let cmd = Command::new("dinitctl").args(args).output()?;
+        if !cmd.status.success() {
+            let msg = String::from_utf8_lossy(&cmd.stderr).trim().to_owned();
+            return Err(DinitError::CommandError(
+                msg,
+                cmd.status.code().unwrap_or(-1),
+            ));
+        }
+        Ok(())
+    }
+
+    /// enable/disable modify on-disk service directories and need root.
+    fn run_privileged(&self, args: &[&str]) -> Result<(), DinitError> {
+        let mut full_args = vec!["dinitctl", "--system"];
+        full_args.extend_from_slice(args);
+        let cmd = Command::new("pkexec").args(&full_args).output()?;
+        if !cmd.status.success() {
+            let msg = String::from_utf8_lossy(&cmd.stderr).trim().to_owned();
+            return Err(DinitError::CommandError(
+                msg,
+                cmd.status.code().unwrap_or(-1),
+            ));
+        }
+        Ok(())
+    }
+}

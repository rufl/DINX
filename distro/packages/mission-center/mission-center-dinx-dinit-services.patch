+/* src/services/dinit/mod.rs
+ *
+ * DINX patch — Dinit service backend for Mission Center
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+use std::collections::HashMap;
+use std::hash::Hasher;
+use std::num::NonZero;
+use std::path::Path;
+use std::process::Command;
+
+use ahash::AHasher;
+use magpie_platform::services::Service;
+use thiserror::Error;
+
+pub use manager::ServiceManager;
+
+mod manager;
+
+#[derive(Debug, Error)]
+pub enum DinitError {
+    #[error("dinitctl not found in PATH")]
+    NotFound,
+    #[error("dinitctl exited with error: {0} (code {1})")]
+    CommandError(String, i32),
+    #[error("IO error: {0}")]
+    Io(#[from] std::io::Error),
+}
+
+/// Checks whether `dinitctl` is reachable and the system dinit socket exists.
+pub fn is_available() -> bool {
+    // The system socket path; if dinit is PID 1, this will exist.
+    let socket_exists = Path::new("/run/dinitctl").exists()
+        || Path::new("/run/dinit/dinitctl").exists()
+        || Path::new("/run/.dinitctl").exists();
+    if !socket_exists {
+        return false;
+    }
+    which::which("dinitctl").is_ok()
+}
+
+/// Persistent cache for the system dinit instance.
+pub struct Dinit;
+
+impl Dinit {
+    pub fn new() -> Result<Self, DinitError> {
+        if !is_available() {
+            return Err(DinitError::NotFound);
+        }
+        Ok(Dinit)
+    }
+
+    /// Run `dinitctl --system list` and parse into `Service` entries.
+    pub fn list_services(&self) -> Result<HashMap<u64, Service>, DinitError> {
+        let output = Command::new("dinitctl")
+            .args(["--system", "--quiet", "list"])
+            .output()?;
+
+        if !output.status.success() {
+            let msg = String::from_utf8_lossy(&output.stderr).trim().to_owned();
+            return Err(DinitError::CommandError(
+                msg,
+                output.status.code().unwrap_or(-1),
+            ));
+        }
+
+        let stdout = String::from_utf8_lossy(&output.stdout);
+        let mut map = HashMap::new();
+
+        for line in stdout.lines() {
+            if let Some(svc) = parse_list_line(line) {
+                map.insert(svc.id, svc);
+            }
+        }
+
+        Ok(map)
+    }
+}
+
+/// Parse one `dinitctl list` output line.
+///
+/// Format:  `[STATE] service-name  (description)` or `[STATE] service-name`
+///
+/// STATE column (positions 0-9, 10 chars):
+///   `[{+}     ]`  started/running
+///   `[{s}     ]`  started, startup skipped
+///   `[   {-}]`  stopped
+///   `[   {X}]`  failed / crashed
+///   `[{ }<<   ]`  starting
+///   `[   >>{ }]`  stopping
+///   square brackets `[]` → service is marked active
+fn parse_list_line(line: &str) -> Option<Service> {
+    // Minimum viable line: `[   {-}] name`
+    if line.len() < 11 {
+        return None;
+    }
+
+    let state_field = &line[..10]; // e.g. "[{+}     ]" or "[   {X}]  "
+    let rest = line[10..].trim();
+    if rest.is_empty() {
+        return None;
+    }
+
+    // Service name is the first whitespace-delimited token; optional description in parens after
+    let (name, description) = if let Some(idx) = rest.find("  ") {
+        let n = rest[..idx].trim().to_owned();
+        let d = rest[idx..].trim().trim_start_matches('(').trim_end_matches(')').trim().to_owned();
+        (n, if d.is_empty() { None } else { Some(d) })
+    } else {
+        (rest.to_owned(), None)
+    };
+
+    if name.is_empty() {
+        return None;
+    }
+
+    // Determine state from the bracket content
+    // `{+}` or `{s}` → started;  `{X}` → failed;  `{-}` → stopped
+    let running = state_field.contains('{') && (state_field.contains("+}") || state_field.contains("s}"));
+    let failed  = state_field.contains("{X}");
+    // Active-marked services use square brackets; enabled = has a service file in /etc/dinit.d/
+    let enabled = service_file_exists(&name);
+
+    // Stable id: AHash of the service name, same approach as OpenRC backend.
+    let id = {
+        let mut h = AHasher::default();
+        h.write(name.as_bytes());
+        h.finish()
+    };
+
+    // Try to read the PID from the service file or /run/<name>.pid
+    let pid = read_pid(&name);
+
+    // Canonical service file path
+    let file_path = find_service_file(&name).unwrap_or_default();
+
+    Some(Service {
+        id,
+        name,
+        description,
+        enabled,
+        running,
+        failed,
+        pid,
+        user: None,
+        group: None,
+        file_path: if file_path.is_empty() { None } else { Some(file_path) },
+    })
+}
+
+fn service_file_exists(name: &str) -> bool {
+    find_service_file(name).is_some()
+}
+
+fn find_service_file(name: &str) -> Option<String> {
+    let candidates = [
+        format!("/etc/dinit.d/{name}"),
+        format!("/usr/lib/dinit.d/{name}"),
+        format!("/usr/local/lib/dinit.d/{name}"),
+        format!("/run/dinit.d/{name}"),
+    ];
+    for p in &candidates {
+        if Path::new(p).exists() {
+            return Some(p.clone());
+        }
+    }
+    None
+}
+
+fn read_pid(name: &str) -> Option<u32> {
+    // Some services write a PID file; try common locations.
+    let candidates = [
+        format!("/run/{name}.pid"),
+        format!("/var/run/{name}.pid"),
+    ];
+    for p in &candidates {
+        if let Ok(content) = std::fs::read_to_string(p) {
+            if let Ok(pid) = content.trim().parse::<u32>() {
+                return Some(pid);
+            }
+        }
+    }
+    None
+}
+
+pub fn service_logs(name: &str, _pid: Option<NonZero<u32>>) -> Option<String> {
+    // `dinitctl catlog` reads the in-memory log buffer dinit captured for the service.
+    let output = Command::new("dinitctl")
+        .args(["--system", "catlog", name])
+        .output()
+        .ok()?;
+    if output.status.success() {
+        Some(String::from_utf8_lossy(&output.stdout).into_owned())
+    } else {
+        None
+    }
+}


pkgname=morghulis
source_env="$startdir/source.env"
[[ -r "$source_env" ]] || { printf 'PKGBUILD: missing %s\n' "$source_env" >&2; exit 1; }
. "$source_env"
: "${MORGHULIS_VERSION:?missing MORGHULIS_VERSION}"
: "${MORGHULIS_SOURCE_URL:?missing MORGHULIS_SOURCE_URL}"
: "${MORGHULIS_SOURCE_SHA256:?missing MORGHULIS_SOURCE_SHA256}"
pkgver="$MORGHULIS_VERSION"
pkgrel=6
pkgdesc='Wayland GTK4 desktop shell for the DINX River/KWM session'
arch=('x86_64')
url="$MORGHULIS_REPOSITORY"
license=('MIT')
depends=('astal' 'glib2' 'glibc' 'gtk4' 'gtk4-layer-shell' 'libadwaita'
         'gsound' 'json-glib' 'libnm' 'libportal')
makedepends=('meson' 'ninja' 'vala' 'blueprint-compiler' 'dart-sass'
             'gobject-introspection' 'glib2-devel')
# Two shell features degrade instead of failing when their helper is absent:
# ScreenRecord shells out to `wl-screenrec` and the NavBar tag scroller shells
# out to `river-shifttags`. Neither is packaged by Artix, and both log a warning
# and disable only that feature, so they stay optional rather than blocking the
# session. Install them separately to enable screen recording and tag scrolling.
optdepends=('wl-screenrec: screen recording from the shell'
            'river-shifttags: scroll through river tags from the NavBar')
source=("morghulis-$pkgver.tar.gz::$MORGHULIS_SOURCE_URL" "morghulis-dinx-power.patch" "morghulis-dinx-no-libgtop.patch" "morghulis-dinx-runner-close.patch" "morghulis-dinx-settings-no-dragon.patch" "morghulis-dinx-actions.patch" "morghulis-dinx-river-tags.patch")
sha256sums=("$MORGHULIS_SOURCE_SHA256" '837d2530bc5b29c737947c9147ff0a881f51586d201c9beaffb29c85c78dd05f' 'e33a274296c189be5d242ff49e89832f15c794e4ce9386a2e35fd48504515e76' 'bdfeb447a594b8440a0cb62c28227e10f67c83a14bb7d0b8a4aed521b3feeb08' '3c296444967b67291b54784c66c99fdf5820d4fb617f8a2fea64187e247062bc' 'a47c613bd0128ec12dbc100940f355f8749b601c4163ec3e83093e24dc230de6' '1343b07584b78132a5b9defe4af71fb6fe3f9cc0cf8d31a70770c4c294d35e6e')
prepare() {
  cd "$srcdir/morghulis-$pkgver"
  patch --fuzz=0 --forward --strip=1 < "$srcdir/morghulis-dinx-power.patch"
  # Make libgtop optional (removed from Artix repos in 2026)
  sed -i "s/dependency('libgtop-2.0')/dependency('libgtop-2.0', required: false)/" src/meson.build
  # Drop the GTop dependency (libgtop removed from Artix repos in 2026); report
  # uptime from /proc/uptime instead so morghulis builds without libgtop.
  patch --fuzz=0 --forward --strip=1 < "$srcdir/morghulis-dinx-no-libgtop.patch"
  patch --fuzz=0 --forward --strip=1 < "$srcdir/morghulis-dinx-runner-close.patch"
  patch --fuzz=0 --forward --strip=1 < "$srcdir/morghulis-dinx-settings-no-dragon.patch"
  patch --fuzz=0 --forward --strip=1 < "$srcdir/morghulis-dinx-actions.patch"
  patch --fuzz=0 --forward --strip=1 < "$srcdir/morghulis-dinx-river-tags.patch"
  # Exclude SysInfoCmd and SysInfoItem from the build
  sed -i "/'SysInfoCmd.vala',/d" src/Runner/Commands/meson.build
  sed -i "/'SysInfoItem.vala',/d" src/Runner/Commands/meson.build
  # Remove SysInfoItem reference from Main.vala
  sed -i "/typeof(SysInfoItem).ensure();/d" src/Main.vala
  sed -i 's/new SysInfo()/new Gtk.Box(Gtk.Orientation.HORIZONTAL, 0)/' src/Runner/Runner.vala
}

build() {
  cd "$srcdir/morghulis-$pkgver"
  meson setup build --prefix=/usr --libdir=/usr/lib --buildtype=release
  meson compile -C build
}

package() {
  cd "$srcdir/morghulis-$pkgver"
  DESTDIR="$pkgdir" meson install -C build
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

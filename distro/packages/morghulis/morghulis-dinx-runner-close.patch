diff --git a/src/Runner/Commands/AppsCmdButton.vala b/src/Runner/Commands/AppsCmdButton.vala
--- a/src/Runner/Commands/AppsCmdButton.vala
+++ b/src/Runner/Commands/AppsCmdButton.vala
@@ -9,12 +9,33 @@
 
     [GtkCallback]
     public void clicked() {
-        app_launch_handler();
+        launch_and_dismiss();
     }
 
     [GtkCallback]
     public void activated() {
-        app_launch_handler();
+        launch_and_dismiss();
+    }
+
+    private void launch_and_dismiss() {
+        // Launch immediately, keep the selected row highlighted while the
+        // compositor maps the new window, then dismiss the Runner.
+        add_css_class("launching");
+        var display = Gdk.Display.get_default();
+        Gdk.Surface? surface = null;
+        if (display != null) {
+            var cursor = new Gdk.Cursor.from_name("wait", null);
+            surface = Runner.instance.get_surface();
+            if (surface != null) {
+                surface.set_cursor(cursor);
+            }
+        }
+        app_launch_handler();
+        Timeout.add(180, () => {
+            remove_css_class("launching");
+            Runner.instance.visible = false;
+            return Source.REMOVE;
+        });
     }
 
     public AppsCmdButton(AstalApps.Application app, bool is_uwsm_session) {

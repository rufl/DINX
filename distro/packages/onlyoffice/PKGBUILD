pkgname=onlyoffice
source_env="$startdir/source.env"
[[ -r "$source_env" ]] || { printf 'PKGBUILD: missing %s\n' "$source_env" >&2; exit 1; }
. "$source_env"
: "${ONLYOFFICE_VERSION:?missing ONLYOFFICE_VERSION}"
: "${ONLYOFFICE_SOURCE_URL:?missing ONLYOFFICE_SOURCE_URL}"
: "${ONLYOFFICE_SOURCE_SHA256:?missing ONLYOFFICE_SOURCE_SHA256}"
: "${ONLYOFFICE_LICENSE_URL:?missing ONLYOFFICE_LICENSE_URL}"
: "${ONLYOFFICE_LICENSE_SHA256:?missing ONLYOFFICE_LICENSE_SHA256}"
pkgver="$ONLYOFFICE_VERSION"
pkgrel=1
pkgdesc='Desktop editors for documents, spreadsheets, presentations and PDFs'
arch=('x86_64')
url='https://www.onlyoffice.com/desktop'
license=('AGPL-3.0-only')
depends=('glibc' 'nss' 'libxss' 'libxtst' 'xorg-xwayland')
options=('!strip')
source=(
  "DesktopEditors-${pkgver}-x86_64.AppImage::${ONLYOFFICE_SOURCE_URL}"
  "LICENSE::${ONLYOFFICE_LICENSE_URL}"
  'onlyoffice'
  'onlyoffice.desktop'
)
sha256sums=(
  "$ONLYOFFICE_SOURCE_SHA256"
  "$ONLYOFFICE_LICENSE_SHA256"
  '47505526b1cb05da89d0886325e8c6170b431eb12144d0f4b7862e78ec38c52f'
  'a875ee7b929e4b94c89fc3edcfe3204b306ed57def90a7a962908f01de061b04'
)

package() {
  install -Dm755 "$srcdir/DesktopEditors-${pkgver}-x86_64.AppImage" \
    "$pkgdir/opt/onlyoffice/DesktopEditors.AppImage"
  install -Dm755 "$srcdir/onlyoffice" "$pkgdir/usr/bin/onlyoffice"
  install -Dm644 "$srcdir/onlyoffice.desktop" \
    "$pkgdir/usr/share/applications/onlyoffice.desktop"
  install -Dm644 "$srcdir/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/doc/$pkgname/SOURCE" <<EOF
ONLYOFFICE Desktop Editors ${ONLYOFFICE_VERSION} official x86_64 AppImage:
${ONLYOFFICE_SOURCE_URL}

The DINX package redistributes the unmodified upstream AppImage. The launcher
registers document, spreadsheet, presentation and PDF file types only; the
upstream integrated app also contains its Forms and Diagram Viewer features.
EOF
}

#!/bin/sh
set -eu
export PATH="${PATH:+$PATH:}/usr/bin:/bin"
export GTK_THEME=DINX
export GTK_APPLICATION_PREFER_DARK_THEME=1
export QT_QPA_PLATFORMTHEME=qt6ct

config_home="${XDG_CONFIG_HOME:-${HOME:-/nonexistent}/.config}"
onlyoffice_dir="$config_home/onlyoffice"
settings_file="$onlyoffice_dir/DesktopEditorsSettings.conf"
if [ ! -e "$settings_file" ]; then
  mkdir -p "$onlyoffice_dir"
  cat > "$settings_file" << 'EOF'
[General]
theme=dark
EOF
fi

exec /opt/onlyoffice/DesktopEditors.AppImage --appimage-extract-and-run --theme=dark "$@"

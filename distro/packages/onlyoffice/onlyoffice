#!/bin/sh
set -eu
export PATH="${PATH:+$PATH:}/usr/bin:/bin"
export GTK_THEME=DINX
export GTK_APPLICATION_PREFER_DARK_THEME=1
export QT_QPA_PLATFORMTHEME=qt6ct
# Force AppImage type-2 extraction; never attempt a FUSE mount.
export APPIMAGE_EXTRACT_AND_RUN=1

config_home=${XDG_CONFIG_HOME:-}
if [ -z "$config_home" ]; then
    config_home=${HOME:?HOME and XDG_CONFIG_HOME are unset}/.config
fi
/usr/lib/onlyoffice/onlyoffice-force-dark "$config_home/onlyoffice/DesktopEditors.conf"

exec /opt/onlyoffice/DesktopEditors.AppImage --appimage-extract-and-run "$@"

#!/bin/sh
set -eu
export GTK_THEME=DINX
export GTK_APPLICATION_PREFER_DARK_THEME=1

config_home="${XDG_CONFIG_HOME:-}"
if [ -z "$config_home" ] && [ -n "${HOME:-}" ]; then
  config_home="$HOME/.config"
fi
if [ -n "$config_home" ]; then
  settings_dir="$config_home/paintfe"
  settings_file="$settings_dir/paintfe_settings.cfg"
  if [ -L "$settings_file" ]; then
    printf 'paintfe: refusing symlinked settings file: %s\n' "$settings_file" >&2
  else
    mkdir -p -- "$settings_dir"
    if [ ! -e "$settings_file" ]; then
      cat > "$settings_file" <<'EOF'
# PaintFE Theme
theme_mode=dark
theme_preset=midnight
EOF
    fi
  fi
fi

exec /opt/paintfe/AppRun "$@"

pkgname=palemoon
pkgver=35.0.2
pkgrel=1
pkgdesc="Open source web browser built on the Goanna rendering engine"
arch=(x86_64)
url="https://www.palemoon.org/"
license=(MPL-2.0)
depends=(
  alsa-lib
  at-spi2-core
  bash
  cairo
  dbus
  fontconfig
  freetype2
  gdk-pixbuf2
  glib2
  glibc
  gtk3
  hicolor-icon-theme
  libgcc
  libstdc++
  libx11
  libxcb
  libxext
  libxrender
  libxt
  pango
)
optdepends=(
  'ffmpeg: H.264 and HTML5 media support'
  'libpulse: PulseAudio/PipeWire Pulse audio backend'
)
source=(
  "https://rm-us.palemoon.org/release/palemoon-35.0.2.linux-x86_64-gtk3.tar.xz"
  "palemoon.desktop"
)
sha256sums=(
  '3136ee8ecde1c1f865d45c3f5015f07e27e590ae0b43c22f1811f65633547adb'
  '8573c50cdbe75ca1dc65c57c0cc5e500f9bdfe57be9a9d9ee3ebb59f64470f51'
)

package() {
  install -d "${pkgdir}/usr/lib"
  cp -a palemoon "${pkgdir}/usr/lib/palemoon"

  install -d "${pkgdir}/usr/bin"
  ln -s ../lib/palemoon/palemoon "${pkgdir}/usr/bin/palemoon"

  install -Dm644 palemoon/browser/chrome/icons/default/default16.png \
    "${pkgdir}/usr/share/icons/hicolor/16x16/apps/palemoon.png"
  install -Dm644 palemoon/browser/chrome/icons/default/default32.png \
    "${pkgdir}/usr/share/icons/hicolor/32x32/apps/palemoon.png"
  install -Dm644 palemoon/browser/chrome/icons/default/default48.png \
    "${pkgdir}/usr/share/icons/hicolor/48x48/apps/palemoon.png"
  install -Dm644 palemoon/browser/icons/mozicon128.png \
    "${pkgdir}/usr/share/icons/hicolor/128x128/apps/palemoon.png"

  install -Dm644 palemoon.desktop \
    "${pkgdir}/usr/share/applications/palemoon.desktop"
  install -Dm644 palemoon/license.txt \
    "${pkgdir}/usr/share/licenses/${pkgname}/license.txt"
}

pkgname=patchy
source_env="$startdir/source.env"
[[ -r "$source_env" ]] || { printf 'PKGBUILD: missing %s\n' "$source_env" >&2; exit 1; }
. "$source_env"
: "${PATCHY_VERSION:?missing PATCHY_VERSION}"
: "${PATCHY_SOURCE_URL:?missing PATCHY_SOURCE_URL}"
: "${PATCHY_SOURCE_SHA256:?missing PATCHY_SOURCE_SHA256}"
: "${PATCHY_LICENSE_URL:?missing PATCHY_LICENSE_URL}"
: "${PATCHY_LICENSE_SHA256:?missing PATCHY_LICENSE_SHA256}"
pkgver="$PATCHY_VERSION"
pkgrel=1
pkgdesc='PSD-focused image editor with Photoshop-familiar workflows'
arch=('x86_64')
url='https://github.com/SethRobinson/Patchy'
license=('MIT')
depends=('glibc')
source=(
  "PatchyLinux.AppImage::${PATCHY_SOURCE_URL}"
  "LICENSE::${PATCHY_LICENSE_URL}"
  'patchy'
  'patchy.desktop'
)
sha256sums=(
  "$PATCHY_SOURCE_SHA256"
  "$PATCHY_LICENSE_SHA256"
  'SKIP'
  'SKIP'
)

package() {
  install -Dm755 "$srcdir/PatchyLinux.AppImage" \
    "$pkgdir/opt/patchy/PatchyLinux.AppImage"
  install -Dm755 "$srcdir/patchy" "$pkgdir/usr/bin/patchy"
  install -Dm644 "$srcdir/patchy.desktop" \
    "$pkgdir/usr/share/applications/patchy.desktop"
  install -Dm644 "$srcdir/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/doc/$pkgname/SOURCE" <<EOF
Patchy ${pkgver} upstream source and build information:
https://github.com/SethRobinson/Patchy/tree/v${pkgver}

The DINX package redistributes the upstream x86_64 AppImage without modification.
EOF
}

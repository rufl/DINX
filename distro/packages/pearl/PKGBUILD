pkgname=pearl
source_env="$startdir/source.env"
[[ -r "$source_env" ]] || { printf 'PKGBUILD: missing %s\n' "$source_env" >&2; exit 1; }
. "$source_env"
: "${PEARL_VERSION:?missing PEARL_VERSION}"
: "${PEARL_SOURCE_URL:?missing PEARL_SOURCE_URL}"
: "${PEARL_SOURCE_SHA256:?missing PEARL_SOURCE_SHA256}"
pkgver="$PEARL_VERSION"
pkgrel=10
epoch=1
pkgdesc='Pearl GTK desktop shell and Pearl Greeter for direct Aqueous sessions on DINX'
arch=('x86_64')
url="$PEARL_SOURCE_URL"
license=('LicenseRef-Pearl-Unlicensed')
depends=(
  'xdg-desktop-portal'
  'libcups'
  'xdg-utils'
  'glycin'
  'matugen'
  'curl'
  'libarchive'
  'libpng'
  'libxml2'
  'libsecret'
  'gtksourceview5'
  'enchant'
  'hunspell'
  'gtk4>=1:4.22.5'
  'glib2>=2.88.3'
  'gtk4-layer-shell>=1.3.0'
  'libpulse>=17.0'
  'pam>=1.7.2'
  'polkit>=127'
  'glibc>=2.44'
  'wayland>=1.26.0'
  'pango>=1:1.58.2'
  'gdk-pixbuf2>=2.44.7'
  'cairo>=1.18.4'
  'aqueous>=1.0.5'
  'dbus'
  'elogind'
  'greetd'
  'esysusers'
  'deetty'
)
makedepends=(
  'git'
  'zig>=0.16'
  'pkgconf'
  'gcc'
  'qt5-base'
  'qt6-base'
  'python>=3.14'
  'librsvg'
  'gtk4>=1:4.22.5'
)
optdepends=(
  'file-roller: archive context menu actions in Phyto'
  'poppler: PDF first-page previews in Phyto'
  'ffmpeg: video still previews in Phyto'
  'bubblewrap: sandbox for optional previews'
  'qtengine: shared Qt application appearance management'
  'networkmanager: network controls'
  'bluez: Bluetooth controls'
  'upower: battery status'
  'power-profiles-daemon: power profiles'
)
provides=('pearl-capture-picker=0.3.0' 'pearl-greeter=0.3.0')
conflicts=('pearl-git')
options=('!strip' '!debug')
source=("pearl-$pkgver.tar.gz::${PEARL_SOURCE_URL}" "deetty-terminal.patch" "server-decorations.patch" "greeter-state-home.patch" "dinx-first-run-wizard.c")
sha256sums=("$PEARL_SOURCE_SHA256" '96bf34fd3f22d2411eb83d755f82e602fde7c36f37de59746e85818a6d1752c4' 'de543c6c51f6b04bec1437a42fbc497db9eb5c1e3829490f4d63f7c835e8f698' 'f9433c48c1af3c4b9bf95db581b62ab08487fde5ff95ca3f68c08b0581e671f8' 'e0206164c2d447802248062a25a310dd233a26e6c31d40285d608430bc52a550')
install=pearl.install

prepare() {
  cd "$srcdir/pearl-$pkgver"
  patch --fuzz=0 --forward --strip=1 < "$srcdir/deetty-terminal.patch"
  patch --fuzz=0 --forward --strip=1 < "$srcdir/server-decorations.patch"
  patch --fuzz=0 --forward --strip=1 < "$srcdir/greeter-state-home.patch"
}


build() {
  cd "$srcdir/pearl-$pkgver"
  local zig_bin="${ZIG:-zig}"
  local zig_version="$("$zig_bin" version)"
  [[ "$zig_version" == "$PEARL_ZIG_VERSION" ]] || {
    printf 'Pearl %s requires Zig %s, found %s\n' "$pkgver" "$PEARL_ZIG_VERSION" "$zig_version" >&2
    return 1
  }
  export ZIG_GLOBAL_CACHE_DIR="${ZIG_GLOBAL_CACHE_DIR:-$srcdir/zig-global-cache}"
  export ZIG_LOCAL_CACHE_DIR="${ZIG_LOCAL_CACHE_DIR:-$srcdir/zig-local-cache}"
  "${CC:-gcc}" -O2 -Wall -Wextra -Werror \
    $(pkgconf --cflags gtk4) "$srcdir/dinx-first-run-wizard.c" \
    $(pkgconf --libs gtk4) -o "$srcdir/dinx-first-run-wizard"
  "$zig_bin" build install build-greeter -Dqt-themes=true -Doptimize=ReleaseSafe \
    -Drelease=true -Dcpu=baseline -Dwasm-plugins=false
}

check() {
  local bin
  for bin in pearl pearlctl pearl-lock pearl-settings pearl-themes pearl-agent \
    pearl-chooser pearl-preview-helper xdg-desktop-portal-pearl pearl-scheduling-helper; do
    test -x "$srcdir/pearl-$pkgver/zig-out/bin/$bin"
  done
  for bin in pearl-greeter pearl-greeter-session pearl-greeter-host pearl-greeter-sync; do
    test -x "$srcdir/pearl-$pkgver/zig-out/greeter/bin/$bin"
  done
  test -x "$srcdir/dinx-first-run-wizard"
  (
    cd "$srcdir/pearl-$pkgver"
    ZIG_GLOBAL_CACHE_DIR="${ZIG_GLOBAL_CACHE_DIR:-$srcdir/zig-global-cache}" \
      ZIG_LOCAL_CACHE_DIR="${ZIG_LOCAL_CACHE_DIR:-$srcdir/zig-local-cache}" \
      "${ZIG:-zig}" build test -Dcpu=baseline -Doptimize=ReleaseSafe -Drelease=true
  )
}

package() {
  cd "$srcdir/pearl-$pkgver"
  DESTDIR="$pkgdir" PEARL_BINARY_DIR="$PWD/zig-out/bin" \
    bash packaging/install.sh
  install -Dm755 "$srcdir/dinx-first-run-wizard" \
    "$pkgdir/usr/local/libexec/dinx-first-run-wizard"

  local greeter_stage="$srcdir/pearl-greeter-stage"
  rm -rf "$greeter_stage"
  python3 packaging/greeter/stage.py \
    --build "$PWD/zig-out/greeter/bin" \
    --dest "$greeter_stage"

  install -Dm755 "$greeter_stage/usr/bin/pearl-greeter" \
    "$pkgdir/usr/bin/pearl-greeter"
  for bin in pearl-greeter-session pearl-greeter-host; do
    install -Dm755 "$greeter_stage/usr/lib/pearl/$bin" \
      "$pkgdir/usr/lib/pearl/$bin"
  done
  install -Dm755 "$greeter_stage/usr/lib/pearl/pearl-greeter-init" \
    "$pkgdir/usr/lib/pearl/pearl-greeter-init"
  install -Dm644 \
    "$greeter_stage/usr/share/polkit-1/actions/org.aqueous.Pearl.Greeter.Appearance.policy" \
    "$pkgdir/usr/share/polkit-1/actions/org.aqueous.Pearl.Greeter.Appearance.policy"
  install -Dm644 "$greeter_stage/greeter-release-gate.json" \
    "$pkgdir/usr/share/pearl-greeter/release-gate.json"

  # DINX launches Pearl and Pearl Greeter directly through dinit/greetd.
  # Upstream systemd/UWSM lifecycle payloads are never shipped.
  rm -rf "$pkgdir/usr/lib/systemd" "$pkgdir/usr/share/uwsm"
}

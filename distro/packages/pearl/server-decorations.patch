+test "form draft validation rejects invalid colors and accepts the corrected value" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    var prefs: model.Preferences = .{};
+    prefs.theme.seed = "not-a-color";
+    const invalid = try std.json.Stringify.valueAlloc(arena.allocator(), prefs, .{ .whitespace = .indent_2 });
+    try std.testing.expectError(error.InvalidColor, validateFormDraft(arena.allocator(), invalid));
+    prefs.theme.seed = "#6750a4";
+    const corrected = try std.json.Stringify.valueAlloc(arena.allocator(), prefs, .{ .whitespace = .indent_2 });
+    try validateFormDraft(arena.allocator(), corrected);
+}

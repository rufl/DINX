+    const prefs = try parse(a, "{\"window_corner_radius\":24}");
+    try std.testing.expectEqual(@as(u8, 24), prefs.window_corner_radius);
+    try std.testing.expectEqual(@as(u8, 24), (try parse(a, try std.json.Stringify.valueAlloc(a, prefs, .{}))).window_corner_radius);
+    try std.testing.expectError(error.InvalidWindowCornerRadius, parse(a, "{\"window_corner_radius\":33}"));
+}

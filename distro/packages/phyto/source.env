# Manual source pin: Phyto ships as a subproject of the Seafoam-Labs/pearl
# monorepo, which DINX no longer tracks — the Pearl shell itself was retired
# when main moved to River/KWM/Morghulis, but Dome and Phyto are still shipped.
# Pinned to the same 0.3.0 archive as Dome so both apps come from one reviewed
# upstream snapshot, and excluded from the automated refresher for the reason
# recorded in distro/packages/dome/source.env. Bump both together, deliberately.
PHYTO_REPOSITORY=https://github.com/Seafoam-Labs/pearl
PHYTO_VERSION=0.1.1
PHYTO_SOURCE_VERSION=0.3.0
PHYTO_SOURCE_SHA256=afb15f5650cdd0aa00a9d6ee697dec1cde2cb9eaa77b1631e4876c125caba24a

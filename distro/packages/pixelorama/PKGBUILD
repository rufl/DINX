pkgname=pixelorama
source_env="$startdir/source.env"
[[ -r "$source_env" ]] || { printf 'PKGBUILD: missing %s\n' "$source_env" >&2; exit 1; }
. "$source_env"
: "${PIXELORAMA_VERSION:?missing PIXELORAMA_VERSION}"
: "${PIXELORAMA_SOURCE_URL:?missing PIXELORAMA_SOURCE_URL}"
: "${PIXELORAMA_SOURCE_SHA256:?missing PIXELORAMA_SOURCE_SHA256}"
: "${PIXELORAMA_LICENSE_URL:?missing PIXELORAMA_LICENSE_URL}"
: "${PIXELORAMA_LICENSE_SHA256:?missing PIXELORAMA_LICENSE_SHA256}"
: "${PIXELORAMA_ICON_URL:?missing PIXELORAMA_ICON_URL}"
: "${PIXELORAMA_ICON_SHA256:?missing PIXELORAMA_ICON_SHA256}"
: "${PIXELORAMA_MIME_URL:?missing PIXELORAMA_MIME_URL}"
: "${PIXELORAMA_MIME_SHA256:?missing PIXELORAMA_MIME_SHA256}"
pkgver="$PIXELORAMA_VERSION"
pkgrel=1
pkgdesc='Pixel art and animation editor'
arch=('x86_64')
url='https://github.com/Orama-Interactive/Pixelorama'
license=('MIT')
depends=('glibc')
options=('!strip')
source=(
  "Pixelorama-Linux-64bit.tar.gz::${PIXELORAMA_SOURCE_URL}"
  "LICENSE::${PIXELORAMA_LICENSE_URL}"
  "icon.png::${PIXELORAMA_ICON_URL}"
  "com.orama_interactive.Pixelorama.xml::${PIXELORAMA_MIME_URL}"
  'pixelorama'
  'pixelorama.desktop'
)
sha256sums=(
  "$PIXELORAMA_SOURCE_SHA256"
  "$PIXELORAMA_LICENSE_SHA256"
  "$PIXELORAMA_ICON_SHA256"
  "$PIXELORAMA_MIME_SHA256"
  'c2943eb4604ac629e9030f353b261ad6836b99b833dc679e82f84839eb5aabbb'
  '0a777e23313d6c0c33343b4abeca0ea56a2a74c5eddd056b6d65305b3e6ed7c5'
)

package() {
  local app_dir="$srcdir/Pixelorama-Linux-64bit"
  [[ -x "$app_dir/Pixelorama.x86_64" ]] || { printf 'Pixelorama executable is missing from upstream archive\n' >&2; return 1; }
  [[ -r "$app_dir/Pixelorama.pck" ]] || { printf 'Pixelorama resource pack is missing from upstream archive\n' >&2; return 1; }
  install -d "$pkgdir/opt/pixelorama"
  cp -a "$app_dir/." "$pkgdir/opt/pixelorama/"
  install -Dm755 "$srcdir/pixelorama" "$pkgdir/usr/bin/pixelorama"
  install -Dm644 "$srcdir/pixelorama.desktop" \
    "$pkgdir/usr/share/applications/com.orama_interactive.Pixelorama.desktop"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/icon.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/pixelorama.png"
  install -Dm644 "$srcdir/com.orama_interactive.Pixelorama.xml" \
    "$pkgdir/usr/share/mime/packages/com.orama_interactive.Pixelorama.xml"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/doc/$pkgname/SOURCE" <<EOF
Pixelorama ${pkgver} upstream source and build information:
https://github.com/Orama-Interactive/Pixelorama/tree/v${pkgver}

The DINX package redistributes the official Linux x86_64 release archive.
EOF
}

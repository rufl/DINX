@@ -61,7 +61,7 @@ pub fn remove(parent: *gtk.Window, unit_name: []const u8, reporter: Reporter) void {
     dialogs.showConfirm(parent, .{
         .title = "Remove mount unit",
         .body = ui.zFmt(

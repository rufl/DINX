# This pin is coupled to pori-dinit.patch: the patch rewrites Pori.Ui sources to
# use dinit mount services, and no static gate applies it (Pori's source is not
# vendored, unlike Deetty's), so a version bump that moves those sources would
# only fail during the P0 build. Verify `patch --fuzz=0` still applies before
# accepting an automated bump, and regenerate the patch if it does not.
PORI_REPOSITORY=https://github.com/Seafoam-Labs/Pori
PORI_VERSION=0.2.0
PORI_SOURCE_SHA256=34ca896f1514978473985af30f32168de2407f73a17cc84a780248ab7cb17350

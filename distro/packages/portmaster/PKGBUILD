pkgname=portmaster
source_env="$startdir/source.env"
[[ -r "$source_env" ]] || { printf 'PKGBUILD: missing %s\n' "$source_env" >&2; exit 1; }
. "$source_env"
: "${PORTMASTER_VERSION:?missing PORTMASTER_VERSION}"
: "${PORTMASTER_APP_SOURCE_URL:?missing PORTMASTER_APP_SOURCE_URL}"
: "${PORTMASTER_APP_SOURCE_SHA256:?missing PORTMASTER_APP_SOURCE_SHA256}"
: "${PORTMASTER_CORE_SOURCE_URL:?missing PORTMASTER_CORE_SOURCE_URL}"
: "${PORTMASTER_CORE_SOURCE_SHA256:?missing PORTMASTER_CORE_SOURCE_SHA256}"
: "${PORTMASTER_UI_SOURCE_URL:?missing PORTMASTER_UI_SOURCE_URL}"
: "${PORTMASTER_UI_SOURCE_SHA256:?missing PORTMASTER_UI_SOURCE_SHA256}"
: "${PORTMASTER_ASSETS_SOURCE_URL:?missing PORTMASTER_ASSETS_SOURCE_URL}"
: "${PORTMASTER_ASSETS_SOURCE_SHA256:?missing PORTMASTER_ASSETS_SOURCE_SHA256}"
: "${PORTMASTER_LICENSE_SOURCE_URL:?missing PORTMASTER_LICENSE_SOURCE_URL}"
: "${PORTMASTER_LICENSE_SOURCE_SHA256:?missing PORTMASTER_LICENSE_SOURCE_SHA256}"
pkgver="$PORTMASTER_VERSION"
pkgrel=1
pkgdesc='Application firewall and network privacy suite'
arch=('x86_64')
url='https://safing.io/portmaster'
license=('GPL-3.0-only')
depends=('cairo' 'desktop-file-utils' 'gdk-pixbuf2' 'glib2' 'gtk3' 'hicolor-icon-theme' 'libappindicator-gtk3' 'libsoup' 'pango' 'webkit2gtk-4.1' 'iptables' 'polkit' 'dinit')
options=('!strip' '!emptydirs')
source=(
  "portmaster::${PORTMASTER_APP_SOURCE_URL}"
  "portmaster-core::${PORTMASTER_CORE_SOURCE_URL}"
  "portmaster.zip::${PORTMASTER_UI_SOURCE_URL}"
  "assets.zip::${PORTMASTER_ASSETS_SOURCE_URL}"
  "LICENSE::${PORTMASTER_LICENSE_SOURCE_URL}"
  'dinx-portmaster'
  'dinx-portmaster-core-service'
  'portmaster-dinit'
  'portmaster.desktop'
)
sha256sums=(
  "$PORTMASTER_APP_SOURCE_SHA256"
  "$PORTMASTER_CORE_SOURCE_SHA256"
  "$PORTMASTER_UI_SOURCE_SHA256"
  "$PORTMASTER_ASSETS_SOURCE_SHA256"
  "$PORTMASTER_LICENSE_SOURCE_SHA256"
  'b460a26a1a3fc59fddff7de6da8c026154260f93c9decedc5aa38798e9a0f9d7'
  '2ce82bb3397244f1add407d989deada5147ad7e0847660b848c550d2b5eb556f'
  'e18c99e0220810a40a477b280f6fd6aaa02e23413fe096e95b1e0906ed7149e4'
  '12b7f188aae32f90be0d3cabefd045e4f737847b710af33d704f52ed223e50ba'
)

package() {
  install -Dm755 "$srcdir/portmaster" "$pkgdir/usr/lib/portmaster/portmaster"
  install -Dm755 "$srcdir/portmaster-core" "$pkgdir/usr/lib/portmaster/portmaster-core"
  install -Dm644 "$srcdir/portmaster.zip" "$pkgdir/usr/lib/portmaster/portmaster.zip"
  install -Dm644 "$srcdir/assets.zip" "$pkgdir/usr/lib/portmaster/assets.zip"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm755 "$srcdir/dinx-portmaster" "$pkgdir/usr/bin/portmaster"
  install -Dm755 "$srcdir/dinx-portmaster-core-service" \
    "$pkgdir/usr/local/libexec/dinx-portmaster-core-service"
  install -Dm644 "$srcdir/portmaster-dinit" "$pkgdir/etc/dinit.d/portmaster"
  install -Dm644 "$srcdir/portmaster.desktop" \
    "$pkgdir/usr/share/applications/portmaster.desktop"
  install -d -m700 "$pkgdir/var/lib/portmaster/log"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/doc/$pkgname/SOURCE" <<EOF
Portmaster ${pkgver} upstream source:
https://github.com/safing/portmaster/tree/v${pkgver}

DINX redistributes Safing's official Linux x86_64 application and core binaries,
plus the versioned UI and asset modules. The package does not start the core
service automatically; open Portmaster to start the Dinit service on demand.
EOF
}

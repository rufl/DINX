pkgname=scenefx
pkgver=0.5
_commit=37ccd723bef49e6891156ffafce8f549f01446cc
pkgrel=1
pkgdesc="A drop-in replacement for the wlroots scene API with visual effects"
url="https://github.com/wlrfx/scenefx"
arch=(x86_64)
license=(MIT)
depends=(glibc lcms2 libdrm libglvnd libxkbcommon mesa pixman wayland wlroots0.20)
makedepends=(glslang meson wayland-protocols)
source=("$pkgname-$pkgver.tar.gz::https://github.com/wlrfx/scenefx/archive/$_commit.tar.gz")
sha256sums=('7f595ead422fa12c1aae2af65402d1cf78ac6a8726cfb5a511b208a788981e13')

build() {
  meson setup build "$srcdir/$pkgname-$_commit" --prefix=/usr --buildtype=plain
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir="$pkgdir"
  install -Dm644 "$srcdir/$pkgname-$_commit/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

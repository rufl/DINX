pkgname=scenefx
pkgver=0.5
pkgrel=1
pkgdesc="A drop-in replacement for the wlroots scene API with visual effects"
url="https://github.com/wlrfx/scenefx"
arch=(x86_64)
license=(MIT)
depends=(glibc lcms2 libdrm libglvnd libxkbcommon mesa pixman wayland wlroots0.20)
makedepends=(glslang meson wayland-protocols)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('0fa8ecca0e310f813efd052624c5ed7d9153d6a0fdead5cc957d34c07f9a86c')

build() {
  meson setup build "$srcdir/$pkgname-$pkgver" --prefix=/usr --buildtype=plain
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir="$pkgdir"
  install -Dm644 "$srcdir/$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

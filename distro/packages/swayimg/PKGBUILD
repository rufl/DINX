pkgname=swayimg
source_env="$startdir/source.env"
[[ -r "$source_env" ]] || { printf 'PKGBUILD: missing %s\n' "$source_env" >&2; exit 1; }
. "$source_env"
: "${SWAYIMG_VERSION:?missing SWAYIMG_VERSION}"
: "${SWAYIMG_SOURCE_URL:?missing SWAYIMG_SOURCE_URL}"
: "${SWAYIMG_SOURCE_SHA256:?missing SWAYIMG_SOURCE_SHA256}"
pkgver="$SWAYIMG_VERSION"
pkgrel=2
pkgdesc="A lightweight image viewer for Wayland display servers"
arch=(x86_64)
url="https://github.com/artemsen/swayimg"
license=(MIT)
depends=(
  cairo
  fontconfig
  freetype2
  glib2
  hicolor-icon-theme
  libjpeg-turbo
  libpng
  libxkbcommon
  luajit
  wayland
)
makedepends=(
  bash-completion
  meson
  ninja
  wayland-protocols
)
source=(
  "swayimg-${pkgver}.tar.gz::${SWAYIMG_SOURCE_URL}"
)
sha256sums=("$SWAYIMG_SOURCE_SHA256")

build() {
  meson setup build "${srcdir}/${pkgname}-${pkgver}" \
    --prefix=/usr \
    --buildtype=plain \
    -Davif=disabled \
    -Dbash=enabled \
    -Dcompositor=enabled \
    -Ddesktop=true \
    -Ddrm=disabled \
    -Dexif=disabled \
    -Dexr=disabled \
    -Dgif=disabled \
    -Dheif=disabled \
    -Djpeg=enabled \
    -Djp2=disabled \
    -Djxl=disabled \
    -Dman=true \
    -Dpng=enabled \
    -Draw=disabled \
    -Dsixel=disabled \
    -Dsvg=disabled \
    -Dtests=disabled \
    -Dtiff=disabled \
    -Dversion="${pkgver}" \
    -Dvideo=disabled \
    -Dwebp=disabled \
    -Dwayland=enabled \
    -Dzsh=disabled
  meson compile -C build
}

package() {
  meson install -C build --destdir="${pkgdir}"
  install -Dm644 "${srcdir}/${pkgname}-${pkgver}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

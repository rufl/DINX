pkgname=topgrade
pkgver=17.12.3
pkgrel=1
pkgdesc='Upgrade Artix systems and their user-selected tools'
arch=('x86_64')
url='https://github.com/topgrade-rs/topgrade'
license=('GPL-3.0-or-later')
provides=('topgrade')
depends=('libgcc')
makedepends=('cargo')
source=("topgrade-${pkgver}.tar.gz::https://github.com/topgrade-rs/topgrade/archive/refs/tags/v${pkgver}.tar.gz")
b2sums=('4a4fe41e6c030a33d44690c603838d2f95ccc09a17a1ed8679f29c6f629a1d95a689f3cafaf533b716732bfb7d2c2e8d84816df8ef65dab445ab09183a623bca')

prepare() {
  cd "$srcdir/topgrade-$pkgver"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's|host: ||p')"
}

build() {
  cd "$srcdir/topgrade-$pkgver"
  cargo build --frozen --release
}

package() {
  cd "$srcdir/topgrade-$pkgver"
  install -Dm755 target/release/topgrade "$pkgdir/usr/bin/topgrade"

  ./target/release/topgrade --gen-manpage | sed 's/.TH Topgrade 1/.TH Topgrade 8/' >"$srcdir/topgrade.8"
  install -Dm644 "$srcdir/topgrade.8" "$pkgdir/usr/share/man/man8/topgrade.8"

  ./target/release/topgrade --gen-completion bash >"$srcdir/topgrade.bash"
  install -Dm644 "$srcdir/topgrade.bash" "$pkgdir/usr/share/bash-completion/completions/topgrade"

  ./target/release/topgrade --gen-completion zsh >"$srcdir/topgrade.zsh"
  install -Dm644 "$srcdir/topgrade.zsh" "$pkgdir/usr/share/zsh/site-functions/_topgrade"
}

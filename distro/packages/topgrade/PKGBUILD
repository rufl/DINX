pkgname=topgrade
source_env="$startdir/source.env"
[[ -r "$source_env" ]] || { printf 'PKGBUILD: missing %s\n' "$source_env" >&2; exit 1; }
. "$source_env"
: "${TOPGRADE_VERSION:?missing TOPGRADE_VERSION}"
: "${TOPGRADE_SOURCE_URL:?missing TOPGRADE_SOURCE_URL}"
: "${TOPGRADE_SOURCE_B2:?missing TOPGRADE_SOURCE_B2}"
pkgver="$TOPGRADE_VERSION"
pkgrel=1
pkgdesc='Upgrade Artix systems and their user-selected tools'
arch=('x86_64')
url='https://github.com/topgrade-rs/topgrade'
license=('GPL-3.0-or-later')
provides=('topgrade')
source_x86_64=("topgrade_x86_64-${pkgver}.tar.gz::${TOPGRADE_SOURCE_URL}")
b2sums_x86_64=("$TOPGRADE_SOURCE_B2")

depends=('libgcc')

package() {
  install -Dm755 topgrade "$pkgdir/usr/bin/topgrade"

  ./topgrade --gen-manpage | sed 's/.TH Topgrade 1/.TH Topgrade 8/' >topgrade.8
  install -Dm644 topgrade.8 "$pkgdir/usr/share/man/man8/topgrade.8"

  ./topgrade --gen-completion bash >topgrade.bash
  install -Dm644 topgrade.bash "$pkgdir/usr/share/bash-completion/completions/topgrade"

  ./topgrade --gen-completion zsh >topgrade.zsh
  install -Dm644 topgrade.zsh "$pkgdir/usr/share/zsh/site-functions/_topgrade"
}

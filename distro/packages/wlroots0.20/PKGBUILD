pkgname=wlroots0.20
pkgver=0.20.2
pkgrel=1
pkgdesc="Modular Wayland compositor library"
url="https://gitlab.freedesktop.org/wlroots/wlroots"
license=(MIT)
arch=(x86_64)
depends=(
  glibc
  libdisplay-info.so
  libdrm
  libglvnd
  libinput
  liblcms2.so
  libliftoff.so
  libpixman-1.so
  libseat.so
  libudev.so
  libwayland-client.so
  libwayland-server.so
  libxcb
  libxkbcommon.so
  wayland-protocols
  xcb-util-errors
  xcb-util-renderutil
  xcb-util-wm
)
makedepends=(glslang meson)
source=("$pkgname-$pkgver.tar.gz::https://gitlab.freedesktop.org/wlroots/wlroots/-/archive/$pkgver/wlroots-$pkgver.tar.gz")
sha256sums=('972c7ac44b17828f4702bfae7cd8347346a3fb5b2c1076cfa2c3fcedac5ec343')

build() {
  meson setup build "$srcdir/wlroots-$pkgver" \
    --prefix=/usr \
    --buildtype=plain \
    -Dexamples=false \
    -Drenderers=gles2 \
    -Dxwayland=enabled \
    -Dxcb-errors=enabled \
    -Dsession=enabled
  meson compile -C build
}

package() {
  meson install -C build --destdir="$pkgdir"
  install -Dm644 "$srcdir/wlroots-$pkgver/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

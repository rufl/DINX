pkgname=wordcraft
source_env="$startdir/source.env"
[[ -r "$source_env" ]] || { printf 'PKGBUILD: missing %s\n' "$source_env" >&2; exit 1; }
. "$source_env"
: "${WORDCRAFT_VERSION:?missing WORDCRAFT_VERSION}"
: "${WORDCRAFT_SOURCE_URL:?missing WORDCRAFT_SOURCE_URL}"
: "${WORDCRAFT_SOURCE_SHA256:?missing WORDCRAFT_SOURCE_SHA256}"
: "${WORDCRAFT_LICENSE_MIT_URL:?missing WORDCRAFT_LICENSE_MIT_URL}"
: "${WORDCRAFT_LICENSE_MIT_SHA256:?missing WORDCRAFT_LICENSE_MIT_SHA256}"
: "${WORDCRAFT_LICENSE_APACHE_URL:?missing WORDCRAFT_LICENSE_APACHE_URL}"
: "${WORDCRAFT_LICENSE_APACHE_SHA256:?missing WORDCRAFT_LICENSE_APACHE_SHA256}"
: "${WORDCRAFT_ICON_URL:?missing WORDCRAFT_ICON_URL}"
: "${WORDCRAFT_ICON_SHA256:?missing WORDCRAFT_ICON_SHA256}"
pkgver="${WORDCRAFT_VERSION}"
pkgrel=1
pkgdesc="Fast, open-source word processor rebuilt in pure Rust"
arch=('x86_64')
url='https://github.com/storytold/wordcraft'
license=('MIT' 'Apache-2.0')
depends=('glibc' 'gcc-libs')
options=('!strip')
source=(
  "wordcraft-${pkgver}-x86_64.AppImage::${WORDCRAFT_SOURCE_URL}"
  "LICENSE-MIT::${WORDCRAFT_LICENSE_MIT_URL}"
  "LICENSE-APACHE::${WORDCRAFT_LICENSE_APACHE_URL}"
  "wordcraft-256.png::${WORDCRAFT_ICON_URL}"
  'wordcraft'
  'wordcraft.desktop'
)
sha256sums=(
  "${WORDCRAFT_SOURCE_SHA256}"
  "${WORDCRAFT_LICENSE_MIT_SHA256}"
  "${WORDCRAFT_LICENSE_APACHE_SHA256}"
  "${WORDCRAFT_ICON_SHA256}"
  '5ee7e9f18f3335c2e76924b55fd4dfb144125216c59d6ff29388bfe757e28fdb'
  'c7334841f79e465ff91527c23aa74dc543c875ec3b6fc0980e4a619a84de8af0'
)

package() {
  install -Dm755 "$srcdir/wordcraft-${pkgver}-x86_64.AppImage" \
    "$pkgdir/opt/wordcraft/wordcraft.AppImage"
  install -Dm755 "$srcdir/wordcraft" "$pkgdir/usr/bin/wordcraft"
  install -Dm644 "$srcdir/wordcraft.desktop" \
    "$pkgdir/usr/share/applications/wordcraft.desktop"
  install -Dm644 "$srcdir/LICENSE-MIT" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 "$srcdir/LICENSE-APACHE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
  install -Dm644 "$srcdir/wordcraft-256.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/wordcraft.png"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/doc/$pkgname/SOURCE" <<EOF
WordCraft ${pkgver} upstream source and build information:
https://github.com/storytold/wordcraft/tree/v${pkgver}

The DINX package redistributes the upstream x86_64 AppImage without modification.
EOF
}

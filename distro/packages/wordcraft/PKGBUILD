pkgname=wordcraft
source_env="$startdir/source.env"
[[ -r "$source_env" ]] || { printf 'PKGBUILD: missing %s\n' "$source_env" >&2; exit 1; }
. "$source_env"
: "${WORDCRAFT_VERSION:?missing WORDCRAFT_VERSION}"
: "${WORDCRAFT_SOURCE_URL:?missing WORDCRAFT_SOURCE_URL}"
: "${WORDCRAFT_SOURCE_SHA256:?missing WORDCRAFT_SOURCE_SHA256}"
pkgver="${WORDCRAFT_VERSION}"
pkgrel=1
pkgdesc="Fast, open-source word processor rebuilt in pure Rust"
arch=('x86_64')
url='https://github.com/storytold/wordcraft'
license=('MIT' 'Apache-2.0')
depends=('glibc' 'gcc-libs')
options=('!strip')
source=(
  "wordcraft-${pkgver}-x86_64.AppImage::${WORDCRAFT_SOURCE_URL}"
  'wordcraft'
  'wordcraft.desktop'
)
sha256sums=(
  "${WORDCRAFT_SOURCE_SHA256}"
  '5ee7e9f18f3335c2e76924b55fd4dfb144125216c59d6ff29388bfe757e28fdb'
  'c7334841f79e465ff91527c23aa74dc543c875ec3b6fc0980e4a619a84de8af0'
)

package() {
  install -Dm755 "$srcdir/wordcraft-${pkgver}-x86_64.AppImage" \
    "$pkgdir/opt/wordcraft/wordcraft.AppImage"
  install -Dm755 "$srcdir/wordcraft" "$pkgdir/usr/bin/wordcraft"
  install -Dm644 "$srcdir/wordcraft.desktop" \
    "$pkgdir/usr/share/applications/wordcraft.desktop"
}

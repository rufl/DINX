pkgname=zenkai
source_env="$startdir/source.env"
[[ -r "$source_env" ]] || { printf 'PKGBUILD: missing %s\n' "$source_env" >&2; exit 1; }
. "$source_env"
: "${ZENKAI_VERSION:?missing ZENKAI_VERSION}"
: "${ZENKAI_SOURCE_URL:?missing ZENKAI_SOURCE_URL}"
: "${ZENKAI_SOURCE_SHA256:?missing ZENKAI_SOURCE_SHA256}"
: "${ZENKAI_LICENSE_URL:?missing ZENKAI_LICENSE_URL}"
: "${ZENKAI_LICENSE_SHA256:?missing ZENKAI_LICENSE_SHA256}"
pkgver="${ZENKAI_VERSION}"
pkgrel=2
pkgdesc="Fast app launcher written in Zig"
arch=('x86_64')
url='https://github.com/dayvster/zenkai'
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs')
options=('!strip')
source=(
  "zenkai-${pkgver}-x86_64.AppImage::${ZENKAI_SOURCE_URL}"
  "LICENCE.md::${ZENKAI_LICENSE_URL}"
  'zenkai'
  'zenkai.desktop'
)
sha256sums=(
  "${ZENKAI_SOURCE_SHA256}"
  "${ZENKAI_LICENSE_SHA256}"
  '513ba619758fc5684f54ebf270ff0481daa7532e3c6222e3f25a2318bde2542b'
  '7fbfc0549a4c09da1b992cb4cd6546e53b2c139773b02a8d719f8d9bdde6ef6e'
)

package() {
  bash "$startdir/../../../scripts/lib/repack-appimage.sh" \
    "$srcdir/zenkai-${pkgver}-x86_64.AppImage" "$pkgdir/opt/zenkai" --strip --trim-locales
  install -Dm755 "$srcdir/zenkai" "$pkgdir/usr/bin/zenkai"
  install -Dm644 "$srcdir/zenkai.desktop" \
    "$pkgdir/usr/share/applications/zenkai.desktop"
  install -Dm644 "$srcdir/LICENCE.md" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENCE.md"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/doc/$pkgname/SOURCE" <<EOF
Zenkai ${pkgver} upstream source and build information:
https://github.com/dayvster/zenkai/tree/v${pkgver}

The DINX package repacks the upstream x86_64 AppImage as a pre-extracted tree
(ELF stripped, locales trimmed to en/pt) so launches never extract into tmpfs.
EOF
}

pkgname=zenkai
source_env="$startdir/source.env"
[[ -r "$source_env" ]] || { printf 'PKGBUILD: missing %s\n' "$source_env" >&2; exit 1; }
. "$source_env"
: "${ZENKAI_VERSION:?missing ZENKAI_VERSION}"
: "${ZENKAI_SOURCE_URL:?missing ZENKAI_SOURCE_URL}"
: "${ZENKAI_SOURCE_SHA256:?missing ZENKAI_SOURCE_SHA256}"
pkgver="${ ZENKAI_VERSION }"
pkgrel=1
pkgdesc="Fast app launcher written in Zig"
arch=('x86_64')
url='https://github.com/'
license=('MIT')
depends=('glibc' 'gcc-libs')
options=('!strip')
source=(
  "zenkai-${pkgver}-x86_64.AppImage::${ ZENKAI_SOURCE_URL }"
  'zenkai'
  'zenkai.desktop'
)
sha256sums=(
  "${ ZENKAI_SOURCE_SHA256 }"
  'SKIP'
  'SKIP'
)

package() {
  install -Dm755 "$srcdir/zenkai-${pkgver}-x86_64.AppImage" \
    "$pkgdir/opt/zenkai/zenkai.AppImage"
  install -Dm755 "$srcdir/zenkai" "$pkgdir/usr/bin/zenkai"
  install -Dm644 "$srcdir/zenkai.desktop" \
    "$pkgdir/usr/share/applications/zenkai.desktop"
}

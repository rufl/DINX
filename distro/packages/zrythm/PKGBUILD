pkgname=zrythm
source_env="$startdir/source.env"
[[ -r "$source_env" ]] || { printf 'PKGBUILD: missing %s\n' "$source_env" >&2; exit 1; }
. "$source_env"
: "${ZRYTHM_VERSION:?missing ZRYTHM_VERSION}"
: "${ZRYTHM_SOURCE_URL:?missing ZRYTHM_SOURCE_URL}"
: "${ZRYTHM_SOURCE_SHA256:?missing ZRYTHM_SOURCE_SHA256}"
: "${ZRYTHM_LICENSE_URL:?missing ZRYTHM_LICENSE_URL}"
: "${ZRYTHM_LICENSE_SHA256:?missing ZRYTHM_LICENSE_SHA256}"
: "${ZRYTHM_TRADEMARKS_URL:?missing ZRYTHM_TRADEMARKS_URL}"
: "${ZRYTHM_TRADEMARKS_SHA256:?missing ZRYTHM_TRADEMARKS_SHA256}"
pkgver="${ZRYTHM_VERSION//-/}"
pkgrel=1
pkgdesc='Digital audio workstation for music production'
arch=('x86_64')
url='https://www.zrythm.org/'
license=('AGPL-3.0-or-later')
depends=('alsa-lib' 'glibc' 'xorg-xwayland')
options=('!strip')
source=(
  "Zrythm-${ZRYTHM_VERSION}-Linux-x86_64.AppImage::${ZRYTHM_SOURCE_URL}"
  "LicenseRef-ZrythmLicense.txt::${ZRYTHM_LICENSE_URL}"
  "TRADEMARKS.md::${ZRYTHM_TRADEMARKS_URL}"
  'zrythm'
  'zrythm.desktop'
)
sha256sums=(
  "$ZRYTHM_SOURCE_SHA256"
  "$ZRYTHM_LICENSE_SHA256"
  "$ZRYTHM_TRADEMARKS_SHA256"
  '7d37bf860521f2426091b2e965941b856126791dac955fd05ffd50f20b40c744'
  '9f66952396f3efc587dc7ac3b34e619d6ef399aa1a336a7dd8c71d3145ba03ca'
)

package() {
  install -Dm755 "$srcdir/Zrythm-${ZRYTHM_VERSION}-Linux-x86_64.AppImage" \
    "$pkgdir/opt/zrythm/Zrythm.AppImage"
  install -Dm755 "$srcdir/zrythm" "$pkgdir/usr/bin/zrythm"
  install -Dm644 "$srcdir/zrythm.desktop" \
    "$pkgdir/usr/share/applications/zrythm.desktop"
  install -Dm644 "$srcdir/LicenseRef-ZrythmLicense.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/LicenseRef-ZrythmLicense.txt"
  install -Dm644 "$srcdir/TRADEMARKS.md" \
    "$pkgdir/usr/share/licenses/$pkgname/TRADEMARKS.md"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/doc/$pkgname/SOURCE" <<EOF
Zrythm ${ZRYTHM_VERSION} official Linux AppImage:
${ZRYTHM_SOURCE_URL}

The DINX package redistributes the unmodified upstream AppImage. Corresponding
source: https://gitlab.zrythm.org/zrythm/zrythm/-/tree/v${ZRYTHM_VERSION}
Zrythm v2 is pre-release software; projects are not compatible with v1, and
upstream warns of possible crashes or data loss.
EOF
}

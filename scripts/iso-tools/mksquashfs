#!/usr/bin/env bash
set -euo pipefail

real_mksquashfs=${DINX_MKSQUASHFS_REAL:-/usr/bin/mksquashfs}
[[ -x "$real_mksquashfs" ]] || {
  printf 'dinx mksquashfs wrapper: missing %s\n' "$real_mksquashfs" >&2
  exit 127
}

filtered=()
while (($#)); do
  case "$1" in
    -comp|-b|-Xbcj|-Xcompression-level|-Xdict-size)
      (($# >= 2)) || {
        printf 'dinx mksquashfs wrapper: option %s needs a value\n' "$1" >&2
        exit 2
      }
      shift 2
      ;;
    -comp=*|-b=*|-Xbcj=*|-Xcompression-level=*|-Xdict-size=*)
      shift
      ;;
    *)
      filtered+=("$1")
      shift
      ;;
  esac
done

# Keep linux-headers available for Artix initramfs generation, but omit build-only
# source/cache/log payloads from the final SquashFS image.
exec "$real_mksquashfs" "${filtered[@]}" \
  -comp xz \
  -b 1M \
  -Xbcj x86 \
  -Xdict-size 1M \
  -wildcards \
  -e 'usr/src/linux*' 'var/cache/pacman/pkg/*' 'var/log/*'

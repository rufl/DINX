#!/usr/bin/env bash
set -euo pipefail

if [[ -x /usr/local/libexec/dinx-mksquashfs.real ]]; then
  real_mksquashfs=${DINX_MKSQUASHFS_REAL:-/usr/local/libexec/dinx-mksquashfs.real}
else
  real_mksquashfs=${DINX_MKSQUASHFS_REAL:-/usr/bin/mksquashfs}
fi
[[ -x "$real_mksquashfs" ]] || {
  printf 'dinx mksquashfs wrapper: missing %s\n' "$real_mksquashfs" >&2
  exit 127
}
wrapper_path=$(readlink -f "$0")
real_path=$(readlink -f "$real_mksquashfs")
[[ "$wrapper_path" != "$real_path" ]] || {
  printf 'dinx mksquashfs wrapper: real binary resolves to the wrapper itself\n' >&2
  exit 125
}

source_root=${1:-}
if [[ -d "$source_root" ]]; then
  source_root=$(CDPATH= cd -- "$source_root" && pwd -P)
fi

filtered=()
while (($#)); do
  case "$1" in
    -comp|-b|-Xbcj|-Xcompression-level|-Xdict-size)
      (($# >= 2)) || {
        printf 'dinx mksquashfs wrapper: option %s needs a value\n' "$1" >&2
        exit 2
      }
      shift 2
      ;;
    -comp=*|-b=*|-Xbcj=*|-Xcompression-level=*|-Xdict-size=*)
      shift
      ;;
    *)
      filtered+=("$1")
      shift
      ;;
  esac
done

# Artix needs headers to generate initramfs images; build-only headers and
# explicitly excluded package roots are removed from DINX's final rootfs/livefs.
remove_orphaned_vi_compat_entries() {
  local root=$1
  local vim_path="$root/usr/bin/vim"
  local name path target

  [[ ! -e "$vim_path" ]] || return 0
  for name in vi ex vedit view; do
    path="$root/usr/bin/$name"
    [[ -e "$path" || -L "$path" ]] || continue
    if [[ -L "$path" ]]; then
      target=$(readlink -- "$path") || return 1
      [[ "$target" == vim || "$target" == /usr/bin/vim ]] || continue
    elif [[ "$name" == vi && -f "$path" ]] \
      && grep -Fqx '#!/usr/bin/bash' "$path" \
      && grep -Fq 'exec /usr/bin/vim -C -u ' "$path"; then
      :
    else
      continue
    fi

    rm -f -- "$path" || {
      printf 'dinx mksquashfs wrapper: cannot remove orphaned Vim compatibility entry %s\n' "$path" >&2
      return 1
    }
    printf 'dinx-final-squashfs: removed orphaned Vim compatibility entry path=%s\n' "$path"
  done
}

prune_excluded_packages() {
  local root=$1
  local local_db="$root/var/lib/pacman/local"
  local -a removable_packages=()
  local -a prune_candidates=(
    breeze
    breeze-cursors
    plasma-integration
    plasma-workspace
    qogir-icon-theme
    qqc2-breeze-style
    xdg-desktop-portal-kde
    dhcpcd
    dhcpcd-dinit
    ex-vi-compat
    vim
    vim-runtime
    man-db
    man-pages
    texinfo
  )
  local -a package_records
  local package
  local pacman_config

  [[ "$root" != / && -d "$local_db" ]] || return 0
  # Pacman local records are <name>-<numeric-version>-<release>; avoid prefix matches such as breeze-icons.

  package_records=("$local_db"/linux-headers-[0-9]*)
  if [[ -d "${package_records[0]}" ]]; then
    removable_packages+=(linux-headers)
    package_records=("$local_db"/pahole-[0-9]*)
    [[ ! -d "${package_records[0]}" ]] || removable_packages+=(pahole)
  fi

  for package in "${prune_candidates[@]}"; do
    package_records=("$local_db"/"$package"-[0-9]*)
    [[ ! -d "${package_records[0]}" ]] || removable_packages+=("$package")
  done
  if ((${#removable_packages[@]} == 0)); then
    remove_orphaned_vi_compat_entries "$root"
    return
  fi

  pacman_config=$(mktemp "${TMPDIR:-/tmp}/dinx-pacman-prune.XXXXXX") || {
    printf 'dinx mksquashfs wrapper: cannot create isolated pacman config\n' >&2
    return 1
  }
  if ! printf '[options]\nArchitecture = auto\n' > "$pacman_config"; then
    rm -f -- "$pacman_config"
    printf 'dinx mksquashfs wrapper: cannot write isolated pacman config\n' >&2
    return 1
  fi
  if ! pacman --root "$root" --config "$pacman_config" \
    -Rns --noconfirm --noscriptlet "${removable_packages[@]}"; then
    rm -f -- "$pacman_config"
    printf 'dinx mksquashfs wrapper: cannot safely remove excluded packages from %s\n' "$root" >&2
    return 1
  fi
  rm -f -- "$pacman_config"

  for package in "${removable_packages[@]}"; do
    package_records=("$local_db"/"$package"-[0-9]*)
    [[ ! -d "${package_records[0]}" ]] || {
      printf 'dinx mksquashfs wrapper: %s package record remains in %s\n' "$package" "$root" >&2
      return 1
    }
    printf 'dinx-final-squashfs: removed excluded package=%s root=%s\n' "$package" "$root"
  done
  remove_orphaned_vi_compat_entries "$root"
}

if [[ -n "$source_root" ]]; then
  prune_excluded_packages "$source_root"
fi

# Keep package caches and logs out of the compressed filesystem.
exec "$real_mksquashfs" "${filtered[@]}" \
  -comp xz \
  -b 1M \
  -Xbcj x86 \
  -Xdict-size 1M \
  -wildcards \
  -e 'usr/src/linux*' 'var/cache/pacman/pkg/*' 'var/log/*'

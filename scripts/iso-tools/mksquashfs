#!/usr/bin/env bash
set -euo pipefail

if [[ -x /usr/local/libexec/dinx-mksquashfs.real ]]; then
  real_mksquashfs=${DINX_MKSQUASHFS_REAL:-/usr/local/libexec/dinx-mksquashfs.real}
else
  real_mksquashfs=${DINX_MKSQUASHFS_REAL:-/usr/bin/mksquashfs}
fi
[[ -x "$real_mksquashfs" ]] || {
  printf 'dinx mksquashfs wrapper: missing %s\n' "$real_mksquashfs" >&2
  exit 127
}
wrapper_path=$(readlink -f "$0")
real_path=$(readlink -f "$real_mksquashfs")
[[ "$wrapper_path" != "$real_path" ]] || {
  printf 'dinx mksquashfs wrapper: real binary resolves to the wrapper itself\n' >&2
  exit 125
}

source_root=${1:-}
if [[ -d "$source_root" ]]; then
  source_root=$(CDPATH= cd -- "$source_root" && pwd -P)
fi

filtered=()
while (($#)); do
  case "$1" in
    -comp|-b|-Xbcj|-Xcompression-level|-Xdict-size)
      (($# >= 2)) || {
        printf 'dinx mksquashfs wrapper: option %s needs a value\n' "$1" >&2
        exit 2
      }
      shift 2
      ;;
    -comp=*|-b=*|-Xbcj=*|-Xcompression-level=*|-Xdict-size=*)
      shift
      ;;
    *)
      filtered+=("$1")
      shift
      ;;
  esac
done

# Artix needs headers to generate initramfs images; build-only headers and
# explicitly excluded package roots are removed from DINX's final rootfs/livefs.
remove_vim_compat_aliases() {
  local root=$1
  local name path target target_basename

  for name in vi ex vedit view; do
    path="$root/usr/bin/$name"
    [[ -e "$path" || -L "$path" ]] || continue
    if [[ -L "$path" ]]; then
      target=$(readlink -- "$path") || return 1
      target_basename=${target##*/}
      case "$target_basename" in
        vim*|vi) ;;
        *) continue ;;
      esac
    elif [[ "$name" == vi && -f "$path" ]] \
      && grep -Fqx '#!/usr/bin/bash' "$path" \
      && grep -Fq 'exec /usr/bin/vim -C -u ' "$path"; then
      :
    else
      continue
    fi

    rm -f -- "$path" || {
      printf 'dinx mksquashfs wrapper: cannot remove Vim compatibility alias %s\n' "$path" >&2
      return 1
    }
    printf 'dinx-final-squashfs: removed Vim compatibility alias path=%s\n' "$path"
  done
}

# Documentation payloads are dead weight in the live/install images: man-db,
# man-pages and texinfo are builder-only, nothing runtime-reads man/info/help
# pages or API references, and the ISO budget is enforced in
# scripts/check_dinx_budget.sh. Keep license artifacts and the packages'
# uppercase SOURCE provenance records under usr/share/doc.
strip_documentation() {
  local root=$1
  local rel doc_dir

  [[ "$root" != / && -d "$root/usr/share" ]] || return 0

  for rel in usr/share/man usr/share/gtk-doc usr/share/help usr/share/info usr/share/locale usr/share/omf usr/share/gnome/help usr/share/doc; do
    if [[ -d "$root/$rel" ]]; then
      rm -rf -- "$root/$rel"
      printf 'dinx-final-squashfs: removed documentation/locale path=%s\n' "$rel"
    fi
  done
}

# Build-time-only metadata is dead weight in the live/install images: the ISO
# ships no compiler, make, cmake, pkg-config, g-ir-compiler, valac or autoconf,
# so nothing in the image can consume headers, CMake package configs, pkg-config
# records, GObject-Introspection source XML, Vala bindings or aclocal macros.
# gir-1.0 holds the source XML used to generate typelibs; the runtime reads the
# already-generated usr/lib/girepository-1.0 typelibs, which are kept.
# usr/include/ghostty is preserved because check-iso-content.sh requires
# usr/include/ghostty/vt.h: ghostty-vt-runtime deliberately ships the VT headers
# alongside its library for Deetty's build contract.
strip_build_metadata() {
  local root=$1
  local rel

  [[ "$root" != / && -d "$root/usr" ]] || return 0

  if [[ -d "$root/usr/include" ]]; then
    local preserved keep="$root/usr/include/ghostty" kept=false
    if [[ -d "$keep" ]]; then
      preserved=$(mktemp -d) || {
        printf 'dinx-final-squashfs: cannot allocate a directory to preserve usr/include/ghostty\n' >&2
        return 1
      }
      cp -a -- "$keep" "$preserved/" || {
        rm -rf -- "$preserved"
        printf 'dinx-final-squashfs: cannot preserve usr/include/ghostty\n' >&2
        return 1
      }
      kept=true
    fi
    rm -rf -- "$root/usr/include"
    if [[ "$kept" == true ]]; then
      mkdir -p -- "$root/usr/include"
      mv -- "$preserved/ghostty" "$root/usr/include/"
      rm -rf -- "$preserved"
      printf '%s\n' 'dinx-final-squashfs: removed build headers, preserving usr/include/ghostty'
    else
      printf '%s\n' 'dinx-final-squashfs: removed build headers'
    fi
  fi
  for rel in usr/share/gir-1.0 usr/lib/cmake usr/lib/pkgconfig usr/share/vala usr/share/aclocal; do
    if [[ -d "$root/$rel" ]]; then
      rm -rf -- "$root/$rel"
      printf 'dinx-final-squashfs: removed build-only metadata path=%s\n' "$rel"
    fi
  done
}

prune_excluded_packages() {
  local root=$1
  local local_db="$root/var/lib/pacman/local"
  local -a removable_packages=()
  local -a prune_candidates=(
    breeze
    breeze-cursors
    plasma-integration
    plasma-workspace
    qogir-icon-theme
    qqc2-breeze-style
    xdg-desktop-portal-kde
    dhcpcd
    dhcpcd-dinit
    ex-vi-compat
    vim
    vim-runtime
    man-db
    man-pages
    texinfo
  )
  local -a package_records
  local package
  local pacman_config

  [[ "$root" != / && -d "$local_db" ]] || return 0
  # Pacman local records are <name>-<numeric-version>-<release>; avoid prefix matches such as breeze-icons.

  package_records=("$local_db"/linux-headers-[0-9]*)
  if [[ -d "${package_records[0]}" ]]; then
    removable_packages+=(linux-headers)
    package_records=("$local_db"/pahole-[0-9]*)
    [[ ! -d "${package_records[0]}" ]] || removable_packages+=(pahole)
  fi

  for package in "${prune_candidates[@]}"; do
    package_records=("$local_db"/"$package"-[0-9]*)
    [[ ! -d "${package_records[0]}" ]] || removable_packages+=("$package")
  done
  if ((${#removable_packages[@]} == 0)); then
    remove_vim_compat_aliases "$root"
    return
  fi

  pacman_config=$(mktemp "${TMPDIR:-/tmp}/dinx-pacman-prune.XXXXXX") || {
    printf 'dinx mksquashfs wrapper: cannot create isolated pacman config\n' >&2
    return 1
  }
  if ! printf '[options]\nArchitecture = auto\n' > "$pacman_config"; then
    rm -f -- "$pacman_config"
    printf 'dinx mksquashfs wrapper: cannot write isolated pacman config\n' >&2
    return 1
  fi
  if ! pacman --root "$root" --config "$pacman_config" \
    -Rns --noconfirm --noscriptlet "${removable_packages[@]}"; then
    rm -f -- "$pacman_config"
    printf 'dinx mksquashfs wrapper: cannot safely remove excluded packages from %s\n' "$root" >&2
    return 1
  fi
  rm -f -- "$pacman_config"

  for package in "${removable_packages[@]}"; do
    package_records=("$local_db"/"$package"-[0-9]*)
    [[ ! -d "${package_records[0]}" ]] || {
      printf 'dinx mksquashfs wrapper: %s package record remains in %s\n' "$package" "$root" >&2
      return 1
    }
    printf 'dinx-final-squashfs: removed excluded package=%s root=%s\n' "$package" "$root"
  done
  remove_vim_compat_aliases "$root"
}

# Compile the system dconf database from the checked-in keyfiles. dconf reads
# only the compiled binary at /etc/dconf/db/local at runtime; the keyfile
# fragments under /etc/dconf/db/local.d are inert until compiled, and the
# overlay is copied by rsync so no pacman dconf-update hook fires for it.
# `dconf compile` writes the gvdb binary directly and needs no chroot. Seeding
# the dark color-scheme system default makes freedesktop consumers (the egui
# Craft apps, libadwaita/GTK apps) start dark on a fresh or live session.
compile_dconf_database() {
  local root=$1
  local db_dir="$root/etc/dconf/db"

  [[ -d "$db_dir/local.d" ]] || return 0
  command -v dconf >/dev/null 2>&1 || {
    printf 'dinx-final-squashfs: etc/dconf/db/local.d present but dconf is unavailable; cannot compile the system database\n' >&2
    return 1
  }
  dconf compile "$db_dir/local" "$db_dir/local.d" || {
    printf 'dinx-final-squashfs: failed to compile the system dconf database\n' >&2
    return 1
  }
  [[ -s "$db_dir/local" ]] || {
    printf 'dinx-final-squashfs: dconf compile produced no database\n' >&2
    return 1
  }
  chmod 0644 -- "$db_dir/local" || {
    printf 'dinx-final-squashfs: cannot set mode on the compiled dconf database\n' >&2
    return 1
  }
  printf '%s\n' 'dinx-final-squashfs: compiled system dconf database at etc/dconf/db/local'
}

merge_eurooffice() {
  local root=$1
  [[ -n "${DINX_EUROOFFICE_SQUASHFS:-}" && -s "${DINX_EUROOFFICE_SQUASHFS}" ]] || return 0
  [[ "$root" != / && -d "$root" ]] || return 0
  command -v unsquashfs >/dev/null 2>&1 || {
    printf 'dinx-final-squashfs: unsquashfs unavailable; cannot merge EuroOffice\n' >&2
    return 1
  }
  unsquashfs -f -d "$root" "$DINX_EUROOFFICE_SQUASHFS" >/dev/null || {
    printf 'dinx-final-squashfs: failed to merge EuroOffice tree into %s\n' "$root" >&2
    return 1
  }
  printf 'dinx-final-squashfs: merged EuroOffice lean tree root=%s\n' "$root"
}

# Regenerable Python bytecode and unused stdlib payloads are dead weight in
# the final images; nothing in the runtime reads idle/test/tkinter.
strip_python_bytecode() {
  local root=$1 py
  [[ "$root" != / && -d "$root/usr/lib" ]] || return 0
  for py in "$root"/usr/lib/python3.*; do
    [[ -d "$py" ]] || continue
    find "$py" -name '__pycache__' -type d -prune -exec rm -rf {} +
    rm -rf -- "$py/idlelib" "$py/test" "$py/tkinter"
  done
  printf '%s\n' 'dinx-final-squashfs: removed Python bytecode and idle/test/tkinter payloads'
}

# glibc i18n data follows the same en/pt locale policy as the apps.
trim_i18n_locales() {
  local root=$1
  [[ "$root" != / && -d "$root/usr/share/i18n/locales" ]] || return 0
  find "$root/usr/share/i18n/locales" -maxdepth 1 -type f \
    ! -name 'en_US*' ! -name 'en_GB*' ! -name 'pt_BR*' ! -name 'pt_PT*' -delete
  if [[ -d "$root/usr/share/i18n/charmaps" ]]; then
    find "$root/usr/share/i18n/charmaps" -maxdepth 1 -type f \
      ! -name 'UTF-8*' ! -name 'ISO-8859-1*' -delete
  fi
  printf '%s\n' 'dinx-final-squashfs: trimmed glibc i18n locales/charmaps to en/pt + UTF-8/ISO-8859-1'
}

# Only Papirus (and breeze for Calamares KIconThemes) is selected; the extra
# icon theme variants are never referenced by the DINX theme contracts.
trim_icon_variants() {
  local root=$1 variant
  [[ "$root" != / && -d "$root/usr/share/icons" ]] || return 0
  for variant in Papirus-Dark Papirus-Light breeze-dark; do
    rm -rf -- "$root/usr/share/icons/$variant"
  done
  printf '%s\n' 'dinx-final-squashfs: removed unused icon theme variants'
}

if [[ -n "$source_root" ]]; then
  merge_eurooffice "$source_root"
  prune_excluded_packages "$source_root"
  strip_documentation "$source_root"
  strip_build_metadata "$source_root"
  strip_python_bytecode "$source_root"
  trim_i18n_locales "$source_root"
  trim_icon_variants "$source_root"
  compile_dconf_database "$source_root"
fi

# Keep package caches and logs out of the compressed filesystem.
exec "$real_mksquashfs" "${filtered[@]}" \
  -comp xz \
  -Xbcj x86 \
  -b 1M \
  -Xdict-size 1M \
  -processors 4 \
  -wildcards \
  -e 'usr/src/linux*' 'var/cache/pacman/pkg/*' 'var/log/*'
